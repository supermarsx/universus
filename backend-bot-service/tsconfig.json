{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "outDir": "./dist",
    "rootDir": "../",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node"
  },
  "include": [
    "src/**/*",
    "../backend/src/config/**/*",
    "../backend/src/utils/**/*",
    "../backend/src/types/**/*",
    "../backend/src/services/**/*"
  ],
  "exclude": [
    "../backend/src/tests/**/*",
    "../backend/src/**/__mocks__/**/*"
  ]
}
