# Universus — Environment Configuration
# Copy this file to .env and adjust values for your local setup.

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/universus_rpg

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Logging ──────────────────────────────────────────────────────
RUST_LOG=info

# ── API Gateway ──────────────────────────────────────────────────
API_PORT=3300

# ── Web Frontend ─────────────────────────────────────────────────
WEB_PORT=8080

# ── Admin API ────────────────────────────────────────────────────
ADMIN_PORT=4302

# ── Bot API ──────────────────────────────────────────────────────
BOT_PORT=4301

# ── RabbitMQ ─────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ── JWT / Auth ───────────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ── Adapter driver (jsonfile | postgres | mysql | sqlite) ────────
ADAPTER_DRIVER=jsonfile
ADAPTER_PATH=database/tenants/tenant-default.json
