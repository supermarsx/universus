# Universus — Environment Configuration
# Copy this file to .env and adjust values for your local setup.

# ── Database ─────────────────────────────────────────────────────
POSTGRES_DB=universus_rpg
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
# Host-side tools use localhost; Compose services use the internal service URL.
# URL-encode reserved characters in the password component of each URL.
DATABASE_URL=postgres://postgres:replace-with-a-long-random-database-password@localhost:5432/universus_rpg
DATABASE_URL_INTERNAL=postgres://postgres:replace-with-a-long-random-database-password@database:5432/universus_rpg
MIGRATION_WAIT_SECONDS=60
MIGRATION_LOCK_TIMEOUT_SECONDS=120

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# Realtime WebSocket connection controls
REALTIME_WS_QUEUE_CAPACITY=64
REALTIME_WS_MAX_SUBSCRIPTIONS=32
REALTIME_WS_HEARTBEAT_INTERVAL_SECS=30
REALTIME_WS_IDLE_TIMEOUT_SECS=90
REALTIME_ALLOWED_ORIGINS=https://universus.example

# ── Logging ──────────────────────────────────────────────────────
RUST_LOG=info

# ── API Gateway ──────────────────────────────────────────────────
API_PORT=3300

# ── Web Frontend ─────────────────────────────────────────────────
WEB_PORT=8080

# ── Admin API ────────────────────────────────────────────────────
ADMIN_PORT=4302

# ── Bot API ──────────────────────────────────────────────────────
BOT_PORT=4301

# ── RabbitMQ ─────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ── JWT / Auth ───────────────────────────────────────────────────
UNIVERSUS_ENV=production
# Generate a real Ed25519 pair with `cargo run -p platform-auth --bin auth-keygen -- primary`.
# Store the private value in a secret manager and expose it only to rust-api-gateway.
# Production and staging reject JWT_SECRET/HS256 even if a legacy secret is set.
AUTH_JWT_ISSUER=https://auth.universus.internal
AUTH_JWT_SIGNING_KEY_ID=replace-with-active-key-id
AUTH_JWT_PRIVATE_KEY_BASE64=replace-with-base64url-ed25519-private-seed
# Keep the previous public key alongside the new one during a rotation window:
# AUTH_JWT_VERIFICATION_KEYS=previous:base64url-public,current:base64url-public
AUTH_JWT_VERIFICATION_KEYS=replace-with-active-key-id:replace-with-base64url-ed25519-public-key

# Externally provisioned role=service credentials. Give each worker its own
# subject/JTI and only the audience/scope named here; never reuse one token.
# `issue-service-token` prints the credential once for insertion into a secret store.
API_GATEWAY_REALTIME_PUBLISH_TOKEN=replace-with-aud-app-realtime-gateway-scope-realtime.publish-token
BOT_WORKER_SERVICE_TOKEN=replace-with-aud-app-bot-api-scope-bot.process-token
BOT_WORKER_REALTIME_PUBLISH_TOKEN=replace-with-aud-app-realtime-gateway-scope-realtime.publish-token
EMAIL_WORKER_REALTIME_PUBLISH_TOKEN=replace-with-aud-app-realtime-gateway-scope-realtime.publish-token
ANALYTICS_WORKER_REALTIME_PUBLISH_TOKEN=replace-with-aud-app-realtime-gateway-scope-realtime.publish-token
CORE_ENGINE_REALTIME_PUBLISH_TOKEN=replace-with-aud-app-realtime-gateway-scope-realtime.publish-token
NOTIFICATIONS_WORKER_REALTIME_PUBLISH_TOKEN=replace-with-aud-app-realtime-gateway-scope-realtime.publish-token
CHAT_WORKER_REALTIME_PUBLISH_TOKEN=replace-with-aud-app-realtime-gateway-scope-realtime.publish-token
SCHEDULER_WORKER_REALTIME_PUBLISH_TOKEN=replace-with-aud-app-realtime-gateway-scope-realtime.publish-token
SHARDING_WORKER_REALTIME_PUBLISH_TOKEN=replace-with-aud-app-realtime-gateway-scope-realtime.publish-token

COOKIE_SECURE=true

# Isolated local HTTP testing only: run with a development environment, or if
# production-mode validation itself must be tested over loopback HTTP, set both
# COOKIE_SECURE=false and the explicit acknowledgement below. Never deploy it.
# UNIVERSUS_ALLOW_INSECURE_LOCAL_HTTP_COOKIE=true

# ── Adapter driver (jsonfile | postgres | mysql | sqlite) ────────
ADAPTER_DRIVER=jsonfile
ADAPTER_PATH=database/tenants/tenant-default.json
