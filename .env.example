# Universus — Environment Configuration
# Copy this file to .env and adjust values for your local setup.

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/universus_rpg

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# Realtime WebSocket connection controls
REALTIME_WS_QUEUE_CAPACITY=64
REALTIME_WS_MAX_SUBSCRIPTIONS=32
REALTIME_WS_HEARTBEAT_INTERVAL_SECS=30
REALTIME_WS_IDLE_TIMEOUT_SECS=90
REALTIME_ALLOWED_ORIGINS=http://localhost:8080

# ── Logging ──────────────────────────────────────────────────────
RUST_LOG=info

# ── API Gateway ──────────────────────────────────────────────────
API_PORT=3300

# ── Web Frontend ─────────────────────────────────────────────────
WEB_PORT=8080

# ── Admin API ────────────────────────────────────────────────────
ADMIN_PORT=4302

# ── Bot API ──────────────────────────────────────────────────────
BOT_PORT=4301

# ── RabbitMQ ─────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ── JWT / Auth ───────────────────────────────────────────────────
# Generate a unique random value before deployment; this example is not a secret.
UNIVERSUS_ENV=production
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes

# ── Adapter driver (jsonfile | postgres | mysql | sqlite) ────────
ADAPTER_DRIVER=jsonfile
ADAPTER_PATH=database/tenants/tenant-default.json
