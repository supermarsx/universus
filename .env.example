# Universus — Environment Configuration
# Copy this file to .env and adjust values for your local setup.

# ── Database ─────────────────────────────────────────────────────
POSTGRES_DB=universus_rpg
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
# Host-side tools use localhost; Compose services use the internal service URL.
# URL-encode reserved characters in the password component of each URL.
DATABASE_URL=postgres://postgres:replace-with-a-long-random-database-password@localhost:5432/universus_rpg
DATABASE_URL_INTERNAL=postgres://postgres:replace-with-a-long-random-database-password@database:5432/universus_rpg
MIGRATION_WAIT_SECONDS=60
MIGRATION_LOCK_TIMEOUT_SECONDS=120

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# Realtime WebSocket connection controls
REALTIME_WS_QUEUE_CAPACITY=64
REALTIME_WS_MAX_SUBSCRIPTIONS=32
REALTIME_WS_HEARTBEAT_INTERVAL_SECS=30
REALTIME_WS_IDLE_TIMEOUT_SECS=90
REALTIME_ALLOWED_ORIGINS=https://universus.example

# ── Logging ──────────────────────────────────────────────────────
RUST_LOG=info

# ── API Gateway ──────────────────────────────────────────────────
API_PORT=3300

# ── Web Frontend ─────────────────────────────────────────────────
WEB_PORT=8080

# ── Admin API ────────────────────────────────────────────────────
ADMIN_PORT=4302

# ── Bot API ──────────────────────────────────────────────────────
BOT_PORT=4301

# ── RabbitMQ ─────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ── JWT / Auth ───────────────────────────────────────────────────
UNIVERSUS_ENV=production
# Generate a real Ed25519 pair with `cargo run -p platform-auth --bin auth-keygen -- primary`.
# Store the private value in a secret manager and expose it only to rust-api-gateway.
# Production and staging reject JWT_SECRET/HS256 even if a legacy secret is set.
AUTH_JWT_ISSUER=https://auth.universus.internal
AUTH_JWT_SIGNING_KEY_ID=replace-with-active-key-id
AUTH_JWT_PRIVATE_KEY_BASE64=replace-with-base64url-ed25519-private-seed
# Keep the previous public key alongside the new one during a rotation window:
# AUTH_JWT_VERIFICATION_KEYS=previous:base64url-public,current:base64url-public
AUTH_JWT_VERIFICATION_KEYS=replace-with-active-key-id:replace-with-base64url-ed25519-public-key

# Externally provisioned role=service credentials. Give each worker its own
# subject/JTI and only the audience/scope named here; never reuse one token.
# `issue-service-token` prints the credential once for insertion into a secret store.
API_GATEWAY_REALTIME_PUBLISH_TOKEN=replace-with-aud-app-realtime-gateway-scope-realtime.publish-token
BOT_WORKER_SERVICE_TOKEN=replace-with-aud-app-bot-api-scope-bot.process-token
BOT_WORKER_REALTIME_PUBLISH_TOKEN=replace-with-aud-app-realtime-gateway-scope-realtime.publish-token
ANALYTICS_WORKER_REALTIME_PUBLISH_TOKEN=replace-with-aud-app-realtime-gateway-scope-realtime.publish-token
CORE_ENGINE_REALTIME_PUBLISH_TOKEN=replace-with-aud-app-realtime-gateway-scope-realtime.publish-token
NOTIFICATIONS_WORKER_REALTIME_PUBLISH_TOKEN=replace-with-aud-app-realtime-gateway-scope-realtime.publish-token
CHAT_WORKER_REALTIME_PUBLISH_TOKEN=replace-with-aud-app-realtime-gateway-scope-realtime.publish-token
SCHEDULER_WORKER_REALTIME_PUBLISH_TOKEN=replace-with-aud-app-realtime-gateway-scope-realtime.publish-token
SHARDING_WORKER_REALTIME_PUBLISH_TOKEN=replace-with-aud-app-realtime-gateway-scope-realtime.publish-token
PRIVACY_WORKER_REALTIME_PUBLISH_TOKEN=replace-with-aud-app-realtime-gateway-scope-realtime.publish-token

# ── Durable email and SMS delivery ──────────────────────────────
# Generate a unique keyed-evidence secret with `openssl rand -base64 32` and
# keep it in a secret manager. Both communication processes must use the same
# active key while evidence created with it remains dispatchable.
COMMUNICATION_EVIDENCE_HMAC_KEY_BASE64=replace-with-base64-encoded-random-32-byte-hmac-key

# These files contain distinct externally issued role=service JWTs. Never put
# the JWT itself in this environment file. The email token requires
# aud=app-email-worker and scopes communications.dispatch,communications.global.
# The SMS background token requires aud=app-sms-api with the same two scopes.
EMAIL_WORKER_COMMUNICATION_TOKEN_FILE=./secrets/email-worker-communications.jwt
SMS_WORKER_COMMUNICATION_TOKEN_FILE=./secrets/sms-worker-communications.jwt

# Production/staging providers must use HTTPS. Bearer tokens are placeholders
# for secret-manager injection; provider URLs may not contain credentials,
# query parameters, or fragments.
EMAIL_PROVIDER_URL=https://email-provider.example/v1/send
EMAIL_PROVIDER_BEARER_TOKEN=replace-with-email-provider-bearer-token
EMAIL_PROVIDER_KEY=email_http
EMAIL_PROVIDER_TIMEOUT_SECONDS=15
EMAIL_WORKER_UNIVERSE_ID=1
EMAIL_WORKER_ID=email-worker-1
EMAIL_WORKER_CLAIM_LIMIT=20
EMAIL_WORKER_LEASE_SECONDS=90
EMAIL_WORKER_POLL_MILLIS=1000
EMAIL_WORKER_RETRY_BASE_SECONDS=15
EMAIL_WORKER_HEALTH_PORT=3002
EMAIL_READINESS_MAX_STALENESS_SECONDS=30

SMS_PORT=4303
SMS_PROVIDER_URL=https://sms-provider.example/v1/send
SMS_PROVIDER_BEARER_TOKEN=replace-with-sms-provider-bearer-token
SMS_PROVIDER_KEY=sms_http
SMS_PROVIDER_TIMEOUT_SECONDS=15
SMS_WORKER_UNIVERSE_IDS=1
SMS_WORKER_CLAIM_LIMIT=20
SMS_WORKER_POLL_MILLIS=1000
SMS_DISPATCH_WORKER_ID=sms-api-dispatcher-1
SMS_DISPATCH_LEASE_SECONDS=90
SMS_READINESS_MAX_STALENESS_SECONDS=30

# Callers of the SMS HTTP API need their own audience-bound service JWTs; do
# not reuse the background token. Grant only the endpoint scope required:
# communications.enqueue, communications.dispatch, or communications.audit.read.

# ── Privacy lifecycle worker ─────────────────────────────────────
# Every replica needs a stable, unique lease owner ID. Generate the export key
# with `openssl rand -base64 32`; keep it in a secret manager, not this file.
# `v1:` identifies the AES-256-GCM envelope/AAD contract; rotate the suffix
# whenever the key changes and retain old keys for unexpired artifacts.
PRIVACY_WORKER_ID=replace-with-unique-privacy-worker-id
PRIVACY_EXPORT_KEY_ID=v1:replace-with-rotation-id
PRIVACY_EXPORT_KEY_BASE64=replace-with-base64-encoded-32-byte-key
PRIVACY_WORKER_CLAIM_LIMIT=8
PRIVACY_WORKER_CLAIM_TIMEOUT_SECS=5
PRIVACY_WORKER_LEASE_SECS=60
PRIVACY_WORKER_JOB_TIMEOUT_SECS=55
PRIVACY_WORKER_RETRY_DELAY_SECS=30
PRIVACY_WORKER_POLL_INTERVAL_MS=1000
PRIVACY_EXPORT_MAX_PLAINTEXT_BYTES=16777216
PRIVACY_EXPORT_RETENTION_SECS=604800

COOKIE_SECURE=true

# Isolated local HTTP testing only: run with a development environment, or if
# production-mode validation itself must be tested over loopback HTTP, set both
# COOKIE_SECURE=false and the explicit acknowledgement below. Never deploy it.
# UNIVERSUS_ALLOW_INSECURE_LOCAL_HTTP_COOKIE=true

# ── Adapter driver (jsonfile | postgres | mysql | sqlite) ────────
ADAPTER_DRIVER=jsonfile
ADAPTER_PATH=database/tenants/tenant-default.json
