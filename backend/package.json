{
  "name": "universus-backend",
  "version": "1.0.0",
  "description": "Universus - Space Empire Game Backend Server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:unit": "jest --runInBand --testPathPattern=tests/unit",
    "test:coverage": "jest --coverage",
    "test:integration": "set RUN_INTEGRATION=true && jest --runInBand --testPathPattern=tests/integration",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "validate": "pnpm run type-check && pnpm run lint && pnpm run test",
    "load:test": "ts-node scripts/loadTest.ts",
    "bench:core": "ts-node --transpile-only scripts/benchmarkCoreTransports.ts",
    "analytics:worker": "ts-node src/workers/analyticsQueueWorker.ts"
  },
  "keywords": [
    "game",
    "mmo",
    "rpg",
    "space",
    "universus"
  ],
  "author": "MiniMax Agent",
  "license": "MIT",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.1",
    "@grpc/proto-loader": "^0.8.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
    "@prisma/client": "^6.19.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/nunjucks": "^3.2.6",
    "amqplib": "^0.10.4",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^2.7.0",
    "nodemailer": "^6.9.7",
    "nunjucks": "^3.2.4",
    "pg": "^8.16.3",
    "postcss": "^8.4.47",
    "postcss-safe-parser": "^7.0.0",
    "qrcode": "^1.5.3",
    "redis": "^5.9.0",
    "socket.io": "^4.8.1",
    "speakeasy": "^2.0.0",
    "stripe": "^19.2.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.0",
    "@types/node-fetch": "^2.6.11",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.15.6",
    "@types/postcss-safe-parser": "^5.0.4",
    "@types/qrcode": "^1.5.5",
    "@types/socket.io-client": "^3.0.0",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "artillery": "^2.0.10",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "prisma": "^6.19.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
