PORT=4700

# Shared secret required in X-API-Key header (leave blank to disable auth)
SMS_SERVICE_API_KEY=replace_with_shared_secret

# Observability
SMS_HISTORY_DB_PATH=sms-history.db
SMS_FAILURE_WEBHOOK_URL=

# Channel defaults
SMS_DEFAULT_CHANNEL=sms_twilio
SMS_FALLBACK_CHANNELS=telegram,custom_http
SMS_DEFAULT_COUNTRY_CODE=1
SMS_CHANNEL_FAILURE_THRESHOLD=3
SMS_CHANNEL_COOLDOWN_MS=60000
SMS_RATE_LIMIT_MAX_PER_CONTACT=5
SMS_RATE_LIMIT_WINDOW_SECONDS=300

# Twilio credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_SMS_FROM=+15551234567
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# WhatsApp Baileys
BAILEYS_AUTH_FOLDER=.baileys_auth
BAILEYS_PRINT_QR=false
BAILEYS_LOG_LEVEL=error

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_DEFAULT_CHAT_ID=123456789

# Discord
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_DEFAULT_USER_ID=123456789012345678

# Custom HTTP Gateway
SMS_CUSTOM_API_URL=https://your-sms-gateway.example.com/send
SMS_CUSTOM_API_METHOD=POST
SMS_CUSTOM_API_KEY=your_custom_api_key
SMS_CUSTOM_API_HEADER=Authorization
SMS_CUSTOM_API_PREFIX=Bearer
