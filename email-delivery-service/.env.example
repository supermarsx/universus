REDIS_HOST=127.0.0.1
REDIS_PORT=6379

EMAIL_QUEUE_KEY=email:queue
EMAIL_DEAD_LETTER_KEY=email:dead-letter
CONFIG_SNAPSHOT_KEY=config:game_snapshot

# Fallback provider if snapshot missing
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@universus.game
EMAIL_FROM_NAME="Universus Command"

# SMTP fallback credentials
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# SendGrid
SENDGRID_API_KEY=

# Amazon SES
SES_ACCESS_KEY=
SES_SECRET_KEY=
SES_REGION=us-east-1

# MailerSend
MAILERSEND_API_KEY=
