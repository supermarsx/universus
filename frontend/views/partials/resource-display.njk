<div class="resource-display" role="region" aria-label="Resource display" aria-live="polite">
    <div class="resource-item">
        <div class="css-icon icon-metal" title="Metal" aria-hidden="true"></div>
        <span id="metalDisplay" aria-label="Metal">{{ resources.metal if resources else '0' }}</span>
    </div>
    <div class="resource-item">
        <div class="css-icon icon-crystal" title="Crystal" aria-hidden="true"></div>
        <span id="crystalDisplay" aria-label="Crystal">{{ resources.crystal if resources else '0' }}</span>
    </div>
    <div class="resource-item">
        <div class="css-icon icon-deuterium" title="Deuterium" aria-hidden="true"></div>
        <span id="deuteriumDisplay" aria-label="Deuterium">{{ resources.deuterium if resources else '0' }}</span>
    </div>
    <div class="resource-item">
        <div class="css-icon icon-energy" title="Energy" aria-hidden="true"></div>
        <span id="energyDisplay" aria-label="Energy">{{ resources.energy if resources else '0' }}</span>
    </div>
</div>
