<aside class="sidebar">
    <!-- Planet Selector -->
<div class="planet-selector">
    <h3 id="planetSelectorHeading">Your Planets</h3>
    <label for="planetSelect" class="sr-only">Select planet</label>
    <select id="planetSelect" class="planet-dropdown" aria-labelledby="planetSelectorHeading">
        <option>Loading...</option>
    </select>
</div>

    <!-- Main Menu -->
    <nav class="main-menu">
        {% set menuItems = [
            { href: '/overview', label: 'Overview', page: 'overview', cssIcon: 'icon-home' },
            { href: '/buildings', label: 'Buildings', page: 'buildings', cssIcon: 'icon-build' },
            { href: '/research', label: 'Research', page: 'research', cssIcon: 'icon-research' },
            { href: '/shipyard', label: 'Shipyard', page: 'shipyard', cssIcon: 'icon-shipyard' },
            { href: '/fleet', label: 'Fleet', page: 'fleet', cssIcon: 'icon-fleet' },
            { href: '/galaxy', label: 'Galaxy', page: 'galaxy', cssIcon: 'icon-galaxy' },
            { href: '/alliance', label: 'Alliance', page: 'alliance', cssIcon: 'icon-users' },
            { href: '/leaderboard', label: 'Leaderboard', page: 'leaderboard', cssIcon: 'icon-online' },
            { href: '/messages', label: 'Messages', page: 'messages', cssIcon: 'icon-transport' },
            { href: '/shop', label: 'Shop', page: 'shop', cssIcon: 'icon-crystal' }
        ] %}
        
        {% for item in menuItems %}
        <a href="{{ item.href }}" class="menu-item {{ 'active' if currentPage == item.page else '' }}">
            <div class="css-icon {{ item.cssIcon }}" title="{{ item.label }}"></div>
            {{ item.label }}
        </a>
        {% endfor %}
    </nav>
</aside>
