{% extends "layouts/game.njk" %}

{% set title = "Universus - Bot Management" %}
{% set currentPage = "admin" %}
{% set bodyClass = "game-body admin-body" %}

{% block content %}
<h2>{{ 'bot_management_system' | t }}</h2>

<div class="bot-management-toolbar">
    <button id="createBotBtn" class="btn-primary">{{ 'create_new_bot' | t }}</button>
    <button id="bulkCreateBtn" class="btn-secondary">{{ 'bulk_create_bots' | t }}</button>
    <button id="processAllBotsBtn" class="btn-success" aria-label="{{ 'process_all_bots' | t }}">{{ 'process_all_bots' | t }}</button>
    <button id="refreshBotsBtn" class="btn-secondary" aria-label="{{ 'refresh' | t }}">{{ 'refresh' | t }}</button>
</div>

<div class="bot-filters">
    <select id="personalityFilter" class="filter-select">
        <option value="">{{ 'all_personalities' | t }}</option>
        <option value="aggressive">{{ 'aggressive_conqueror' | t }}</option>
        <option value="builder">{{ 'strategic_builder' | t }}</option>
        <option value="diplomat">{{ 'diplomatic_negotiator' | t }}</option>
        <option value="hoarder">{{ 'resource_hoarder' | t }}</option>
<option value="rusher">{{ 'speed_rusher' | t }}</option>
                    <option value="tech">{{ 'tech_enthusiast' | t }}</option>
                    <option value="alliance">{{ 'alliance_focused' | t }}</option>
<option value="solo">{{ 'solo_survivor' | t }}</option>
    </select>
    
    <select id="statusFilter" class="filter-select">
        <option value="">{{ 'all_status' | t }}</option>
        <option value="active">{{ 'active' | t }}</option>
        <option value="inactive">{{ 'inactive' | t }}</option>
    </select>
</div>

<div id="botsGrid" class="bots-grid">
    <div class="loading">
        <div class="spinner"></div>
        <p>{{ 'loading_bots' | t }}</p>
    </div>
</div>

<!-- Bot Details Modal -->
<div id="botDetailsModal" class="modal" style="display: none;">
    <div class="modal-content modal-large">
        <span class="close">&times;</span>
        <h3>{{ 'bot_details' | t }}</h3>
        <div id="botDetailsContent"></div>
    </div>
</div>

<!-- Create/Edit Bot Modal -->
<div id="botFormModal" class="modal" style="display: none;">
    <div class="modal-content">
        <span class="close">&times;</span>
        <h3 id="botFormTitle">{{ 'create_new_bot' | t }}</h3>
        <form id="botForm">
            <div class="form-group">
                <label for="botUsername">{{ 'username' | t }}:</label>
                <input type="text" id="botUsername" required>
            </div>
            <div class="form-group">
                <label for="botEmail">{{ 'email' | t }}:</label>
                <input type="email" id="botEmail" required>
            </div>
            <div class="form-group">
                <label for="botPersonality">{{ 'personality' | t }}:</label>
                <select id="botPersonality" required>
                    <option value="aggressive">{{ 'aggressive_conqueror' | t }}</option>
<option value="builder">{{ 'strategic_builder' | t }}</option>
<option value="diplomat">{{ 'diplomatic_negotiator' | t }}</option>
<option value="hoarder">{{ 'resource_hoarder' | t }}</option>
<option value="rusher">{{ 'speed_rusher' | t }}</option>
                    <option value="tech">{{ 'tech_enthusiast' | t }}</option>
                    <option value="alliance">{{ 'alliance_focused' | t }}</option>
<option value="solo">{{ 'solo_survivor' | t }}</option>
                </select>
            </div>
            <div class="form-group">
                <label>
                    <input type="checkbox" id="botIsActive" checked>
{{ 'active' | t }}
                </label>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-primary">{{ 'save_bot' | t }}</button>
                <button type="button" class="btn-secondary" id="cancelBotForm">{{ 'cancel' | t }}</button>
            </div>
        </form>
    </div>
</div>

<!-- Bulk Create Modal -->
<div id="bulkCreateModal" class="modal" style="display: none;">
    <div class="modal-content">
        <span class="close">&times;</span>
        <h3>{{ 'bulk_create_bots' | t }}</h3>
        <form id="bulkCreateForm">
            <div class="form-group">
                <label for="bulkCount">{{ 'number_of_bots' | t }}:</label>
                <input type="number" id="bulkCount" min="1" max="100" value="10" required>
            </div>
            <div class="form-group">
                <label>
                    <input type="checkbox" id="bulkRandomPersonalities" checked>
                    {{ 'random_personalities' | t }}
                </label>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-primary">{{ 'create_bots' | t }}</button>
                <button type="button" class="btn-secondary" id="cancelBulkCreate">{{ 'cancel' | t }}</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block scripts %}
{{ super() }}
<script src="/js/bots.js"></script>
{% endblock %}
endblock %}
