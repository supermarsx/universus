{% extends "base.njk" %}
{% block title %}{{ 'admin.monitoring_admin_panel' | t }}{% endblock %}

{% block styles %}
<style>
  body {
    background: #05060f;
  }

  .monitoring-layout {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem;
    color: #e2e8f0;
  }

  .monitoring-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .monitoring-header h1 {
    margin: 0;
    font-size: 1.8rem;
  }

  .monitoring-actions {
    display: flex;
    gap: 0.75rem;
  }

  .monitoring-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .monitoring-card {
    background: rgba(11, 14, 26, 0.92);
    border: 1px solid rgba(99, 102, 241, 0.2);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .metric-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 0.95rem;
  }

  .metric-row:last-child {
    border-bottom: none;
  }

  .metric-row strong {
    font-family: 'Orbitron', sans-serif;
    font-size: 1rem;
    color: #9fc5ff;
  }

  .status-badge {
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .status-active {
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
  }

  .status-warning {
    background: rgba(251, 191, 36, 0.15);
    color: #fbbf24;
  }

  .btn,
  .btn-ghost {
    border: 1px solid rgba(99, 102, 241, 0.6);
    background: transparent;
    color: #e2e8f0;
    padding: 0.45rem 0.9rem;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.9rem;
  }

  .btn-primary {
    background: #6366f1;
    border-color: #6366f1;
    color: #fff;
  }

  .btn:hover {
    opacity: 0.9;
  }

  .monitoring-toast {
    position: fixed;
    bottom: 24px;
    right: 24px;
    background: rgba(15, 17, 30, 0.98);
    border: 1px solid rgba(99, 102, 241, 0.5);
    padding: 0.85rem 1.2rem;
    border-radius: 10px;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 50;
  }

  .monitoring-toast.show {
    opacity: 1;
    transform: translateY(0);
  }

  .monitoring-toast.success {
    border-color: rgba(16, 185, 129, 0.6);
    color: #34d399;
  }

  .monitoring-toast.error {
    border-color: rgba(248, 113, 113, 0.6);
    color: #f87171;
  }
</style>
{% endblock %}

{% block content %}
<div class="monitoring-layout">
  <div class="monitoring-header">
    <div>
      <h1>{{ 'monitoring.server_monitoring' | t }}</h1>
      <p class="text-muted">{{ 'monitoring.monitoring_live_insights' | t }}</p>
    </div>
    <div class="monitoring-actions">
      <button id="refreshScalingMetrics" class="btn-ghost">{{ 'ui.refresh' | t }}</button>
      <button id="backToAdminDash" class="btn">{{ 'admin.admin_dashboard' | t }}</button>
    </div>
  </div>

  <div class="monitoring-grid">
    <div class="monitoring-card">
      <div class="card-header">
        <h3>{{ 'bots.process_and_load' | t }}</h3>
      </div>
      <div class="metric-row">
        <span>{{ 'monitoring.uptime' | t }}</span>
        <strong id="processUptime">—</strong>
      </div>
      <div class="metric-row">
        <span>{{ 'monitoring.load_1m' | t }}</span>
        <strong id="loadOne">0.00</strong>
      </div>
      <div class="metric-row">
        <span>{{ 'monitoring.load_5m' | t }}</span>
        <strong id="loadFive">0.00</strong>
      </div>
      <div class="metric-row">
        <span>{{ 'monitoring.load_15m' | t }}</span>
        <strong id="loadFifteen">0.00</strong>
      </div>
      <div class="metric-row">
        <span>{{ 'ui.rss' | t }}</span>
        <strong id="memoryRss">—</strong>
      </div>
      <div class="metric-row">
        <span>{{ 'ui.heap_used' | t }}</span>
        <strong id="memoryHeapUsed">—</strong>
      </div>
    </div>

    <div class="monitoring-card">
      <div class="card-header">
        <h3>{{ 'ui.socket_cluster' | t }}</h3>
      </div>
      <div class="metric-row">
        <span>{{ 'ui.connected_clients' | t }}</span>
        <strong id="socketClients">0</strong>
      </div>
      <div class="metric-row">
        <span>{{ 'ui.rooms' | t }}</span>
        <strong id="socketRooms">0</strong>
      </div>
      <div class="metric-row">
        <span>{{ 'ui.namespaces' | t }}</span>
        <strong id="socketNamespaces">0</strong>
      </div>
      <div class="metric-row">
        <span>{{ 'ui.adapter' | t }}</span>
        <strong id="socketAdapter">n/a</strong>
      </div>
    </div>

    <div class="monitoring-card">
      <div class="card-header">
        <h3>{{ 'ui.redis_adapter' | t }}</h3>
      </div>
        <div class="metric-row">
          <span>{{ 'ui.status' | t }}</span>
          <strong id="redisStatus">{{ 'ui.unknown' | t }}</strong>
        </div>
      <div class="metric-row">
        <span>{{ 'ui.ping_latency' | t }}</span>
        <strong id="redisLatency">n/a</strong>
      </div>
    </div>

    <div class="monitoring-card">
      <div class="card-header">
        <h3>{{ 'schedules.leaderboard_scheduler' | t }}</h3>
        <button id="triggerLeaderboardRebuild" class="btn-primary">{{ 'ui.force_rebuild' | t }}</button>
      </div>
        <div class="metric-row">
          <span>{{ 'ui.status' | t }}</span>
          <span id="leaderboardStatus" class="status-badge status-warning">{{ 'ui.paused' | t }}</span>
        </div>
        <div class="metric-row">
          <span>{{ 'schedules.last_run' | t }}</span>
          <strong id="leaderboardLastRun">{{ 'ui.never' | t }}</strong>
        </div>
        <div class="metric-row">
          <span>{{ 'schedules.interval' | t }}</span>
          <strong id="leaderboardInterval">—</strong>
        </div>
    </div>
  </div>
</div>

<div id="monitoringToast" class="monitoring-toast"></div>
{% endblock %}

{% block scripts %}
<script src="/js/adminMonitoring.js"></script>
{% endblock %}
