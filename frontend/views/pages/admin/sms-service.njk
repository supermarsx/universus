{% extends "base.njk" %}

{% block title %}SMS Service Configuration{% endblock %}

{% block content %}
<section class="admin-sms-page">
  <header class="sms-header">
    <div>
      <p class="breadcrumb"><a href="/admin/dashboard">Admin</a> / Messaging</p>
      <h1>SMS & Messaging Service</h1>
      <p class="text-muted">Update the connection details used for phone validation and messaging fallbacks.</p>
    </div>
    <div class="meta">
      <div class="meta-item">
        <span class="meta-label">Last Updated</span>
        <span class="meta-value" id="smsConfigUpdatedAt">—</span>
      </div>
      <div class="meta-item">
        <span class="meta-label">API Key</span>
        <span class="meta-value"><span id="apiKeyStatus" class="badge">Loading…</span></span>
      </div>
    </div>
  </header>

  <div id="smsConfigStatus" class="status-banner status-info">Loading configuration…</div>

  <div class="sms-card">
    <form id="smsConfigForm" class="sms-form">
      <div class="form-group">
        <label for="serviceUrl">Service URL</label>
        <input type="url" id="serviceUrl" placeholder="https://sms-service.internal" required>
        <small>HTTP endpoint for the detached SMS service.</small>
      </div>

      <div class="form-group">
        <label for="defaultChannel">Default Channel</label>
        <select id="defaultChannel"></select>
        <small>Primary transport used for verification codes.</small>
      </div>

      <div class="form-group">
        <label for="fallbackChannels">Fallback Channels</label>
        <input type="text" id="fallbackChannels" placeholder="telegram, custom_http">
        <small>Optional list (comma separated). Channels are attempted in order after the default.</small>
        <div class="fallback-preview" id="fallbackPreview"></div>
      </div>

      <div class="form-group">
        <label for="apiKeyInput">API Key</label>
        <input type="password" id="apiKeyInput" placeholder="Leave blank to keep existing key">
        <label class="inline-checkbox">
          <input type="checkbox" id="clearApiKey"> Clear stored API key
        </label>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <button type="button" class="btn btn-secondary" onclick="window.location.reload()">Reset</button>
      </div>
    </form>
  </div>

  <div class="sms-grid">
    <div class="sms-card metrics-card">
      <div class="card-header">
        <div>
          <h3>Delivery Metrics</h3>
          <p class="text-muted">Live data pulled from the SMS microservice.</p>
        </div>
        <button id="refreshMetrics" class="btn btn-secondary btn-sm">Refresh</button>
      </div>
      <div id="metricsStatus" class="text-muted small mb-2"></div>
      <div class="metrics-grid" id="metricsSummary">
        <div class="metric-card">
          <div class="metric-value" id="metricRequests">0</div>
          <div class="metric-label">Requests</div>
        </div>
        <div class="metric-card">
          <div class="metric-value" id="metricSuccesses">0</div>
          <div class="metric-label">Successes</div>
        </div>
        <div class="metric-card">
          <div class="metric-value" id="metricFailures">0</div>
          <div class="metric-label">Failures</div>
        </div>
        <div class="metric-card">
          <div class="metric-value" id="metricLatency">0ms</div>
          <div class="metric-label">Avg Response</div>
        </div>
      </div>
      <div class="channel-history">
        <h4>Channel Performance</h4>
        <table>
          <thead>
            <tr>
              <th>Channel</th>
              <th>Success</th>
              <th>Failure</th>
            </tr>
          </thead>
          <tbody id="channelStats">
            <tr><td colspan="3" class="text-muted">No data</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="sms-card permission-card">
      <h3>Access Control</h3>
      <p class="text-muted">Roles granted `notifications:sms:read/write`.</p>
      <ul id="smsPermissionRoles" class="permission-list">
        <li class="text-muted">Loading…</li>
      </ul>
    </div>
  </div>
</section>
{% endblock %}

{% block styles %}
{{ super() }}
<style>
  .admin-sms-page {
    max-width: 960px;
    margin: 2rem auto;
    padding: 0 1rem 4rem;
  }
  .sms-header {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    align-items: flex-start;
    margin-bottom: 1.5rem;
  }
  .sms-header h1 {
    margin: 0.2rem 0;
  }
  .breadcrumb {
    margin: 0;
    color: #94a3b8;
    font-size: 0.85rem;
  }
  .breadcrumb a {
    color: #6366f1;
    text-decoration: none;
  }
  .meta {
    display: flex;
    gap: 1.5rem;
  }
  .meta-item {
    background: rgba(99,102,241,0.08);
    border: 1px solid rgba(99,102,241,0.2);
    border-radius: 0.75rem;
    padding: 0.8rem 1.2rem;
  }
  .meta-label {
    display: block;
    font-size: 0.75rem;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .meta-value {
    font-size: 1rem;
    font-weight: 600;
  }
  .sms-card {
    background: rgba(15,23,42,0.8);
    border: 1px solid rgba(99,102,241,0.2);
    border-radius: 1rem;
    padding: 2rem;
    box-shadow: 0 25px 60px rgba(0,0,0,0.45);
  }

  .sms-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 1rem;
  }

  .metric-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(148,163,184,0.2);
    border-radius: 0.75rem;
    padding: 0.8rem 1rem;
  }

  .metric-value {
    font-size: 1.8rem;
    font-weight: 600;
  }

  .metric-label {
    font-size: 0.85rem;
    color: #94a3b8;
  }

  .channel-history table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1rem;
  }

  .channel-history th,
  .channel-history td {
    padding: 0.5rem;
    border-bottom: 1px solid rgba(148,163,184,0.2);
    text-align: left;
  }

  .permission-list {
    list-style: none;
    padding-left: 0;
    margin: 1rem 0 0;
  }

  .permission-list li {
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(148,163,184,0.1);
  }

  .permission-list small {
    color: #94a3b8;
  }
  .sms-form .form-group {
    margin-bottom: 1.5rem;
  }
  .sms-form label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.4rem;
  }
  .sms-form input,
  .sms-form select,
  .sms-form textarea {
    width: 100%;
    padding: 0.7rem 0.9rem;
    border-radius: 0.5rem;
    border: 1px solid rgba(148,163,184,0.4);
    background: rgba(15,23,42,0.7);
    color: #e2e8f0;
  }
  .sms-form small {
    display: block;
    margin-top: 0.3rem;
    color: #94a3b8;
  }
  .form-actions {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
  }
  .inline-checkbox {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.5rem;
    font-size: 0.9rem;
  }
  .fallback-preview {
    margin-top: 0.5rem;
  }
  .channel-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.6rem;
    margin: 0.15rem;
    border-radius: 999px;
    background: rgba(99,102,241,0.15);
    border: 1px solid rgba(99,102,241,0.4);
    font-size: 0.85rem;
  }
  .status-banner {
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
    margin-bottom: 1rem;
    font-weight: 600;
  }
  .status-info { background: rgba(59,130,246,0.1); color: #60a5fa; border: 1px solid rgba(59,130,246,0.4); }
  .status-success { background: rgba(16,185,129,0.12); color: #34d399; border: 1px solid rgba(16,185,129,0.4); }
  .status-error { background: rgba(239,68,68,0.12); color: #f87171; border: 1px solid rgba(239,68,68,0.4); }
  .status-warning { background: rgba(250,204,21,0.12); color: #fbbf24; border: 1px solid rgba(250,204,21,0.4); }
  .badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.8rem;
  }
  .badge-success { background: rgba(16,185,129,0.15); color: #10b981; }
  .badge-danger { background: rgba(239,68,68,0.15); color: #ef4444; }
  @media (max-width: 768px) {
    .sms-header { flex-direction: column; }
    .meta { width: 100%; flex-direction: column; }
    .sms-grid { grid-template-columns: 1fr; }
  }
</style>
{% endblock %}

{% block scripts %}
{{ super() }}
<script src="/js/admin/smsService.js"></script>
{% endblock %}
