{% extends "base.njk" %}
{% block title %}Universe Management{% endblock %}
{% block content %}
<div class="admin-layout">
  {% include "partials/admin-sidebar.njk" %}
  <main class="admin-content">
    <header class="admin-header">
      <h1>Universe Management</h1>
      <span class="admin-badge">Admin</span>
    </header>
    <section>
      <h2>All Universes</h2>
      <div id="universesTableContainer">
        <div style="color: #94a3b8;">Loading universes...</div>
      </div>
    </section>
  </main>
</div>
<style>
.admin-modal {
  display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100vw; height: 100vh;
  background: rgba(0,0,0,0.4); align-items: center; justify-content: center;
}
.admin-modal.active { display: flex; }
.admin-modal-content {
  background: #fff; padding: 2rem; border-radius: 8px; min-width: 350px; max-width: 90vw;
  box-shadow: 0 2px 16px rgba(0,0,0,0.2);
}
.admin-modal-content label { display: block; margin-top: 1rem; }
.admin-modal-content input, .admin-modal-content select, .admin-modal-content textarea {
  width: 100%; margin-top: 0.25rem; padding: 0.5rem; border-radius: 4px; border: 1px solid #ccc;
}
.admin-modal-content .modal-actions { margin-top: 1.5rem; text-align: right; }
</style>

<div id="editUniverseModal" class="admin-modal">
  <div class="admin-modal-content">
    <h3>Edit Universe Lifecycle</h3>
    <form id="editUniverseForm">
      <input type="hidden" name="id" id="editUniverseId">
      <label>Registration Status
        <select name="registrationStatus" id="editRegistrationStatus">
          <option value="open">Open</option>
          <option value="closed">Closed</option>
        </select>
      </label>
      <label>Registration Open At
        <input type="datetime-local" name="registrationOpenAt" id="editRegistrationOpenAt">
      </label>
      <label>Registration Close At
        <input type="datetime-local" name="registrationCloseAt" id="editRegistrationCloseAt">
      </label>
      <label>Universe Open At
        <input type="datetime-local" name="universeOpenAt" id="editUniverseOpenAt">
      </label>
      <label>Universe Close At
        <input type="datetime-local" name="universeCloseAt" id="editUniverseCloseAt">
      </label>
       <label>Speed Multiplier
         <input type="number" step="0.1" min="0.1" name="speedMultiplier" id="editSpeedMultiplier">
       </label>
       <label>Speed Progression Type
         <select name="speedProgressionType" id="editSpeedProgressionType">
           <option value="static">Static</option>
           <option value="progressive">Progressive</option>
           <option value="decreasing">Decreasing</option>
         </select>
       </label>
       <label>Speed Schedule (JSON)
         <textarea name="speedSchedule" id="editSpeedSchedule" rows="2" placeholder='[{"at":"2025-12-01T00:00:00Z","multiplier":2}]'></textarea>
       </label>
       <label>Building Speed Multiplier
         <input type="number" step="0.1" min="0.1" name="buildingSpeedMultiplier" id="editBuildingSpeedMultiplier">
       </label>
       <label>Building Speed Schedule (JSON)
         <textarea name="buildingSpeedSchedule" id="editBuildingSpeedSchedule" rows="2" placeholder='[{"at":"2025-12-01T00:00:00Z","multiplier":2}]'></textarea>
       </label>
       <label>Research Speed Multiplier
         <input type="number" step="0.1" min="0.1" name="researchSpeedMultiplier" id="editResearchSpeedMultiplier">
       </label>
       <label>Research Speed Schedule (JSON)
         <textarea name="researchSpeedSchedule" id="editResearchSpeedSchedule" rows="2" placeholder='[{"at":"2025-12-01T00:00:00Z","multiplier":2}]'></textarea>
       </label>
       <label>Base Storage Ration (JSON)
         <textarea name="baseStorageRation" id="editBaseStorageRation" rows="2" placeholder='{"metal":1,"crystal":1,"deuterium":1}'></textarea>
       </label>
       <label>Base Production Ration (JSON)
         <textarea name="baseProductionRation" id="editBaseProductionRation" rows="2" placeholder='{"metal":1,"crystal":1,"deuterium":1}'></textarea>
       </label>
      <label>Merging
        <select name="isMerging" id="editIsMerging">
          <option value="false">No</option>
          <option value="true">Yes</option>
        </select>
      </label>
      <label>Merge Target Universe ID
        <input type="number" name="mergeTargetUniverseId" id="editMergeTargetUniverseId">
      </label>
      <label>Announcement Type
        <select name="announcementType" id="editAnnouncementType">
          <option value="">None</option>
          <option value="info">Info</option>
          <option value="warning">Warning</option>
          <option value="end">End</option>
        </select>
      </label>
      <label>Announcement
        <textarea name="announcement" id="editAnnouncement" rows="2"></textarea>
      </label>
      <div class="modal-actions">
        <button type="button" onclick="closeEditModal()">Cancel</button>
        <button type="submit">Save</button>
      </div>
      <div id="editUniverseFeedback" style="margin-top:0.5rem;color:#ef4444;"></div>
    </form>
  </div>
</div>

<script>
async function loadUniverses() {
  const token = localStorage.getItem('token');
  const res = await fetch('/api/universe', { headers: { 'Authorization': `Bearer ${token}` } });
  const data = await res.json();
  const container = document.getElementById('universesTableContainer');
  if (!data.success) {
    container.innerHTML = '<div style="color: #ef4444;">Failed to load universes</div>';
    return;
  }
  if (data.universes.length === 0) {
    container.innerHTML = '<div style="color: #94a3b8;">No universes found.</div>';
    return;
  }
  container.innerHTML = `<table class="admin-table" style="width:100%;margin-top:1rem;">
    <thead>
      <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Status</th>
        <th>Registration</th>
        <th>Open/Close</th>
        <th>Speed</th>
        <th>Merging</th>
        <th>Announcement</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      ${data.universes.map(u => `
        <tr>
          <td>${u.id}</td>
          <td>${u.universeName}</td>
          <td>${u.isActive ? 'Active' : 'Closed'}</td>
          <td>${u.registrationStatus} <br> ${u.registrationOpenAt ? 'Open: ' + new Date(u.registrationOpenAt).toLocaleString() : ''} ${u.registrationCloseAt ? '<br>Close: ' + new Date(u.registrationCloseAt).toLocaleString() : ''}</td>
          <td>${u.universeOpenAt ? new Date(u.universeOpenAt).toLocaleString() : '-'}<br>${u.universeCloseAt ? new Date(u.universeCloseAt).toLocaleString() : '-'}</td>
          <td>${u.speedMultiplier}x (${u.speedProgressionType})</td>
          <td>${u.isMerging ? 'Yes' : 'No'}${u.mergeTargetUniverseId ? '<br>Target: ' + u.mergeTargetUniverseId : ''}</td>
          <td>${u.announcementType ? u.announcementType + ': ' : ''}${u.announcement || ''}</td>
          <td><button onclick="editUniverse(${u.id})">Edit</button></td>
        </tr>
      `).join('')}
    </tbody>
  </table>`;
}

let currentUniverse = null;

function closeEditModal() {
  document.getElementById('editUniverseModal').classList.remove('active');
  document.getElementById('editUniverseFeedback').textContent = '';
  currentUniverse = null;
}

async function editUniverse(id) {
  const token = localStorage.getItem('token');
  const res = await fetch(`/api/universe/${id}`, { headers: { 'Authorization': `Bearer ${token}` } });
  const data = await res.json();
  if (!data.success) {
    alert('Failed to load universe details');
    return;
  }
  const u = data.universe;
  currentUniverse = u;
  document.getElementById('editUniverseId').value = u.id;
  document.getElementById('editRegistrationStatus').value = u.registrationStatus || 'closed';
  document.getElementById('editRegistrationOpenAt').value = u.registrationOpenAt ? new Date(u.registrationOpenAt).toISOString().slice(0,16) : '';
  document.getElementById('editRegistrationCloseAt').value = u.registrationCloseAt ? new Date(u.registrationCloseAt).toISOString().slice(0,16) : '';
  document.getElementById('editUniverseOpenAt').value = u.universeOpenAt ? new Date(u.universeOpenAt).toISOString().slice(0,16) : '';
  document.getElementById('editUniverseCloseAt').value = u.universeCloseAt ? new Date(u.universeCloseAt).toISOString().slice(0,16) : '';
   document.getElementById('editSpeedMultiplier').value = u.speedMultiplier || 1;
   document.getElementById('editSpeedProgressionType').value = u.speedProgressionType || 'static';
   document.getElementById('editSpeedSchedule').value = u.speedSchedule ? JSON.stringify(u.speedSchedule, null, 2) : '';
   document.getElementById('editBuildingSpeedMultiplier').value = u.buildingSpeedMultiplier || '';
   document.getElementById('editBuildingSpeedSchedule').value = u.buildingSpeedSchedule ? JSON.stringify(u.buildingSpeedSchedule, null, 2) : '';
   document.getElementById('editResearchSpeedMultiplier').value = u.researchSpeedMultiplier || '';
   document.getElementById('editResearchSpeedSchedule').value = u.researchSpeedSchedule ? JSON.stringify(u.researchSpeedSchedule, null, 2) : '';
   document.getElementById('editBaseStorageRation').value = u.baseStorageRation ? JSON.stringify(u.baseStorageRation, null, 2) : '';
   document.getElementById('editBaseProductionRation').value = u.baseProductionRation ? JSON.stringify(u.baseProductionRation, null, 2) : '';

  document.getElementById('editIsMerging').value = u.isMerging ? 'true' : 'false';
  document.getElementById('editMergeTargetUniverseId').value = u.mergeTargetUniverseId || '';
  document.getElementById('editAnnouncementType').value = u.announcementType || '';
  document.getElementById('editAnnouncement').value = u.announcement || '';
  document.getElementById('editUniverseModal').classList.add('active');
}

document.getElementById('editUniverseForm').onsubmit = async function(e) {
  e.preventDefault();
  const token = localStorage.getItem('token');
  const id = document.getElementById('editUniverseId').value;
  document.getElementById('editUniverseFeedback').style.color = '#64748b';
  document.getElementById('editUniverseFeedback').textContent = 'Saving...';
  let ok = true, errorMsg = '';
  // Registration
  const regRes = await fetch(`/api/universe/${id}/registration`, {
    method: 'PATCH',
    headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
    body: JSON.stringify({
      registrationStatus: document.getElementById('editRegistrationStatus').value,
      registrationOpenAt: document.getElementById('editRegistrationOpenAt').value ? new Date(document.getElementById('editRegistrationOpenAt').value).toISOString() : null,
      registrationCloseAt: document.getElementById('editRegistrationCloseAt').value ? new Date(document.getElementById('editRegistrationCloseAt').value).toISOString() : null
    })
  });
  const regData = await regRes.json();
  if (!regData.success) { ok = false; errorMsg += 'Registration: ' + (regData.message || 'Failed') + '\n'; }
  // Lifecycle (open/close)
  const lifeRes = await fetch(`/api/universe/${id}/lifecycle`, {
    method: 'PATCH',
    headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
    body: JSON.stringify({
      universeOpenAt: document.getElementById('editUniverseOpenAt').value ? new Date(document.getElementById('editUniverseOpenAt').value).toISOString() : null,
      universeCloseAt: document.getElementById('editUniverseCloseAt').value ? new Date(document.getElementById('editUniverseCloseAt').value).toISOString() : null
    })
  });
  const lifeData = await lifeRes.json();
  if (!lifeData.success) { ok = false; errorMsg += 'Lifecycle: ' + (lifeData.message || 'Failed') + '\n'; }
  // Speed
   const speedRes = await fetch(`/api/universe/${id}/speed`, {
     method: 'PATCH',
     headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
     body: JSON.stringify({
       speedMultiplier: parseFloat(document.getElementById('editSpeedMultiplier').value),
       speedProgressionType: document.getElementById('editSpeedProgressionType').value,
       speedSchedule: document.getElementById('editSpeedSchedule').value ? JSON.parse(document.getElementById('editSpeedSchedule').value) : null,
       buildingSpeedMultiplier: document.getElementById('editBuildingSpeedMultiplier').value ? parseFloat(document.getElementById('editBuildingSpeedMultiplier').value) : null,
       buildingSpeedSchedule: document.getElementById('editBuildingSpeedSchedule').value ? JSON.parse(document.getElementById('editBuildingSpeedSchedule').value) : null,
       researchSpeedMultiplier: document.getElementById('editResearchSpeedMultiplier').value ? parseFloat(document.getElementById('editResearchSpeedMultiplier').value) : null,
       researchSpeedSchedule: document.getElementById('editResearchSpeedSchedule').value ? JSON.parse(document.getElementById('editResearchSpeedSchedule').value) : null,
       baseStorageRation: document.getElementById('editBaseStorageRation').value ? JSON.parse(document.getElementById('editBaseStorageRation').value) : null,
       baseProductionRation: document.getElementById('editBaseProductionRation').value ? JSON.parse(document.getElementById('editBaseProductionRation').value) : null
     })
   });
  const speedData = await speedRes.json();
  if (!speedData.success) { ok = false; errorMsg += 'Speed: ' + (speedData.message || 'Failed') + '\n'; }
  // Merge
  const mergeRes = await fetch(`/api/universe/${id}/merge`, {
    method: 'PATCH',
    headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
    body: JSON.stringify({
      isMerging: document.getElementById('editIsMerging').value === 'true',
      mergeTargetUniverseId: document.getElementById('editMergeTargetUniverseId').value ? parseInt(document.getElementById('editMergeTargetUniverseId').value) : null
    })
  });
  const mergeData = await mergeRes.json();
  if (!mergeData.success) { ok = false; errorMsg += 'Merge: ' + (mergeData.message || 'Failed') + '\n'; }
  // Announcement
  const annRes = await fetch(`/api/universe/${id}/announcement`, {
    method: 'PATCH',
    headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
    body: JSON.stringify({
      announcementType: document.getElementById('editAnnouncementType').value,
      announcement: document.getElementById('editAnnouncement').value
    })
  });
  const annData = await annRes.json();
  if (!annData.success) { ok = false; errorMsg += 'Announcement: ' + (annData.message || 'Failed') + '\n'; }
  if (ok) {
    document.getElementById('editUniverseFeedback').style.color = '#22c55e';
    document.getElementById('editUniverseFeedback').textContent = 'Saved!';
    setTimeout(() => {
      closeEditModal();
      loadUniverses();
    }, 800);
  } else {
    document.getElementById('editUniverseFeedback').style.color = '#ef4444';
    document.getElementById('editUniverseFeedback').textContent = errorMsg;
  }
}

document.addEventListener('DOMContentLoaded', loadUniverses);
</script>
{% endblock %}
