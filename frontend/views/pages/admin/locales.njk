{% extends "layouts/base.njk" %}

{% block title %}Locale Management{% endblock %}

{% block body %}
<div class="admin-locales-container">
  <h1>Locale Management</h1>
  <div class="locales-controls">
    <label for="localeSelect">Select Locale:</label>
    <select id="localeSelect"></select>
    <button id="reloadLocale" class="btn btn-secondary">Reload</button>
  </div>
  <div id="localeEditor" style="margin-top: 2rem;">
    <div id="localeLoading" style="display:none;">Loading...</div>
    <div id="localeError" class="toast error" style="display:none;"></div>
    <form id="localeForm" style="display:none;">
      <table class="locale-table">
        <thead>
          <tr><th>Key</th><th>Value</th></tr>
        </thead>
        <tbody id="localeTableBody">
        </tbody>
      </table>
      <div style="margin-top: 1.5rem;">
        <button type="submit" class="btn btn-success">Save Changes</button>
        <button type="button" id="cancelEdit" class="btn btn-secondary">Cancel</button>
      </div>
    </form>
  </div>
</div>
<style>
.admin-locales-container {
  max-width: 900px;
  margin: 0 auto;
  padding: 2rem;
}
.locales-controls {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1.5rem;
}
.locale-table {
  width: 100%;
  border-collapse: collapse;
}
.locale-table th, .locale-table td {
  border: 1px solid #333;
  padding: 0.5rem 0.75rem;
}
.locale-table th {
  background: #222;
  color: #fff;
}
.locale-table td input {
  width: 100%;
  background: #181818;
  color: #fff;
  border: 1px solid #444;
  border-radius: 3px;
  padding: 0.25rem 0.5rem;
}
.toast.error {
  background: #2e1a1a;
  color: #ff6b6b;
  border-left: 4px solid #ff6b6b;
  margin-bottom: 1rem;
}
</style>
{% endblock %}

{% block scripts %}
<script src="/js/admin/locales.js"></script>
{% endblock %}
