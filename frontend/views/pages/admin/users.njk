{% extends "base.njk" %}

{% block title %}User Management - Admin Panel{% endblock %}

{% block styles %}
<style>
  .admin-layout {
    display: grid;
    grid-template-columns: 250px 1fr;
    min-height: 100vh;
    background: linear-gradient(135deg, #0f0f23 0%, #1a1a2e 100%);
  }

  .admin-content {
    padding: 2rem;
    overflow-y: auto;
  }

  .page-header {
    margin-bottom: 2rem;
  }

  .page-header h1 {
    color: #e2e8f0;
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .page-header p {
    color: #94a3b8;
  }

  .toolbar {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .search-box {
    flex: 1;
    min-width: 300px;
  }

  .search-box input {
    width: 100%;
    padding: 0.75rem 1rem;
    background: rgba(26, 26, 46, 0.8);
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 0.5rem;
    color: #e2e8f0;
    font-size: 0.875rem;
  }

  .filter-select {
    padding: 0.75rem 1rem;
    background: rgba(26, 26, 46, 0.8);
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 0.5rem;
    color: #e2e8f0;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .users-table {
    background: rgba(26, 26, 46, 0.8);
    border: 1px solid rgba(99, 102, 241, 0.2);
    border-radius: 1rem;
    overflow: hidden;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  thead {
    background: rgba(99, 102, 241, 0.1);
  }

  th {
    padding: 1rem;
    text-align: left;
    color: #cbd5e1;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  td {
    padding: 1rem;
    border-top: 1px solid rgba(99, 102, 241, 0.1);
    color: #e2e8f0;
  }

  tbody tr:hover {
    background: rgba(99, 102, 241, 0.05);
  }

  .user-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .user-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: 700;
  }

  .status-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 0.375rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .status-active {
    background: rgba(16, 185, 129, 0.2);
    color: #10b981;
    border: 1px solid #10b981;
  }

  .status-banned {
    background: rgba(239, 68, 68, 0.2);
    color: #ef4444;
    border: 1px solid #ef4444;
  }

  .tag {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    margin: 0.125rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
  }

  .action-buttons {
    display: flex;
    gap: 0.5rem;
  }

  .action-btn {
    padding: 0.5rem 1rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    cursor: pointer;
    border: none;
  }

  .btn-view {
    background: rgba(99, 102, 241, 0.2);
    color: #6366f1;
  }

  .btn-block {
    background: rgba(239, 68, 68, 0.2);
    color: #ef4444;
  }

  .btn-tag {
    background: rgba(139, 92, 246, 0.2);
    color: #8b5cf6;
  }

  .pagination {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    padding: 1rem;
  }

  .page-btn {
    padding: 0.5rem 1rem;
    background: rgba(99, 102, 241, 0.2);
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 0.375rem;
    color: #6366f1;
    cursor: pointer;
  }

  .page-btn.active {
    background: #6366f1;
    color: white;
  }

  .modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.8);
    z-index: 1000;
    align-items: center;
    justify-content: center;
  }

  .modal.active {
    display: flex;
  }

  .modal-content {
    background: rgba(26, 26, 46, 0.95);
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 1rem;
    padding: 2rem;
    max-width: 500px;
    width: 90%;
  }

  .form-group {
    margin-bottom: 1rem;
  }

  .form-group label {
    display: block;
    color: #cbd5e1;
    margin-bottom: 0.5rem;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 0.75rem;
    background: rgba(15, 15, 35, 0.8);
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 0.5rem;
    color: #e2e8f0;
  }

  .form-actions {
    display: flex;
    gap: 1rem;
    justify-content: flex-end;
    margin-top: 1.5rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .stat-card {
    background: rgba(26, 26, 46, 0.8);
    border: 1px solid rgba(99, 102, 241, 0.2);
    border-radius: 0.75rem;
    padding: 1.5rem;
  }

  .stat-label {
    color: #94a3b8;
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
  }

  .stat-value {
    color: #6366f1;
    font-size: 2rem;
    font-weight: 700;
  }
</style>
{% endblock %}

{% block content %}
<div class="admin-layout">
  {% include "partials/admin-sidebar.njk" %}

  <main class="admin-content">
    <div class="page-header">
      <h1>{{ 'user_management' | t }}</h1>
      <p>{{ 'manage_users_desc' | t }}</p>
    </div>

    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-label">{{ 'total_users' | t }}</div>
        <div class="stat-value" id="totalUsers">-</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">{{ 'active_users' | t }}</div>
        <div class="stat-value" id="activeUsers">-</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">{{ 'banned_users' | t }}</div>
        <div class="stat-value" id="bannedUsers">-</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">{{ 'online_now' | t }}</div>
        <div class="stat-value" id="onlineUsers">-</div>
      </div>
    </div>

    <div class="toolbar">
      <div class="search-box">
        <input type="text" id="searchInput" placeholder="{{ 'search_users' | t }}">
      </div>
      <select id="statusFilter" class="filter-select">
        <option value="">{{ 'all_status' | t }}</option>
        <option value="active">{{ 'status_active' | t }}</option>
        <option value="banned">{{ 'status_banned' | t }}</option>
        <option value="suspended">{{ 'status_suspended' | t }}</option>
      </select>
      <button class="btn btn-primary" onclick="refreshUsers()">{{ 'refresh' | t }}</button>
    </div>

    <div class="users-table">
      <table>
        <thead>
          <tr>
<th>{{ 'user' | t }}</th>
                <th>{{ 'status' | t }}</th>
                <th>{{ 'tags' | t }}</th>
                <th>{{ 'joined' | t }}</th>
                <th>{{ 'last_login' | t }}</th>
                <th>{{ 'actions' | t }}</th>
          </tr>
        </thead>
        <tbody id="usersTableBody">
          <tr>
            <td colspan="6" style="text-align: center; padding: 2rem; color: #6366f1;">{{ 'loading_users' | t }}</td>
          </tr>
        </tbody>
      </table>

      <div class="pagination" id="pagination"></div>
    </div>
  </main>
</div>

<!-- Block User Modal -->
<div class="modal" id="blockModal">
  <div class="modal-content">
    <h2 style="color: #e2e8f0; margin-bottom: 1.5rem;">{{ 'block_user' | t }}</h2>
    <form id="blockForm">
      <input type="hidden" id="blockUserId">
      <div class="form-group">
        <label>{{ 'block_type' | t }}</label>
        <select id="blockType" required>
<option value="ban">{{ 'ban' | t }}</option>
            <option value="mute">{{ 'mute' | t }}</option>
            <option value="restrict">{{ 'restrict' | t }}</option>
            <option value="warning">{{ 'warning' | t }}</option>
        </select>
      </div>
      <div class="form-group">
        <label>{{ 'reason' | t }}</label>
        <textarea id="blockReason" required></textarea>
      </div>
      <div class="form-group">
        <label>{{ 'duration_minutes' | t }}</label>
        <input type="number" id="blockDuration">
      </div>
      <div class="form-actions">
        <button type="button" class="btn btn-secondary" onclick="closeModal('blockModal')">{{ 'cancel' | t }}</button>
        <button type="submit" class="btn btn-danger">{{ 'block_user_btn' | t }}</button>
      </div>
    </form>
  </div>
</div>

<!-- Tag User Modal -->
<div class="modal" id="tagModal">
  <div class="modal-content">
    <h2 style="color: #e2e8f0; margin-bottom: 1.5rem;">{{ 'tag_user' | t }}</h2>
    <form id="tagForm">
      <input type="hidden" id="tagUserId">
      <div class="form-group">
        <label>{{ 'tag_name' | t }}</label>
        <input type="text" id="tagName" required>
      </div>
      <div class="form-group">
        <label>{{ 'category' | t }}</label>
        <select id="tagCategory" required>
          <option value="behavior">{{ 'behavior' | t }}</option>
          <option value="payment">{{ 'payment_status' | t }}</option>
          <option value="skill">{{ 'skill_level' | t }}</option>
          <option value="special">{{ 'special_status' | t }}</option>
        </select>
      </div>
      <div class="form-group">
        <label>{{ 'color' | t }}</label>
        <input type="color" id="tagColor" value="#6366f1">
      </div>
      <div class="form-actions">
        <button type="button" class="btn btn-secondary" onclick="closeModal('tagModal')">{{ 'cancel' | t }}</button>
        <button type="submit" class="btn btn-primary">{{ 'add_tag' | t }}</button>
      </div>
    </form>
  </div>
</div>

<script>
let currentPage = 1;
let currentFilter = { search: '', status: '' };

async function loadUsers(page = 1) {
  try {
    const token = localStorage.getItem('token');
    const params = new URLSearchParams({ page, limit: 20, search: currentFilter.search, status: currentFilter.status });
    const response = await fetch(`/api/admin/users?${params}`, { headers: { 'Authorization': `Bearer ${token}` } });
    if (!response.ok) throw new Error('Failed to load users');
    const data = await response.json();
    renderUsers(data.data);
    renderPagination(data);
    currentPage = page;
    loadStats();
  } catch (error) {
    document.getElementById('usersTableBody').innerHTML = `<tr><td colspan="6" style="text-align: center; color: #ef4444;">${error.message}</td></tr>`;
  }
}

function renderUsers(users) {
  const tbody = document.getElementById('usersTableBody');
  if (users.length === 0) {
    tbody.innerHTML = `<tr><td colspan="6" style="text-align: center; padding: 2rem;">${window.t ? t('no_users_found') : 'No users found'}</td></tr>`;
    return;
  }
  tbody.innerHTML = users.map(user => `
    <tr>
      <td>
        <div class="user-info">
          <div class="user-avatar">${user.username.charAt(0).toUpperCase()}</div>
          <div>
            <div style="font-weight: 600;">${user.username}</div>
            <div style="font-size: 0.875rem; color: #64748b;">${user.email}</div>
          </div>
        </div>
      </td>
      <td><span class="status-badge status-${user.account_status || 'active'}">${user.account_status || 'active'}</span></td>
      <td>${(user.tags || []).map(tag => `<span class="tag" style="background: ${tag.color}22; color: ${tag.color}; border: 1px solid ${tag.color};">${tag.name}</span>`).join('')}</td>
      <td>${new Date(user.created_at).toLocaleDateString()}</td>
      <td>${user.last_login ? new Date(user.last_login).toLocaleString() : 'Never'}</td>
      <td>
        <div class="action-buttons">
          <button class="action-btn btn-block" onclick="openBlockModal(${user.id})">{{ window.t ? t('block_user_btn') : 'Block' }}</button>
          <button class="action-btn btn-tag" onclick="openTagModal(${user.id})">{{ window.t ? t('add_tag') : 'Tag' }}</button>
        </div>
      </td>
    </tr>
  `).join('');
}

function renderPagination(data) {
  const pagination = document.getElementById('pagination');
  let html = `<button class="page-btn" ${currentPage === 1 ? 'disabled' : ''} onclick="loadUsers(${currentPage - 1})">Previous</button>`;
  for (let i = 1; i <= Math.min(data.totalPages, 10); i++) {
    html += `<button class="page-btn ${i === currentPage ? 'active' : ''}" onclick="loadUsers(${i})">${i}</button>`;
  }
  html += `<button class="page-btn" ${currentPage === data.totalPages ? 'disabled' : ''} onclick="loadUsers(${currentPage + 1})">Next</button>`;
  pagination.innerHTML = html;
}

async function loadStats() {
  try {
    const token = localStorage.getItem('token');
    const response = await fetch('/api/admin/dashboard', { headers: { 'Authorization': `Bearer ${token}` } });
    if (!response.ok) return;
    const data = await response.json();
    document.getElementById('totalUsers').textContent = data.user_analytics.total_users;
    document.getElementById('activeUsers').textContent = data.user_analytics.active_users_today;
    document.getElementById('bannedUsers').textContent = data.user_analytics.banned_users;
    document.getElementById('onlineUsers').textContent = data.server_health.active_players;
  } catch (error) { console.error(error); }
}

document.getElementById('searchInput').addEventListener('input', (e) => {
  currentFilter.search = e.target.value;
  setTimeout(() => loadUsers(1), 500);
});

document.getElementById('statusFilter').addEventListener('change', (e) => {
  currentFilter.status = e.target.value;
  loadUsers(1);
});

function openBlockModal(userId) {
  document.getElementById('blockUserId').value = userId;
  document.getElementById('blockModal').classList.add('active');
}

document.getElementById('blockForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  try {
    const userId = document.getElementById('blockUserId').value;
    const data = {
      block_type: document.getElementById('blockType').value,
      reason: document.getElementById('blockReason').value,
      duration_minutes: document.getElementById('blockDuration').value || null,
      is_permanent: !document.getElementById('blockDuration').value
    };
    const token = localStorage.getItem('token');
    const response = await fetch(`/api/admin/users/${userId}/block`, {
      method: 'POST',
      headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });
    if (!response.ok) throw new Error('Failed to block user');
    alert(window.t ? t('user_blocked_success') : 'User blocked successfully');
    closeModal('blockModal');
    loadUsers(currentPage);
  } catch (error) {
    alert((window.t ? t('error_prefix') : 'Error: ') + error.message);
  }
});

function openTagModal(userId) {
  document.getElementById('tagUserId').value = userId;
  document.getElementById('tagModal').classList.add('active');
}

document.getElementById('tagForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  try {
    const userId = document.getElementById('tagUserId').value;
    const data = {
      tag_name: document.getElementById('tagName').value,
      tag_category: document.getElementById('tagCategory').value,
      tag_color: document.getElementById('tagColor').value
    };
    const token = localStorage.getItem('token');
    const response = await fetch(`/api/admin/users/${userId}/tag`, {
      method: 'POST',
      headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });
    if (!response.ok) throw new Error('Failed to tag user');
    alert(window.t ? t('tag_added_success') : 'Tag added successfully');
    closeModal('tagModal');
    loadUsers(currentPage);
  } catch (error) {
    alert((window.t ? t('error_prefix') : 'Error: ') + error.message);
  }
});

function closeModal(modalId) {
  document.getElementById(modalId).classList.remove('active');
}

function refreshUsers() {
  loadUsers(currentPage);
}

loadUsers(1);
</script>
{% endblock %}
