{% extends "../layouts/base.njk" %}

{% block title %}Theme Management - Admin Panel{% endblock %}

{% block styles %}
<link rel="stylesheet" href="/css/theme-effects.css">
<style>
    .theme-card {
        border: 2px solid #ddd;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 20px;
        transition: all 0.3s ease;
    }
    
    .theme-card:hover {
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        transform: translateY(-2px);
    }
    
    .theme-card.active {
        border-color: #28a745;
        background: rgba(40, 167, 69, 0.05);
    }
    
    .theme-preview-box {
        display: flex;
        gap: 10px;
        margin: 10px 0;
    }
    
    .color-swatch {
        width: 50px;
        height: 50px;
        border-radius: 5px;
        border: 2px solid #333;
        cursor: pointer;
    }
    
    .schedule-list {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 5px;
        margin-top: 10px;
    }
    
    .schedule-item {
        background: white;
        padding: 10px;
        margin: 5px 0;
        border-radius: 5px;
        border-left: 4px solid #007bff;
    }
    
    .analytics-card {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 8px;
        margin: 10px 0;
    }
    
    .stat-value {
        font-size: 32px;
        font-weight: bold;
        color: #007bff;
    }
    
    .stat-label {
        font-size: 14px;
        color: #666;
        text-transform: uppercase;
    }
    
    .modal {
        display: none;
        position: fixed;
        z-index: 10010;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
    }
    
    .modal.active {
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .modal-content {
        background: white;
        padding: 30px;
        border-radius: 10px;
        max-width: 600px;
        width: 90%;
        max-height: 80vh;
        overflow-y: auto;
    }
</style>
{% endblock %}

{% block content %}
<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1>{{ 'theme_management' | t }}</h1>
            <p class="text-muted">{{ 'manage_themes_desc' | t }}</p>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="row mb-4">
        <div class="col-12">
            <button class="btn btn-primary" onclick="createTheme()">
                <i class="fas fa-plus"></i> {{ 'create_new_theme' | t }}
            </button>
            <button class="btn btn-info" onclick="checkSchedules()">
                <i class="fas fa-sync"></i> {{ 'check_schedules_now' | t }}
            </button>
            <button class="btn btn-secondary" onclick="viewAnalytics()">
                <i class="fas fa-chart-bar"></i> {{ 'view_analytics' | t }}
            </button>
        </div>
    </div>

    <!-- Current Active Theme -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">{{ 'currently_active_theme' | t }}</h5>
                </div>
                <div class="card-body" id="current-theme-display">
                    <p class="text-muted">{{ 'loading' | t }}</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Theme List -->
    <div class="row">
        <div class="col-12">
            <h3>{{ 'all_themes' | t }}</h3>
            <div id="themes-container">
                <p class="text-muted">{{ 'loading_themes' | t }}</p>
            </div>
        </div>
    </div>

    <!-- Active Schedules -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">{{ 'active_schedules' | t }}</h5>
                </div>
                <div class="card-body">
                    <div id="schedules-container">
                        <p class="text-muted">Loading schedules...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create/Edit Theme Modal -->
<div id="theme-modal" class="modal">
    <div class="modal-content">
        <h3 id="modal-title">{{ 'create_theme' | t }}</h3>
        <form id="theme-form" onsubmit="saveTheme(event)">
            <div class="form-group">
                <label>{{ 'theme_key' | t }}</label>
                <input type="text" class="form-control" id="theme-key" required>
                <small class="text-muted">{{ 'theme_key_hint' | t }}</small>
            </div>
            
            <div class="form-group">
                <label>{{ 'name' | t }}</label>
                <input type="text" class="form-control" id="theme-name" required>
            </div>
            
            <div class="form-group">
                <label>{{ 'description' | t }}</label>
                <textarea class="form-control" id="theme-description" rows="3"></textarea>
            </div>
            
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label>{{ 'primary_color' | t }}</label>
                        <input type="color" class="form-control" id="theme-primary-color" required>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>{{ 'secondary_color' | t }}</label>
                        <input type="color" class="form-control" id="theme-secondary-color" required>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>{{ 'accent_color' | t }}</label>
                        <input type="color" class="form-control" id="theme-accent-color" required>
                    </div>
                </div>
            </div>
            
            <div class="form-group">
                <label>{{ 'category' | t }}</label>
                <select class="form-control" id="theme-category" required>
                    <option value="seasonal">{{ 'seasonal' | t }}</option>
                    <option value="event">{{ 'event' | t }}</option>
                    <option value="special">{{ 'special' | t }}</option>
                    <option value="custom">{{ 'custom' | t }}</option>
                </select>
            </div>
            
            <div class="form-group">
                <label>
                    <input type="checkbox" id="theme-available"> {{ 'available_for_use' | t }}
                </label>
            </div>
            
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">{{ 'save_theme' | t }}</button>
                <button type="button" class="btn btn-secondary" onclick="closeModal()">{{ 'cancel' | t }}</button>
            </div>
        </form>
    </div>
</div>

<!-- Schedule Modal -->
<div id="schedule-modal" class="modal">
    <div class="modal-content">
        <h3>{{ 'create_schedule' | t }}</h3>
        <form id="schedule-form" onsubmit="saveSchedule(event)">
            <input type="hidden" id="schedule-theme-id">
            
            <div class="form-group">
                <label>{{ 'schedule_name' | t }}</label>
                <input type="text" class="form-control" id="schedule-name" required>
            </div>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>{{ 'start_date' | t }}</label>
                        <input type="date" class="form-control" id="schedule-start-date" required>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>{{ 'end_date' | t }}</label>
                        <input type="date" class="form-control" id="schedule-end-date" required>
                    </div>
                </div>
            </div>
            
            <div class="form-group">
                <label>{{ 'priority' | t }}</label>
                <input type="number" class="form-control" id="schedule-priority" min="0" max="100" value="50" required>
                <small class="text-muted">{{ 'priority_hint' | t }}</small>
            </div>
            
            <div class="form-group">
                <label>
                    <input type="checkbox" id="schedule-recurring" checked> {{ 'recurring_annually' | t }}
                </label>
            </div>
            
            <div class="form-group">
                <label>
                    <input type="checkbox" id="schedule-enabled" checked> {{ 'enabled' | t }}
                </label>
            </div>
            
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">{{ 'create_schedule' | t }}</button>
                <button type="button" class="btn btn-secondary" onclick="closeScheduleModal()">{{ 'cancel' | t }}</button>
            </div>
        </form>
    </div>
</div>

<script>
let currentEditingTheme = null;
const apiUrl = '/api/themes';

// Load themes on page load
document.addEventListener('DOMContentLoaded', function() {
    loadCurrentTheme();
    loadThemes();
    loadActiveSchedules();
});

// Load current active theme
async function loadCurrentTheme() {
    try {
        const response = await fetch(`${apiUrl}/current`);
        const data = await response.json();
        
        const container = document.getElementById('current-theme-display');
        
        if (data.success && data.theme) {
            container.innerHTML = `
                <h4>${data.theme.name}</h4>
                <p>${data.theme.description || (window.t ? t('no_description') : 'No description')}</p>
                <div class="theme-preview-box">
                    <div class="color-swatch" style="background: ${data.theme.primary_color}"></div>
                    <div class="color-swatch" style="background: ${data.theme.secondary_color}"></div>
                    <div class="color-swatch" style="background: ${data.theme.accent_color}"></div>
                </div>
                <button class="btn btn-sm btn-danger mt-2" onclick="deactivateTheme(${data.theme.id})">
                    Deactivate
                </button>
            `;
        } else {
            container.innerHTML = '<p class="text-muted">{{ 'no_active_theme' | t }}</p>';
        }
    } catch (error) {
        console.error('Error loading current theme:', error);
    }
}

// Load all themes
async function loadThemes() {
    try {
        const token = localStorage.getItem('token');
        const response = await fetch(apiUrl, {
            headers: {
                'Authorization': `Bearer ${token}`
            }
        });
        const data = await response.json();
        
        const container = document.getElementById('themes-container');
        
        if (data.success && data.themes.length > 0) {
            container.innerHTML = data.themes.map(theme => `
                <div class="theme-card ${theme.is_active ? 'active' : ''}">
                    <div class="row">
                        <div class="col-md-8">
                            <h4>${theme.name} ${theme.is_active ? '<span class="badge badge-success">Active</span>' : ''}</h4>
                            <p><strong>${window.t ? t('key_label') : 'Key:'}</strong> ${theme.theme_key}</p>
                            <p>${theme.description || 'No description'}</p>
                            <div class="theme-preview-box">
                                <div class=\"color-swatch\" style=\"background: ${theme.primary_color}\" title=\"${window.t ? t('primary') : 'Primary'}\"></div>
                                <div class=\"color-swatch\" style=\"background: ${theme.secondary_color}\" title=\"${window.t ? t('secondary') : 'Secondary'}\"></div>
                                <div class=\"color-swatch\" style=\"background: ${theme.accent_color}\" title=\"${window.t ? t('accent') : 'Accent'}\"></div>
                            </div>
                        </div>
                        <div class="col-md-4 text-right">
                            <button class="btn btn-sm btn-success mb-2" onclick="activateTheme(${theme.id})">
                                <i class="fas fa-play"></i> Activate
                            </button>
                            <button class="btn btn-sm btn-info mb-2" onclick="previewTheme(${theme.id})">
                                <i class="fas fa-eye"></i> Preview
                            </button>
                            <button class="btn btn-sm btn-primary mb-2" onclick="createScheduleFor(${theme.id})">
                                <i class="fas fa-calendar"></i> Schedule
                            </button>
                            <button class="btn btn-sm btn-secondary mb-2" onclick="viewThemeAnalytics(${theme.id})">
                                <i class="fas fa-chart-line"></i> Analytics
                            </button>
                            <button class="btn btn-sm btn-warning mb-2" onclick="editTheme(${theme.id})">
                                <i class="fas fa-edit"></i> Edit
                            </button>
                            <button class="btn btn-sm btn-danger mb-2" onclick="deleteTheme(${theme.id})">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        </div>
                    </div>
                </div>
            `).join('');
        } else {
            container.innerHTML = '<p class=\"text-muted\">{{ 'no_themes_found' | t }}</p>';
        }
    } catch (error) {
        console.error('Error loading themes:', error);
    }
}

// Load active schedules
async function loadActiveSchedules() {
    try {
        const token = localStorage.getItem('token');
        const response = await fetch(`${apiUrl}/admin/schedules/active`, {
            headers: {
                'Authorization': `Bearer ${token}`
            }
        });
        const data = await response.json();
        
        const container = document.getElementById('schedules-container');
        
        if (data.success && data.schedules.length > 0) {
            container.innerHTML = data.schedules.map(schedule => `
                <div class="schedule-item">
                    <strong>${schedule.schedule_name}</strong> (Priority: ${schedule.priority})<br>
                    <small>
                        ${new Date(schedule.start_date).toLocaleDateString()} - 
                        ${new Date(schedule.end_date).toLocaleDateString()}
                        ${schedule.is_recurring ? '(Recurring)' : ''}
                    </small>
                </div>
            `).join('');
        } else {
            container.innerHTML = '<p class="text-muted">{{ 'no_active_schedules' | t }}</p>';
        }
    } catch (error) {
        console.error('Error loading schedules:', error);
    }
}

// Activate theme
async function activateTheme(themeId) {
    if (!confirm(window.t ? t('confirm_activate_theme') : 'Activate this theme? This will replace the current active theme.')) return;
    
    try {
        const token = localStorage.getItem('token');
        const response = await fetch(`${apiUrl}/${themeId}/activate`, {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ reason: 'Manual activation by admin' })
        });
        
        const data = await response.json();
        
        if (data.success) {
            alert(window.t ? t('theme_activated_success') : 'Theme activated successfully!');
            loadCurrentTheme();
            loadThemes();
            window.dispatchEvent(new Event('refreshTheme'));
        } else {
            alert((window.t ? t('failed_activate_theme') : 'Failed to activate theme: ') + data.message);
        }
    } catch (error) {
        console.error('Error activating theme:', error);
        alert('Error activating theme');
    }
}

// Deactivate theme
async function deactivateTheme(themeId) {
    if (!confirm(window.t ? t('confirm_deactivate_theme') : 'Deactivate this theme?')) return;
    
    try {
        const token = localStorage.getItem('token');
        const response = await fetch(`${apiUrl}/${themeId}/deactivate`, {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${token}`
            }
        });
        
        const data = await response.json();
        
        if (data.success) {
            alert(window.t ? t('theme_deactivated_success') : 'Theme deactivated successfully!');
            loadCurrentTheme();
            loadThemes();
            window.dispatchEvent(new Event('refreshTheme'));
        } else {
            alert(window.t ? t('failed_deactivate_theme') : 'Failed to deactivate theme');
        }
    } catch (error) {
        console.error('Error deactivating theme:', error);
    }
}

// Preview theme
async function previewTheme(themeId) {
    try {
        const token = localStorage.getItem('token');
        const response = await fetch(`${apiUrl}/${themeId}/preview`, {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${token}`
            }
        });
        
        const data = await response.json();
        
        if (data.success) {
            alert(window.t ? t('preview_mode_enabled') : 'Preview mode enabled! Refresh to see changes.');
            window.location.reload();
        }
    } catch (error) {
        console.error('Error enabling preview:', error);
    }
}

// Check schedules manually
async function checkSchedules() {
    try {
        const token = localStorage.getItem('token');
        const response = await fetch(`${apiUrl}/admin/check-schedules`, {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${token}`
            }
        });
        
        const data = await response.json();
        
        if (data.success) {
            if (data.activated) {
                alert(`Theme activated: ${data.theme?.name}`);
            } else {
                alert(window.t ? t('no_schedule_changes') : 'No schedule changes');
            }
            loadCurrentTheme();
            loadThemes();
        }
    } catch (error) {
        console.error('Error checking schedules:', error);
    }
}

// Create theme modal
function createTheme() {
    document.getElementById('modal-title').textContent = window.t ? t('create_new_theme') : 'Create New Theme';
    document.getElementById('theme-form').reset();
    currentEditingTheme = null;
    document.getElementById('theme-modal').classList.add('active');
}

// Close modal
function closeModal() {
    document.getElementById('theme-modal').classList.remove('active');
}

// Save theme
async function saveTheme(event) {
    event.preventDefault();
    
    const themeData = {
        theme_key: document.getElementById('theme-key').value,
        name: document.getElementById('theme-name').value,
        description: document.getElementById('theme-description').value,
        category: document.getElementById('theme-category').value,
        primary_color: document.getElementById('theme-primary-color').value,
        secondary_color: document.getElementById('theme-secondary-color').value,
        accent_color: document.getElementById('theme-accent-color').value,
        is_available: document.getElementById('theme-available').checked
    };
    
    try {
        const token = localStorage.getItem('token');
        const url = currentEditingTheme ? `${apiUrl}/${currentEditingTheme}` : apiUrl;
        const method = currentEditingTheme ? 'PUT' : 'POST';
        
        const response = await fetch(url, {
            method: method,
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(themeData)
        });
        
        const data = await response.json();
        
        if (data.success) {
            alert(window.t ? t('theme_saved_success') : 'Theme saved successfully!');
            closeModal();
            loadThemes();
        } else {
            alert((window.t ? t('error_prefix') : 'Error: ') + data.message);
        }
    } catch (error) {
        console.error('Error saving theme:', error);
        alert((window.t ? t('error_prefix') : 'Error saving theme'));
    }
}
    } catch (error) {
        console.error('Error saving theme:', error);
        alert((window.t ? t('error_prefix') : 'Error saving theme');
    }
}

// Create schedule for theme
function createScheduleFor(themeId) {
    document.getElementById('schedule-theme-id').value = themeId;
    document.getElementById('schedule-form').reset();
    document.getElementById('schedule-modal').classList.add('active');
}

// Close schedule modal
function closeScheduleModal() {
    document.getElementById('schedule-modal').classList.remove('active');
}

// Save schedule
async function saveSchedule(event) {
    event.preventDefault();
    
    const scheduleData = {
        theme_id: parseInt(document.getElementById('schedule-theme-id').value),
        schedule_name: document.getElementById('schedule-name').value,
        start_date: document.getElementById('schedule-start-date').value,
        end_date: document.getElementById('schedule-end-date').value,
        priority: parseInt(document.getElementById('schedule-priority').value),
        is_recurring: document.getElementById('schedule-recurring').checked,
        enabled: document.getElementById('schedule-enabled').checked
    };
    
    try {
        const token = localStorage.getItem('token');
        const response = await fetch(`${apiUrl}/admin/schedules`, {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(scheduleData)
        });
        
        const data = await response.json();
        
        if (data.success) {
            alert(window.t ? t('schedule_created_success') : 'Schedule created successfully!');
            closeScheduleModal();
            loadActiveSchedules();
        } else {
            alert((window.t ? t('error_prefix') : 'Error: ') + data.message);
        }
    } catch (error) {
        console.error('Error saving schedule:', error);
        alert(window.t ? t('error_saving_schedule') : 'Error saving schedule');
    }
}

// Delete theme
async function deleteTheme(themeId) {
    if (!confirm(window.t ? t('confirm_delete_theme') : 'Delete this theme? This action cannot be undone.')) return;
    
    try {
        const token = localStorage.getItem('token');
        const response = await fetch(`${apiUrl}/${themeId}`, {
            method: 'DELETE',
            headers: {
                'Authorization': `Bearer ${token}`
            }
        });
        
        const data = await response.json();
        
        if (data.success) {
            alert(window.t ? t('theme_deleted_success') : 'Theme deleted successfully!');
            loadThemes();
        } else {
            alert(window.t ? t('error_deleting_theme') : 'Error deleting theme');
        }
    } catch (error) {
        console.error('Error deleting theme:', error);
    }
}

// View analytics
function viewAnalytics() {
    alert('Analytics view coming soon!');
}

// View theme analytics
function viewThemeAnalytics(themeId) {
    alert(window.t ? t('theme_analytics_coming_soon', {id: themeId}) : `Theme analytics for ID ${themeId} coming soon!`);
}
</script>
{% endblock %}
