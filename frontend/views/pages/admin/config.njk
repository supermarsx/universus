{% extends "layouts/admin.njk" %}

{% block title %}Configuration Management - Admin Panel{% endblock %}

{% block content %}
<div class="admin-config-container">
    <!-- Header -->
    <div class="config-header">
        <h1>Configuration Management</h1>
        <div class="config-actions">
            <button id="refreshCache" class="btn btn-secondary">
                <i class="icon-refresh"></i> Refresh Cache
            </button>
            <button id="refreshSnapshot" class="btn btn-secondary">
                <i class="icon-bolt"></i> Refresh Snapshot
            </button>
            <button id="viewSnapshot" class="btn btn-info">
                <i class="icon-eye"></i> View Snapshot
            </button>
            <button id="exportConfig" class="btn btn-primary">
                <i class="icon-download"></i> Export
            </button>
            <button id="importConfig" class="btn btn-primary">
                <i class="icon-upload"></i> Import
            </button>
            <button id="viewHistory" class="btn btn-info">
                <i class="icon-history"></i> History
            </button>
        </div>
    </div>

    <!-- Statistics Dashboard -->
    <div class="config-stats">
        <div class="stat-card">
            <div class="stat-icon">
                <i class="icon-settings"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value" id="totalParams">0</div>
                <div class="stat-label">Total Parameters</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon warning">
                <i class="icon-edit"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value" id="modifiedParams">0</div>
                <div class="stat-label">Modified</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon success">
                <i class="icon-check"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value" id="recentChanges">0</div>
                <div class="stat-label">Changes (24h)</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon danger">
                <i class="icon-alert"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value" id="restartRequired">0</div>
                <div class="stat-label">Restart Required</div>
            </div>
        </div>
</div>

    <!-- Runtime Snapshot -->
    <div class="config-runtime card">
        <div class="config-runtime-header">
            <div>
                <h2>Runtime Game Configuration</h2>
                <p class="text-muted">Live values served from Redis snapshot</p>
            </div>
            <div class="runtime-actions">
                <button id="snapshotRefreshInline" class="btn btn-secondary">
                    <i class="icon-refresh"></i> Refresh
                </button>
                <button id="snapshotViewJson" class="btn btn-info">
                    <i class="icon-eye"></i> View JSON
                </button>
            </div>
        </div>
        <div class="snapshot-summary" id="snapshotSummary">
            <div class="snapshot-placeholder">Loading runtime configuration…</div>
        </div>
    </div>

    <!-- Category Tabs -->
    <div class="config-tabs">
        <div class="tab-list" id="categoryTabs">
            <!-- Tabs will be populated dynamically -->
        </div>
    </div>

    <!-- Configuration Editor -->
    <div class="config-editor">
        <div class="editor-toolbar">
            <input type="text" id="searchParams" placeholder="Search parameters..." class="search-input">
            <div class="toolbar-actions">
                <button id="saveChanges" class="btn btn-success" disabled>
                    <i class="icon-save"></i> Save Changes
                </button>
                <button id="discardChanges" class="btn btn-secondary" disabled>
                    <i class="icon-cancel"></i> Discard
                </button>
                <button id="resetCategory" class="btn btn-danger">
                    <i class="icon-reset"></i> Reset to Defaults
                </button>
            </div>
        </div>

        <div class="parameters-list" id="parametersList">
            <!-- Parameters will be populated dynamically -->
        </div>
    </div>

    <!-- Modals -->
    
    <!-- History Modal -->
    <div id="historyModal" class="modal">
        <div class="modal-content large">
            <div class="modal-header">
                <h2>Configuration Change History</h2>
                <button class="modal-close">&times;</button>
            </div>
            <div class="modal-body">
                <div class="history-filters">
                    <select id="historyCategory">
                        <option value="">All Categories</option>
                    </select>
                    <input type="date" id="historyStartDate">
                    <input type="date" id="historyEndDate">
                    <button id="applyHistoryFilter" class="btn btn-sm btn-primary">Filter</button>
                </div>
                <div class="history-list" id="historyList">
                    <!-- History items populated dynamically -->
                </div>
            </div>
        </div>
    </div>

    <!-- Import Modal -->
    <div id="importModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Import Configuration</h2>
                <button class="modal-close">&times;</button>
            </div>
            <div class="modal-body">
                <div class="import-options">
                    <label>
                        <input type="radio" name="importMethod" value="file" checked>
                        Upload File
                    </label>
                    <label>
                        <input type="radio" name="importMethod" value="paste">
                        Paste JSON
                    </label>
                </div>
                <div id="importFileSection">
                    <input type="file" id="importFile" accept=".json">
                </div>
                <div id="importPasteSection" style="display:none;">
                    <textarea id="importJSON" rows="10" placeholder="Paste configuration JSON here..."></textarea>
                </div>
                <div class="import-validation" id="importValidation"></div>
            </div>
            <div class="modal-footer">
                <button id="validateImport" class="btn btn-secondary">Validate</button>
                <button id="performImport" class="btn btn-primary" disabled>Import</button>
            </div>
        </div>
    </div>

    <!-- Template Modal -->
    <div id="templateModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Configuration Templates</h2>
                <button class="modal-close">&times;</button>
            </div>
            <div class="modal-body">
                <div class="template-actions">
                    <button id="createTemplate" class="btn btn-primary">Create New Template</button>
                </div>
                <div class="template-list" id="templateList">
                    <!-- Templates populated dynamically -->
                </div>
            </div>
        </div>
    </div>

    <!-- Snapshot Modal -->
    <div id="snapshotModal" class="modal">
        <div class="modal-content wide">
            <div class="modal-header">
                <h2>Runtime Configuration Snapshot</h2>
                <button class="modal-close">&times;</button>
            </div>
            <div class="modal-body">
                <pre id="snapshotJson" class="snapshot-json">Loading…</pre>
            </div>
        </div>
    </div>

    <!-- Confirmation Modal -->
    <div id="confirmModal" class="modal">
        <div class="modal-content small">
            <div class="modal-header">
                <h2 id="confirmTitle">Confirm Action</h2>
                <button class="modal-close">&times;</button>
            </div>
            <div class="modal-body">
                <p id="confirmMessage"></p>
                <div class="form-group">
                    <label for="confirmReason">Reason (optional):</label>
                    <input type="text" id="confirmReason" placeholder="Why are you making this change?">
                </div>
            </div>
            <div class="modal-footer">
                <button id="confirmCancel" class="btn btn-secondary">Cancel</button>
                <button id="confirmOk" class="btn btn-danger">Confirm</button>
            </div>
        </div>
    </div>
</div>

<style>
.admin-config-container {
    padding: 20px;
    max-width: 1400px;
    margin: 0 auto;
}

.config-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid #333;
}

.config-header h1 {
    color: #4a9eff;
    font-size: 28px;
    margin: 0;
}

.config-actions {
    display: flex;
    gap: 10px;
}

.config-runtime {
    background: #1a1a2e;
    border: 1px solid #333;
    border-radius: 10px;
    padding: 20px;
    margin-bottom: 30px;
}

.config-runtime-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 15px;
}

.snapshot-summary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 15px;
}

.snapshot-card {
    background: rgba(12, 16, 32, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 14px;
}

.snapshot-card h4 {
    margin: 0 0 6px;
    font-size: 0.95rem;
    color: #8fb2ff;
}

.snapshot-card .snapshot-count {
    font-size: 1.5rem;
    font-weight: 700;
    color: #fff;
}

.snapshot-card .snapshot-desc {
    font-size: 0.85rem;
    color: #8e8ea0;
}

.snapshot-placeholder {
    text-align: center;
    color: #8e8ea0;
    padding: 20px;
    border: 1px dashed rgba(255, 255, 255, 0.1);
    border-radius: 10px;
}

.config-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin-bottom: 30px;
}

.stat-card {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    border: 1px solid #333;
    border-radius: 10px;
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 15px;
}

.stat-icon {
    width: 50px;
    height: 50px;
    border-radius: 10px;
    background: #2a2a3e;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    color: #4a9eff;
}

.stat-icon.warning { color: #ffa94d; }
.stat-icon.success { color: #51cf66; }
.stat-icon.danger { color: #ff6b6b; }

.stat-value {
    font-size: 32px;
    font-weight: bold;
    color: #fff;
}

.stat-label {
    color: #8e8ea0;
    font-size: 14px;
}

.config-tabs {
    margin-bottom: 20px;
}

.tab-list {
    display: flex;
    gap: 5px;
    border-bottom: 2px solid #333;
    overflow-x: auto;
}

.tab {
    padding: 12px 24px;
    background: #1a1a2e;
    border: 1px solid #333;
    border-bottom: none;
    border-radius: 8px 8px 0 0;
    cursor: pointer;
    color: #8e8ea0;
    transition: all 0.3s;
    white-space: nowrap;
}

.tab:hover {
    background: #2a2a3e;
    color: #fff;
}

.tab.active {
    background: #4a9eff;
    color: #fff;
    border-color: #4a9eff;
}

.config-editor {
    background: #1a1a2e;
    border: 1px solid #333;
    border-radius: 10px;
    padding: 20px;
}

.modal-content.wide {
    max-width: 1000px;
}

.snapshot-json {
    max-height: 70vh;
    overflow: auto;
    background: #0b0f1d;
    color: #dce3f5;
    font-size: 0.85rem;
    border-radius: 8px;
    padding: 15px;
}

.editor-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    gap: 15px;
}

.search-input {
    flex: 1;
    padding: 10px 15px;
    background: #0f0f1e;
    border: 1px solid #333;
    border-radius: 5px;
    color: #fff;
    font-size: 14px;
}

.toolbar-actions {
    display: flex;
    gap: 10px;
}

.parameters-list {
    max-height: 600px;
    overflow-y: auto;
}

.parameter-item {
    background: #0f0f1e;
    border: 1px solid #333;
    border-radius: 8px;
    padding: 15px;
    margin-bottom: 10px;
    transition: all 0.3s;
}

.parameter-item:hover {
    border-color: #4a9eff;
}

.parameter-item.modified {
    border-left: 4px solid #ffa94d;
}

.parameter-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 10px;
}

.parameter-name {
    font-size: 16px;
    font-weight: bold;
    color: #4a9eff;
}

.parameter-key {
    font-size: 12px;
    color: #8e8ea0;
    font-family: monospace;
}

.parameter-description {
    color: #8e8ea0;
    font-size: 13px;
    margin-bottom: 10px;
}

.parameter-input-group {
    display: flex;
    gap: 10px;
    align-items: center;
}

.parameter-input {
    flex: 1;
    padding: 8px 12px;
    background: #1a1a2e;
    border: 1px solid #333;
    border-radius: 5px;
    color: #fff;
    font-size: 14px;
}

.parameter-input:focus {
    border-color: #4a9eff;
    outline: none;
}

.parameter-actions {
    display: flex;
    gap: 5px;
}

.btn-sm {
    padding: 6px 12px;
    font-size: 12px;
}

.history-item {
    background: #0f0f1e;
    border: 1px solid #333;
    border-radius: 8px;
    padding: 15px;
    margin-bottom: 10px;
}

.history-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.history-param {
    font-weight: bold;
    color: #4a9eff;
}

.history-time {
    color: #8e8ea0;
    font-size: 12px;
}

.history-change {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 10px;
    align-items: center;
    margin-bottom: 10px;
}

.value-box {
    background: #1a1a2e;
    padding: 8px;
    border-radius: 4px;
    font-family: monospace;
    text-align: center;
}

.value-old { color: #ff6b6b; }
.value-new { color: #51cf66; }

.history-meta {
    color: #8e8ea0;
    font-size: 12px;
}

.modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    z-index: 1000;
    overflow-y: auto;
}

.modal.active {
    display: flex;
    align-items: center;
    justify-content: center;
}

.modal-content {
    background: #1a1a2e;
    border: 1px solid #333;
    border-radius: 10px;
    width: 90%;
    max-width: 600px;
    max-height: 90vh;
    overflow-y: auto;
}

.modal-content.large {
    max-width: 900px;
}

.modal-content.small {
    max-width: 400px;
}

.modal-header {
    padding: 20px;
    border-bottom: 1px solid #333;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.modal-header h2 {
    margin: 0;
    color: #4a9eff;
}

.modal-close {
    background: none;
    border: none;
    font-size: 28px;
    color: #8e8ea0;
    cursor: pointer;
    padding: 0;
    width: 30px;
    height: 30px;
}

.modal-close:hover {
    color: #fff;
}

.modal-body {
    padding: 20px;
}

.modal-footer {
    padding: 20px;
    border-top: 1px solid #333;
    display: flex;
    justify-content: flex-end;
    gap: 10px;
}

.btn {
    padding: 10px 20px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-size: 14px;
    font-weight: bold;
    transition: all 0.3s;
}

.btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.btn-primary {
    background: #4a9eff;
    color: #fff;
}

.btn-primary:hover:not(:disabled) {
    background: #3a8eef;
}

.btn-secondary {
    background: #666;
    color: #fff;
}

.btn-secondary:hover:not(:disabled) {
    background: #777;
}

.btn-success {
    background: #51cf66;
    color: #fff;
}

.btn-success:hover:not(:disabled) {
    background: #41bf56;
}

.btn-danger {
    background: #ff6b6b;
    color: #fff;
}

.btn-danger:hover:not(:disabled) {
    background: #ff5b5b;
}

.btn-info {
    background: #5c7cfa;
    color: #fff;
}

.btn-info:hover:not(:disabled) {
    background: #4c6cfa;
}

.form-group {
    margin-bottom: 15px;
}

.form-group label {
    display: block;
    margin-bottom: 5px;
    color: #8e8ea0;
    font-size: 14px;
}

.form-group input,
.form-group textarea,
.form-group select {
    width: 100%;
    padding: 10px;
    background: #0f0f1e;
    border: 1px solid #333;
    border-radius: 5px;
    color: #fff;
    font-size: 14px;
}

.import-validation {
    margin-top: 15px;
    padding: 10px;
    border-radius: 5px;
}

.import-validation.success {
    background: rgba(81, 207, 102, 0.1);
    border: 1px solid #51cf66;
    color: #51cf66;
}

.import-validation.error {
    background: rgba(255, 107, 107, 0.1);
    border: 1px solid #ff6b6b;
    color: #ff6b6b;
}

.template-item {
    background: #0f0f1e;
    border: 1px solid #333;
    border-radius: 8px;
    padding: 15px;
    margin-bottom: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.template-info h4 {
    margin: 0 0 5px 0;
    color: #4a9eff;
}

.template-info p {
    margin: 0;
    color: #8e8ea0;
    font-size: 12px;
}

.toast {
    position: fixed;
    top: 20px;
    right: 20px;
    padding: 15px 20px;
    background: #1a1a2e;
    border: 1px solid #333;
    border-radius: 8px;
    color: #fff;
    z-index: 2000;
    animation: slideIn 0.3s ease-out;
}

.toast.success { border-left: 4px solid #51cf66; }
.toast.error { border-left: 4px solid #ff6b6b; }
.toast.warning { border-left: 4px solid #ffa94d; }
.toast.info { border-left: 4px solid #5c7cfa; }

@keyframes slideIn {
    from {
        transform: translateX(400px);
        opacity: 0;
    }
    to {
        transform: translateX(0);
        opacity: 1;
    }
}
</style>
{% endblock %}

{% block scripts %}
<script src="/js/admin/config.js"></script>
{% endblock %}
