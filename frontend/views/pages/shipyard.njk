{% extends "layouts/game.njk" %}

{% set title = "Universus - Shipyard" %}
{% set currentPage = "shipyard" %}
{% set bodyClass = "game-body" %}

{% block content %}
<h2>Shipyard</h2>

<div class="shipyard-tabs btn-group">
    <button class="btn btn-secondary active" data-tab="ships">Ships</button>
    <button class="btn btn-secondary" data-tab="defense">Defense</button>
</div>

<div class="shipyard-location card-enhanced">
    <label for="shipyardLocationSelect">Production Location</label>
    <select id="shipyardLocationSelect" class="location-select" aria-label="Production location">
        <option value="planet">Planet Shipyard</option>
    </select>
    <div id="shipyardLocationResources" class="moon-resource-summary hidden"></div>
    <p id="shipyardLocationStatus" class="location-status">Select a location for ship construction.</p>
</div>

<!-- Ships Tab -->
<div id="shipsTab" class="tab-content active">
    <div id="shipProductionQueue" class="production-queue card-enhanced" style="display:none;">
        <h3>Ship Production Queue</h3>
        <div id="shipQueue" class="progress">
            <div class="progress-bar"></div>
        </div>
    </div>

    <div id="shipsGrid" class="shipyard-grid">
        <div class="loading card-compact">
            <div class="spinner"></div>
            <p>Loading shipyard...</p>
        </div>
    </div>
</div>

<!-- Defense Tab -->
<div id="defenseTab" class="tab-content">
    <div id="defenseGrid" class="shipyard-grid">
        <div class="loading card-compact">
            <div class="spinner"></div>
            <p>Loading defense systems...</p>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
{{ super() }}
<script src="/js/shipyard.js"></script>
{% endblock %}
