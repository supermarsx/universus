{% extends "layouts/game.njk" %}

{% set title = "Universus - Galaxy View" %}
{% set currentPage = "galaxy" %}
{% set bodyClass = "game-body" %}

{% block content %}
<h2>Galaxy Command</h2>

<section class="galaxy-toolbar card">
    <div class="coords-input">
        <label for="galaxyInput">Galaxy</label>
        <input type="number" id="galaxyInput" value="{{ currentGalaxy or '1' }}" min="1" max="9">

        <label for="systemInput">System</label>
        <input type="number" id="systemInput" value="{{ currentSystem or '1' }}" min="1" max="499">

        <button id="scanBtn" class="btn-primary">
            <span class="icon icon-scan"></span>
            Scan
        </button>
    </div>

    <div class="nav-controls">
        <button class="btn-secondary" id="prevGalaxy">« Galaxy</button>
        <button class="btn-secondary" id="prevSystem">‹ System</button>
        <div class="nav-summary">
            <span id="galaxySystemSummary">Galaxy 1 • System 1</span>
        </div>
        <button class="btn-secondary" id="nextSystem">System ›</button>
        <button class="btn-secondary" id="nextGalaxy">Galaxy »</button>
    </div>

    <div class="jump-controls">
        <label for="coordinateJump">Jump to</label>
        <input type="text" id="coordinateJump" placeholder="g:s:p">
        <button class="btn-secondary" id="jumpBtn">Go</button>
    </div>
</section>

<section class="origin-panel card" id="originPanel">
    <div class="origin-column">
        <label for="originPlanetSelect" class="label">Origin Planet</label>
        <select id="originPlanetSelect">
            <option value="">Connect a planet to unlock fleet actions</option>
        </select>
        <div id="originSummary" class="origin-summary text-muted">
            Select one of your planets to enable inline targeting.
        </div>
    </div>
    <div class="origin-column">
        <p class="label">Ready Ships</p>
        <div id="originShipSummary" class="ship-summary">
            <span class="text-muted">No hangar data yet.</span>
        </div>
    </div>
    <div class="origin-column inline-target">
        <label for="inlineTargetCoords" class="label">Inline Target</label>
        <div class="inline-target-controls">
            <input type="text" id="inlineTargetCoords" placeholder="g:s:p">
            <select id="inlineMissionSelect">
                <option value="attack">Attack</option>
                <option value="transport">Transport</option>
                <option value="deploy">Deploy</option>
                <option value="espionage">Espionage</option>
                <option value="colonize">Colonize</option>
                <option value="harvest">Harvest</option>
            </select>
            <button class="btn-secondary" id="inlineTargetBtn">Lock</button>
        </div>
        <small class="text-muted">Jump directly to coordinates and open the mission drawer without leaving this view.</small>
    </div>
</section>

<section class="galaxy-intel card" id="galaxyIntelBar">
    <div>
        <p class="label">Sensor Coverage</p>
        <p id="sensorSummary">Awaiting readings…</p>
        <p class="intel-subtext" id="originPlanetLabel">Origin: —</p>
    </div>
    <div>
        <p class="label">Navigation</p>
        <p id="paginationSummary">—</p>
    </div>
    <div>
        <p class="label">Activity Legend</p>
        <p>
            <span class="activity-pill activity-active">Active</span>
            <span class="activity-pill activity-recent">Recent</span>
            <span class="activity-pill activity-idle">Idle</span>
            <span class="activity-pill activity-inactive">Inactive</span>
        </p>
    </div>
</section>

<section class="galaxy-canvas card">
    <canvas id="galaxyCanvas" aria-label="Galaxy schematic"></canvas>
</section>

<section class="galaxy-view card" id="galaxyView">
    <div class="galaxy-header">
        <span class="col-position">Pos</span>
        <span class="col-planet">Orbit</span>
        <span class="col-player">Intel</span>
        <span class="col-alliance">Alliance / Activity</span>
        <span class="col-debris">Debris</span>
        <span class="col-actions">Actions</span>
    </div>
    <div id="galaxySystemDisplay" class="galaxy-system">
        <div class="loading">
            <div class="spinner"></div>
            <p>Scanning system…</p>
        </div>
    </div>
</section>

<section class="mission-drawer hidden" id="missionDrawer" aria-hidden="true">
    <div class="drawer-header">
        <h3 id="missionDrawerTitle">Send Fleet</h3>
        <button class="btn-icon" id="closeMissionDrawer" aria-label="Close mission drawer">×</button>
    </div>
    <div class="drawer-body">
        <p id="missionTargetSummary" class="target-summary"></p>
        <form id="missionForm">
            <div class="form-row">
                <label for="missionTypeSelect">Mission</label>
                <select id="missionTypeSelect" name="missionType">
                    <option value="attack">Attack</option>
                    <option value="transport">Transport</option>
                    <option value="deploy">Deploy</option>
                    <option value="espionage">Espionage</option>
                    <option value="colonize">Colonize</option>
                    <option value="harvest">Harvest</option>
                </select>
            </div>
            <div id="shipInputs"></div>
            <div class="drawer-actions">
                <button type="button" class="btn-secondary" id="drawerCancel">Cancel</button>
                <button type="submit" class="btn-primary" id="drawerLaunch">Launch Fleet</button>
            </div>
            <p id="missionDrawerError" class="error-text hidden"></p>
        </form>
    </div>
</section>

<div id="galaxyToast" class="toast"></div>

<div id="planetDetailsModal" class="modal" style="display: none;">
    <div class="modal-content">
        <span class="close">&times;</span>
        <h3>Planet Details</h3>
        <div id="planetDetailsContent"></div>
    </div>
</div>
{% endblock %}

{% block scripts %}
{{ super() }}
<script src="/js/galaxy.js"></script>
<script src="/js/planetImageGenerator.js"></script>
{% endblock %}
