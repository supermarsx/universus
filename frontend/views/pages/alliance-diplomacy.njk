{% extends "layouts/game.njk" %}

{% set title = "Universus - Alliance Diplomacy" %}
{% set currentPage = "alliance" %}
{% set bodyClass = "game-body" %}

{% block stylesheets %}
{{ super() }}
<link rel="stylesheet" href="/css/alliance-diplomacy.css">
{% endblock %}

{% block content %}
<div class="alliance-diplomacy-container">
    <!-- Page Header -->
    <div class="diplomacy-header card-enhanced">
        <div class="header-content">
            <h1 class="page-title">
                <span class="css-icon icon-handshake"></span>
                Diplomatic Relations
            </h1>
            <p class="page-description">
                Manage treaties, alliances, and diplomatic standings with other alliances across the universe.
            </p>
        </div>
        {% if canProposeTreaty %}
        <div class="header-actions">
            <button class="btn btn-primary" onclick="showProposeTreatyModal()">
                <span class="css-icon icon-add"></span> Propose Treaty
            </button>
        </div>
        {% endif %}
    </div>

    <!-- Diplomatic Relations Overview -->
    <div class="diplomacy-section card-enhanced">
        <div class="section-header">
            <h2 class="section-title">
                <span class="css-icon icon-globe"></span>
                Current Relations
            </h2>
            <div class="section-filters">
                <select id="relationTypeFilter" class="filter-select" onchange="filterRelations()">
                    <option value="">All Types</option>
                    <option value="ALLIED">Allied</option>
                    <option value="NAP">Non-Aggression Pact</option>
                    <option value="TRADE">Trade Agreement</option>
                    <option value="DEFENSE">Defense Pact</option>
                    <option value="WAR">At War</option>
                    <option value="HOSTILE">Hostile</option>
                    <option value="NEUTRAL">Neutral</option>
                </select>
                <button class="btn-refresh" onclick="refreshRelations()" title="Refresh">
                    <span class="css-icon icon-refresh"></span>
                </button>
            </div>
        </div>

        <div class="relations-grid" id="relationsGrid">
            {% if relations and relations.length > 0 %}
                {% for relation in relations %}
                <div class="relation-card relation-type-{{ relation.type|lower }}" data-relation-id="{{ relation.id }}">
                    <div class="relation-header">
                        <div class="relation-alliance">
                            <div class="alliance-tag">{{ relation.target_alliance_tag }}</div>
                            <div class="alliance-name">{{ relation.target_alliance_name }}</div>
                        </div>
                        <span class="relation-type-badge {{ relation.type|lower }}">{{ relation.type }}</span>
                    </div>
                    
                    <div class="relation-info">
                        <div class="info-row">
                            <span class="info-label">Established:</span>
                            <span class="info-value">{{ relation.established_at|date }}</span>
                        </div>
                        {% if relation.expires_at %}
                        <div class="info-row">
                            <span class="info-label">Expires:</span>
                            <span class="info-value">{{ relation.expires_at|date }}</span>
                        </div>
                        {% endif %}
                        <div class="info-row">
                            <span class="info-label">Proposed by:</span>
                            <span class="info-value">{{ relation.proposed_by_name }}</span>
                        </div>
                    </div>

                    {% if relation.terms %}
                    <div class="relation-terms">
                        <div class="terms-label">Treaty Terms:</div>
                        <p class="terms-text">{{ relation.terms }}</p>
                    </div>
                    {% endif %}

                    <div class="relation-actions">
                        <button class="btn btn-sm btn-secondary" onclick="viewRelationDetails({{ relation.id }})">
                            <span class="css-icon icon-view"></span> View Details
                        </button>
                        {% if canManageDiplomacy %}
                        <button class="btn btn-sm btn-danger" onclick="showBreakTreatyConfirm({{ relation.id }})">
                            Break Treaty
                        </button>
                        {% endif %}
                    </div>
                </div>
                {% endfor %}
            {% else %}
                <div class="empty-state">
                    <span class="css-icon icon-handshake"></span>
                    <p>No diplomatic relations established yet</p>
                </div>
            {% endif %}
        </div>
    </div>

    <!-- Pending Proposals -->
    <div class="diplomacy-section card-enhanced">
        <div class="section-header">
            <h2 class="section-title">
                <span class="css-icon icon-clock"></span>
                Pending Proposals
            </h2>
        </div>

        <div class="proposals-list" id="proposalsList">
            {% if pendingProposals and pendingProposals.length > 0 %}
                {% for proposal in pendingProposals %}
                <div class="proposal-card" data-proposal-id="{{ proposal.id }}">
                    <div class="proposal-header">
                        <div class="proposal-type">
                            <span class="relation-type-badge {{ proposal.type|lower }}">{{ proposal.type }}</span>
                        </div>
                        <div class="proposal-direction">
                            {% if proposal.is_incoming %}
                            <span class="direction-badge incoming">Incoming</span>
                            {% else %}
                            <span class="direction-badge outgoing">Outgoing</span>
                            {% endif %}
                        </div>
                    </div>

                    <div class="proposal-content">
                        <div class="proposal-alliance">
                            <strong>{{ proposal.is_incoming ? 'From' : 'To' }}:</strong>
                            <span class="alliance-tag">{{ proposal.target_alliance_tag }}</span>
                            {{ proposal.target_alliance_name }}
                        </div>
                        
                        <div class="proposal-info">
                            <div class="info-item">
                                <span class="info-label">Proposed:</span>
                                <span class="info-value">{{ proposal.proposed_at|timeago }}</span>
                            </div>
                            {% if proposal.duration_days %}
                            <div class="info-item">
                                <span class="info-label">Duration:</span>
                                <span class="info-value">{{ proposal.duration_days }} days</span>
                            </div>
                            {% endif %}
                        </div>

                        {% if proposal.terms %}
                        <div class="proposal-terms">
                            <div class="terms-label">Proposed Terms:</div>
                            <p class="terms-text">{{ proposal.terms }}</p>
                        </div>
                        {% endif %}
                    </div>

                    <div class="proposal-actions">
                        {% if proposal.is_incoming and canRespondToProposals %}
                        <button class="btn btn-sm btn-success" onclick="acceptProposal({{ proposal.id }})">
                            <span class="css-icon icon-check"></span> Accept
                        </button>
                        <button class="btn btn-sm btn-danger" onclick="rejectProposal({{ proposal.id }})">
                            <span class="css-icon icon-close"></span> Reject
                        </button>
                        {% elif not proposal.is_incoming %}
                        <button class="btn btn-sm btn-secondary" onclick="cancelProposal({{ proposal.id }})">
                            Cancel Proposal
                        </button>
                        {% endif %}
                    </div>
                </div>
                {% endfor %}
            {% else %}
                <div class="empty-state-small">
                    <p>No pending proposals</p>
                </div>
            {% endif %}
        </div>
    </div>

    <!-- Diplomatic History -->
    <div class="diplomacy-section card-enhanced">
        <div class="section-header">
            <h2 class="section-title">
                <span class="css-icon icon-history"></span>
                Diplomatic History
            </h2>
        </div>

        <div class="history-timeline" id="historyTimeline">
            {% if history and history.length > 0 %}
                {% for event in history %}
                <div class="history-event event-type-{{ event.event_type|lower }}">
                    <div class="event-marker"></div>
                    <div class="event-content">
                        <div class="event-time">{{ event.created_at|timeago }}</div>
                        <div class="event-message">
                            {{ event.message | safe }}
                        </div>
                        {% if event.details %}
                        <div class="event-details">{{ event.details }}</div>
                        {% endif %}
                    </div>
                </div>
                {% endfor %}
            {% else %}
                <div class="empty-state-small">
                    <p>No diplomatic history to display</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<!-- Propose Treaty Modal -->
<div id="proposeTreatyModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Propose Diplomatic Treaty</h2>
            <button class="modal-close" onclick="closeModal('proposeTreatyModal')">&times;</button>
        </div>
        <form id="proposeTreatyForm" onsubmit="handleProposeTreaty(event)">
            <div class="form-group">
                <label for="targetAllianceInput">Target Alliance *</label>
                <input type="text" id="targetAllianceInput" name="targetAlliance" required
                       placeholder="Enter alliance tag or name">
                <small>Search by alliance tag or full name</small>
            </div>

            <div class="form-group">
                <label for="relationTypeInput">Relation Type *</label>
                <select id="relationTypeInput" name="relationType" required onchange="updateRelationDescription()">
                    <option value="">Select relation type...</option>
                    <option value="ALLIED">Allied - Full alliance with shared defense</option>
                    <option value="NAP">Non-Aggression Pact - No attacks allowed</option>
                    <option value="TRADE">Trade Agreement - Resource trading benefits</option>
                    <option value="DEFENSE">Defense Pact - Mutual defense obligations</option>
                </select>
                <small id="relationDescription" class="relation-description"></small>
            </div>

            <div class="form-group">
                <label for="durationInput">Duration (optional)</label>
                <input type="number" id="durationInput" name="duration" min="1" max="365"
                       placeholder="Days (leave empty for indefinite)">
                <small>Leave empty for indefinite duration</small>
            </div>

            <div class="form-group">
                <label for="termsInput">Treaty Terms *</label>
                <textarea id="termsInput" name="terms" required rows="6" maxlength="2000"
                          placeholder="Describe the terms and conditions of this diplomatic agreement..."></textarea>
                <small>Be specific about obligations, benefits, and any special conditions</small>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" onclick="closeModal('proposeTreatyModal')">Cancel</button>
                <button type="submit" class="btn btn-primary">Propose Treaty</button>
            </div>
        </form>
    </div>
</div>

<!-- Relation Details Modal -->
<div id="relationDetailsModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Diplomatic Relation Details</h2>
            <button class="modal-close" onclick="closeModal('relationDetailsModal')">&times;</button>
        </div>
        <div class="modal-body" id="relationDetailsContent">
            <!-- Populated dynamically -->
        </div>
    </div>
</div>

<!-- Break Treaty Confirmation Modal -->
<div id="breakTreatyModal" class="modal">
    <div class="modal-content modal-small">
        <div class="modal-header">
            <h2>Break Diplomatic Treaty</h2>
            <button class="modal-close" onclick="closeModal('breakTreatyModal')">&times;</button>
        </div>
        <div class="modal-body">
            <p class="warning-text">
                Are you sure you want to break this diplomatic treaty? This action cannot be undone and may damage your alliance's reputation.
            </p>
            <div class="form-group">
                <label for="breakReasonInput">Reason (optional)</label>
                <textarea id="breakReasonInput" rows="3" maxlength="500"
                          placeholder="Provide a reason for breaking this treaty..."></textarea>
            </div>
        </div>
        <div class="modal-actions">
            <button type="button" class="btn btn-secondary" onclick="closeModal('breakTreatyModal')">Cancel</button>
            <button type="button" class="btn btn-danger" onclick="confirmBreakTreaty()">Break Treaty</button>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
{{ super() }}
<script src="/js/alliance-diplomacy.js"></script>
{% endblock %}
