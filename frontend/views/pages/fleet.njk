{% extends "layouts/game.njk" %}

{% set title = "Universus - Fleet Management" %}
{% set currentPage = "fleet" %}
{% set bodyClass = "game-body" %}

{% block content %}
<h2>Fleet Management</h2>

<div class="fleet-tabs">
    <button class="tab-button active" data-tab="dispatch">Dispatch Fleet</button>
    <button class="tab-button" data-tab="overview">Fleet Overview</button>
    <button class="tab-button" data-tab="missions">Active Missions</button>
</div>

<!-- Dispatch Fleet Tab -->
<div id="dispatchTab" class="tab-content active">
    <div class="fleet-dispatch-container">
        <div class="fleet-step" id="step1">
            <h3>Step 1: Select Fleet</h3>
            <p>Select ships stationed on this planet to include in the fleet.</p>
            <div id="fleetSelection" class="fleet-selection-grid"></div>
            <div class="fleet-step-actions">
                <button class="btn-primary" id="nextToStep2">Next: Select Target</button>
            </div>
        </div>

        <div class="fleet-step hidden" id="step2">
            <h3>Step 2: Select Target</h3>
            <div class="target-inputs">
                <input type="number" id="targetGalaxy" placeholder="Galaxy" min="1" max="9">
                <input type="number" id="targetSystem" placeholder="System" min="1" max="499">
                <input type="number" id="targetPosition" placeholder="Position" min="1" max="15">
            </div>
            <div class="fleet-step-actions">
                <button class="btn-secondary" id="backToStep1">Back</button>
                <button class="btn-primary" id="nextToStep3">Next: Select Mission</button>
            </div>
        </div>

        <div class="fleet-step hidden" id="step3">
            <h3>Step 3: Select Mission</h3>
            <div id="missionSelection" class="mission-buttons">
                <button class="mission-button" data-mission="attack">Attack</button>
                <button class="mission-button" data-mission="transport">Transport</button>
                <button class="mission-button" data-mission="deploy">Deploy</button>
                <button class="mission-button" data-mission="espionage">Espionage</button>
                <button class="mission-button" data-mission="colonize">Colonize</button>
            </div>

            <div id="cargoInputs" class="cargo-inputs">
                <label>Metal
                    <input type="number" id="cargoMetal" value="0" min="0">
                </label>
                <label>Crystal
                    <input type="number" id="cargoCrystal" value="0" min="0">
                </label>
                <label>Deuterium
                    <input type="number" id="cargoDeuterium" value="0" min="0">
                </label>
            </div>

            <div class="fleet-summary">
                <p><strong>Selected Ships:</strong> <span id="selectedShipsSummary">No ships selected.</span></p>
                <div class="summary-metrics">
                    <span>Available Cargo: <strong id="availableCargo">0</strong></span>
                    <span>Fuel Estimate: <strong id="fuelEstimate">0</strong></span>
                </div>
            </div>

            <div id="acsPanel" class="acs-panel card-compact">
                <div class="acs-panel-header">
                    <div>
                        <h4>Alliance Coordinated Strikes</h4>
                        <p>Link this fleet to an ACS group to synchronize attacks with your alliance.</p>
                    </div>
                    <div class="acs-panel-actions">
                        <button class="btn btn-text" id="refreshAcsGroups">Refresh</button>
                        <button class="btn btn-primary" id="openAcsModal">New Group</button>
                    </div>
                </div>
                <div id="acsGroupList" class="acs-group-list">
                    <div class="empty-state card-compact">
                        No ACS groups yet. Create one to begin coordinating.
                    </div>
                </div>
                <div id="selectedAcsBadge" class="acs-selected hidden">
                    Linked to <span id="selectedAcsLabel"></span>
                    <button class="btn-text" id="leaveAcsSelection">Leave Group</button>
                </div>
            </div>

            <div class="fleet-step-actions">
                <button class="btn-secondary" id="backToStep2">Back</button>
                <button class="btn-secondary" id="resetFleet">Reset</button>
                <button class="btn-primary" id="launchFleet">Launch Fleet</button>
            </div>
        </div>
    </div>
</div>

<!-- Fleet Overview Tab -->
<div id="overviewTab" class="tab-content">
    <div id="fleetInventory" class="fleet-inventory card-enhanced"></div>
</div>

<!-- Active Missions Tab -->
<div id="missionsTab" class="tab-content">
    <div class="mission-controls card-compact">
        <label>
            Mission Type
            <select id="missionFilterType">
                <option value="all">All</option>
                <option value="attack">Attack</option>
                <option value="transport">Transport</option>
                <option value="deploy">Deploy</option>
                <option value="espionage">Espionage</option>
                <option value="colonize">Colonize</option>
            </select>
        </label>
        <label>
            Status
            <select id="missionFilterStatus">
                <option value="all">All</option>
                <option value="outbound">Outbound</option>
                <option value="returning">Returning</option>
            </select>
        </label>
        <div class="mission-actions-inline">
            <button class="btn btn-text" id="refreshMissionLog">Refresh Log</button>
            <button class="btn btn-text" id="clearMissionLog">Clear Log</button>
        </div>
    </div>

    <div id="activeMissions" class="missions-list"></div>

    <div class="combat-section card-enhanced">
        <h3>Recent Combat Reports</h3>
        <div id="combatReports" class="combat-reports"></div>
    </div>

    <div class="mission-log card-enhanced">
        <h3>Mission Activity Log</h3>
        <div id="missionLogEntries" class="mission-log-entries"></div>
    </div>
</div>

<!-- ACS Modal -->
<div id="acsModal" class="modal" style="display:none;">
    <div class="modal-content">
        <span class="close" id="closeAcsModal">&times;</span>
        <h3>Create ACS Group</h3>
        <form id="acsForm">
            <label>Mission Type
                <select id="acsMissionType">
                    <option value="attack">Attack</option>
                    <option value="transport">Transport</option>
                    <option value="deploy">Deploy</option>
                </select>
            </label>
            <div class="target-inputs">
                <input type="number" id="acsTargetGalaxy" placeholder="Galaxy" min="1" max="9">
                <input type="number" id="acsTargetSystem" placeholder="System" min="1" max="499">
                <input type="number" id="acsTargetPosition" placeholder="Position" min="1" max="15">
            </div>
            <label>Departure Window Start
                <input type="datetime-local" id="acsWindowStart">
            </label>
            <label>Departure Window End
                <input type="datetime-local" id="acsWindowEnd">
            </label>
            <label>Notes
                <textarea id="acsNotes" rows="3" placeholder="Optional instructions for your allies"></textarea>
            </label>
            <div class="modal-actions">
                <button type="button" class="btn-secondary" id="cancelAcsModal">Cancel</button>
                <button type="submit" class="btn-primary">Create Group</button>
            </div>
        </form>
    </div>
</div>

<!-- Combat Replay Modal -->
<div id="combatReplayModal" class="modal" style="display:none;">
    <div class="modal-content combat-replay-modal">
        <span class="close" id="closeCombatReplay">&times;</span>
        <h3>Battle Replay</h3>
        <canvas id="combatReplayCanvas" width="700" height="320"></canvas>
        <div id="combatReplaySummary" class="combat-replay-summary"></div>
    </div>
</div>
{% endblock %}

{% block scripts %}
{{ super() }}
<script src="/js/combatVisualizer.js"></script>
<script src="/js/fleet.js"></script>
{% endblock %}
