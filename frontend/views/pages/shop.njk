{% extends "layouts/game.njk" %}

{% set title = "Universus - Premium Shop" %}
{% set currentPage = "shop" %}
{% set bodyClass = "game-body" %}

{% block content %}
<h2>Premium Shop</h2>

<div class="shop-layout">
    <!-- Shop Categories -->
    <div class="shop-sidebar">
        <nav class="shop-nav">
            <a href="#" class="shop-nav-item active" data-category="all">{{ 'all_items' | t }}</a>
            <a href="#" class="shop-nav-item" data-category="resources">{{ 'resources' | t }}</a>
            <a href="#" class="shop-nav-item" data-category="officers">{{ 'officers' | t }}</a>
            <a href="#" class="shop-nav-item" data-category="boosts">{{ 'boosts' | t }}</a>
            <a href="#" class="shop-nav-item" data-category="premium">{{ 'premium' | t }}</a>
        </nav>

        <!-- Active Perks -->
        <div class="active-perks">
            <h4>Active Perks</h4>
            <div id="activePerks">
                <p class="text-muted">{{ 'no_active_perks' | t }}</p>
            </div>
        </div>
    </div>

    <!-- Shop Items -->
    <div class="shop-content">
        <div class="user-dm-display">
            <span>Dark Matter:</span>
            <strong id="userDM">0</strong>
        </div>

        <div id="shopGrid" class="shop-grid" aria-live="polite">
        <div class="loading">
            <div class="spinner"></div>
            <p>{{ 'loading' | t }}</p>
        </div>
        </div>
    </div>
</div>

<!-- Purchase Modal -->
<div id="purchaseModal" class="modal" role="dialog" aria-modal="true" aria-labelledby="purchaseModalTitle" tabindex="-1" style="display: none;">
    <div class="modal-content">
        <button class="close" aria-label="Close dialog"><span class="sr-only">Close</span>&times;</button>
        <h3 id="purchaseModalTitle">{{ 'purchase_item' | t }}</h3>
        <div id="purchaseDetails"></div>
    </div>
</div>

<!-- Payment Modal -->
<div id="paymentModal" class="modal" role="dialog" aria-modal="true" aria-labelledby="paymentModalTitle" tabindex="-1" style="display: none;">
    <div class="modal-content">
        <button class="close" aria-label="Close dialog"><span class="sr-only">Close</span>&times;</button>
        <h3 id="paymentModalTitle">{{ 'purchase_dark_matter' | t }}</h3>
        <div id="paymentForm"></div>
    </div>
</div>
{% endblock %}

{% block scripts %}
{{ super() }}
<script src="https://js.stripe.com/v3/"></script>
<script src="/js/shop.js"></script>
{% endblock %}
