{% extends "layouts/game.njk" %}

{% set title = ('shop.title' | t) %}
{% set currentPage = "shop" %}
{% set bodyClass = "game-body" %}

{% block content %}
<h2>{{ 'shop.heading' | t }}</h2>

<div class="shop-layout">
    <!-- Shop Categories -->
    <div class="shop-sidebar">
        <nav class="shop-nav">
            <a href="#" class="shop-nav-item active" data-category="all">{{ 'shop.all_items' | t }}</a>
            <a href="#" class="shop-nav-item" data-category="resources">{{ 'game.resources' | t }}</a>
            <a href="#" class="shop-nav-item" data-category="officers">{{ 'user.officers' | t }}</a>
            <a href="#" class="shop-nav-item" data-category="boosts">{{ 'ui.boosts' | t }}</a>
            <a href="#" class="shop-nav-item" data-category="premium">{{ 'ui.premium' | t }}</a>
        </nav>

        <!-- Active Perks -->
        <div class="active-perks">
            <h4>{{ 'shop.active_perks' | t }}</h4>
            <div id="activePerks">
                <p class="text-muted">{{ 'ui.no_active_perks' | t }}</p>
            </div>
        </div>
    </div>

    <!-- Shop Items -->
    <div class="shop-content">
        <div class="ad-slot ad-slot-inline" data-ad-unit="shop_top_banner" aria-label="{{ 'shop.advertisement' | t }}"></div>

        <div class="user-dm-display">
            <span>{{ 'shop.dark_matter' | t }}</span>
            <strong id="userDM">0</strong>
        </div>

        <div id="shopGrid" class="shop-grid" aria-live="polite">
        <div class="loading">
            <div class="spinner"></div>
            <p>{{ 'ui.loading' | t }}</p>
        </div>
        </div>
    </div>
</div>

<!-- Purchase Modal -->
<div id="purchaseModal" class="modal" role="dialog" aria-modal="true" aria-labelledby="purchaseModalTitle" tabindex="-1" style="display: none;">
    <div class="modal-content">
        <button class="close" aria-label="Close dialog"><span class="sr-only">{{ 'ui.close' | t }}</span>&times;</button>
        <h3 id="purchaseModalTitle">{{ 'shop.purchase_item' | t }}</h3>
        <div id="purchaseDetails"></div>
    </div>
</div>

<!-- Payment Modal -->
<div id="paymentModal" class="modal" role="dialog" aria-modal="true" aria-labelledby="paymentModalTitle" tabindex="-1" style="display: none;">
    <div class="modal-content">
        <button class="close" aria-label="Close dialog"><span class="sr-only">{{ 'ui.close' | t }}</span>&times;</button>
        <h3 id="paymentModalTitle">{{ 'shop.purchase_dark_matter' | t }}</h3>
        <div id="paymentForm"></div>
    </div>
</div>
{% endblock %}

{% block scripts %}
{{ super() }}
<script src="https://js.stripe.com/v3/"></script>
<script src="/js/shop.js"></script>
{% endblock %}
