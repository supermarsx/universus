{% extends "layouts/game.njk" %}

{% block title %}Chat - Universus{% endblock %}

{% block content %}
<div class="game-container">
  <div class="chat-layout">
    <!-- Left Sidebar: Channels & Conversations -->
    <div class="chat-sidebar">
      <div class="sidebar-section">
        <h3>Chat Channels</h3>
        <div id="channel-list" class="channel-list">
          <!-- Channels loaded via JavaScript -->
        </div>
      </div>
      
      <div class="sidebar-section">
        <h3>Private Messages</h3>
        <div id="conversation-list" class="conversation-list">
          <!-- Conversations loaded via JavaScript -->
        </div>
      </div>
      
      <div class="sidebar-section">
        <h3>Online Players</h3>
        <div id="online-players" class="online-players-list">
          <div class="online-count">Loading...</div>
        </div>
      </div>
    </div>

    <!-- Main Chat Area -->
    <div class="chat-main">
      <div class="chat-header">
        <h2 id="chat-title">Select a channel</h2>
        <div class="chat-actions">
          <button id="chat-settings-btn" class="btn btn-icon">
            <i class="icon-settings"></i>
          </button>
        </div>
      </div>

      <div id="chat-messages" class="chat-messages">
        <!-- Messages appear here -->
        <div class="chat-welcome">
          <p>Welcome to Universus Chat!</p>
          <p>Select a channel from the sidebar to start chatting.</p>
          <p style="margin-top: 8px; color: #bbb;">Tip: type <code>/help</code> to see chat commands.</p>
        </div>
      </div>

      <div class="chat-input-area">
        <input 
          type="text" 
          id="chat-input" 
          class="chat-input" 
          placeholder="Type your message..." 
          maxlength="500"
          disabled
        />
        <button id="send-btn" class="btn btn-primary" disabled>
          Send
        </button>
      </div>
    </div>

    <!-- Right Sidebar: Info Panel -->
    <div class="chat-info-panel">
      <div class="info-section">
        <h3>Channel Info</h3>
        <div id="channel-info">
          <p class="text-muted">Select a channel to view info</p>
        </div>
      </div>

      <div class="info-section">
        <h3>Quick Actions</h3>
        <button class="btn btn-block" onclick="openTradePanel()">
          <i class="icon-trade"></i> View Trades
        </button>
        <button class="btn btn-block" onclick="openFleetPanel()">
          <i class="icon-fleet"></i> My Fleets
        </button>
        <button class="btn btn-block" onclick="openNotifications()">
          <i class="icon-bell"></i> Notifications
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Private Message Modal -->
<div id="pm-modal" class="modal">
  <div class="modal-content">
    <div class="modal-header">
      <h3>Send Private Message</h3>
      <button class="modal-close" onclick="closePMModal()">&times;</button>
    </div>
    <div class="modal-body">
      <label>To:</label>
      <input type="text" id="pm-recipient" placeholder="Enter username">
      
      <label>Message:</label>
      <textarea id="pm-message" rows="5" maxlength="500"></textarea>
    </div>
    <div class="modal-footer">
      <button class="btn btn-secondary" onclick="closePMModal()">Cancel</button>
      <button class="btn btn-primary" onclick="sendPrivateMessage()">Send</button>
    </div>
  </div>
</div>

<style>
.chat-layout {
  display: grid;
  grid-template-columns: 250px 1fr 200px;
  gap: 20px;
  height: calc(100vh - 120px);
}

.chat-sidebar {
  background: rgba(0, 0, 0, 0.3);
  border-radius: 8px;
  padding: 15px;
  overflow-y: auto;
}

.sidebar-section {
  margin-bottom: 20px;
}

.sidebar-section h3 {
  font-size: 14px;
  color: var(--primary-color);
  margin-bottom: 10px;
  text-transform: uppercase;
}

.channel-list, .conversation-list {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.channel-item, .conversation-item {
  padding: 10px;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 5px;
  cursor: pointer;
  transition: all 0.2s;
}

.channel-item:hover, .conversation-item:hover {
  background: rgba(255, 255, 255, 0.1);
}

.channel-item.active, .conversation-item.active {
  background: var(--primary-color);
  color: white;
}

.channel-item .channel-name {
  font-weight: bold;
  font-size: 13px;
}

.conversation-item .username {
  font-weight: bold;
  font-size: 13px;
}

.conversation-item .last-message {
  font-size: 11px;
  color: #999;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.conversation-item .unread-badge {
  background: var(--danger-color);
  color: white;
  padding: 2px 6px;
  border-radius: 10px;
  font-size: 10px;
  float: right;
}

.online-players-list {
  max-height: 300px;
  overflow-y: auto;
}

.online-count {
  color: var(--success-color);
  font-size: 12px;
  margin-bottom: 10px;
}

.player-item {
  padding: 5px 10px;
  font-size: 12px;
  cursor: pointer;
}

.player-item:hover {
  background: rgba(255, 255, 255, 0.05);
}

.player-status {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  display: inline-block;
  margin-right: 5px;
}

.status-online { background: var(--success-color); }
.status-away { background: var(--warning-color); }
.status-busy { background: var(--danger-color); }

.chat-main {
  background: rgba(0, 0, 0, 0.3);
  border-radius: 8px;
  display: flex;
  flex-direction: column;
}

.chat-header {
  padding: 15px 20px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.chat-header h2 {
  font-size: 18px;
  margin: 0;
}

.chat-messages {
  flex: 1;
  overflow-y: auto;
  padding: 20px;
}

.chat-welcome {
  text-align: center;
  color: #999;
  padding: 50px 20px;
}

.chat-message {
  margin-bottom: 15px;
  padding: 10px;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 5px;
}

.chat-message .message-header {
  display: flex;
  align-items: center;
  margin-bottom: 5px;
}

.chat-message .username {
  font-weight: bold;
  color: var(--primary-color);
  margin-right: 10px;
}

.chat-message .alliance-tag {
  color: var(--secondary-color);
  font-size: 11px;
  margin-right: 10px;
}

.chat-message .timestamp {
  font-size: 11px;
  color: #999;
  margin-left: auto;
}

.chat-message .message-content {
  color: #ddd;
  word-wrap: break-word;
}

.chat-message.own-message {
  background: rgba(52, 152, 219, 0.1);
  border-left: 3px solid var(--primary-color);
}

.chat-message.system-message {
  background: rgba(241, 196, 15, 0.1);
  border-left: 3px solid var(--warning-color);
  font-style: italic;
}

.chat-input-area {
  padding: 15px 20px;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  display: flex;
  gap: 10px;
}

.chat-input {
  flex: 1;
  padding: 10px 15px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 5px;
  color: white;
  font-size: 14px;
}

.chat-input:focus {
  outline: none;
  border-color: var(--primary-color);
}

.chat-input:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.chat-info-panel {
  background: rgba(0, 0, 0, 0.3);
  border-radius: 8px;
  padding: 15px;
}

.info-section {
  margin-bottom: 20px;
}

.info-section h3 {
  font-size: 14px;
  color: var(--primary-color);
  margin-bottom: 10px;
  text-transform: uppercase;
}

.typing-indicator {
  font-size: 12px;
  color: #999;
  font-style: italic;
  padding: 5px 20px;
}

@media (max-width: 1200px) {
  .chat-layout {
    grid-template-columns: 200px 1fr;
  }
  
  .chat-info-panel {
    display: none;
  }
}

@media (max-width: 768px) {
  .chat-layout {
    grid-template-columns: 1fr;
  }
  
  .chat-sidebar {
    display: none;
  }
}
</style>

<script src="/js/chat.js"></script>
{% endblock %}
