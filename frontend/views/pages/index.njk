{% extends "layouts/base.njk" %}

{% set title = "Universus - Build Your Space Empire" %}
{% set bodyClass = "auth-body" %}

{% block body %}
<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h1 class="auth-logo">UNIVERSUS</h1>
            <p class="auth-tagline">Build Your Space Empire Across the Galaxy</p>
        </div>

        <div class="auth-tabs btn-group">
            <button class="btn btn-secondary active" data-tab="login">Login</button>
            <button class="btn btn-secondary" data-tab="register">Register</button>
        </div>

        <!-- Login Form -->
        <form id="loginForm" class="auth-form active">
            <div class="form-group">
                <label for="loginEmail">Email</label>
                <input type="email" id="loginEmail" name="email" required placeholder="your@email.com">
            </div>
            <div class="form-group">
                <label for="loginPassword">Password</label>
                <input type="password" id="loginPassword" name="password" required placeholder="••••••••">
            </div>
            <div class="form-error" id="loginError" style="display: none;"></div>
            <div class="form-info" id="loginInfo" style="display:none;"></div>
            <button type="submit" class="btn btn-primary btn-block">Launch Your Empire</button>
            <button type="button" class="btn btn-secondary btn-block" id="resendVerificationButton" style="display:none;">
                Resend Verification Email
            </button>
        </form>

        <!-- Register Form -->
        <form id="registerForm" class="auth-form">
            <div class="form-group">
                <label for="registerUsername">Commander Name</label>
                <input type="text" id="registerUsername" name="username" required placeholder="Your commander name">
            </div>
            <div class="form-group">
                <label for="registerEmail">Email</label>
                <input type="email" id="registerEmail" name="email" required placeholder="your@email.com">
            </div>
            <div class="form-group">
                <label for="registerPassword">Password</label>
                <input type="password" id="registerPassword" name="password" required placeholder="••••••••">
            </div>
            <div class="form-group">
                <label for="registerConfirmPassword">Confirm Password</label>
                <input type="password" id="registerConfirmPassword" name="confirmPassword" required placeholder="••••••••">
            </div>
            <div class="form-error" id="registerError" style="display: none;"></div>
            <div class="form-info" id="registerInfo" style="display:none;"></div>
            <button type="submit" class="btn btn-primary btn-block">Create Empire</button>
        </form>

        <div class="auth-footer">
            <p class="text-muted">Join thousands of commanders building their space empires</p>
        </div>
    </div>

    <div class="stars-background"></div>
</div>
{% endblock %}

{% block scripts %}
<script src="/js/auth.js"></script>
{% endblock %}
