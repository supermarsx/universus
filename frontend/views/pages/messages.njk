{% extends "layouts/game.njk" %}

{% set title = "Universus - Messages" %}
{% set currentPage = "messages" %}
{% set bodyClass = "game-body" %}

{% block content %}
<h2>Message Center</h2>

<div class="messages-layout">
    <!-- Messages Sidebar -->
    <div class="messages-sidebar">
        <button id="composeBtn" class="btn-primary btn-block">Compose Message</button>
        
        <nav class="messages-nav">
            <a href="#" class="messages-nav-item active" data-folder="inbox">
                Inbox <span id="inboxCount" class="badge">0</span>
            </a>
            <a href="#" class="messages-nav-item" data-folder="sent">Sent</a>
            <a href="#" class="messages-nav-item" data-folder="combat">Combat Reports</a>
            <a href="#" class="messages-nav-item" data-folder="espionage">Espionage Reports</a>
            <a href="#" class="messages-nav-item" data-folder="transport">Transport</a>
            <a href="#" class="messages-nav-item" data-folder="alliance">Alliance</a>
        </nav>
    </div>

    <!-- Messages Content -->
    <div class="messages-content">
        <div class="messages-toolbar">
            <button id="selectAllBtn" class="btn-secondary">Select All</button>
            <button id="deleteSelectedBtn" class="btn-danger">Delete Selected</button>
            <button id="refreshBtn" class="btn-secondary">Refresh</button>
        </div>

        <div id="messagesList" class="messages-list">
            <div class="loading">
                <div class="spinner"></div>
                <p>Loading messages...</p>
            </div>
        </div>

        <div class="pagination">
            <button id="prevPageMsg" class="btn-secondary">Previous</button>
            <span id="pageInfoMsg">Page 1 of 1</span>
            <button id="nextPageMsg" class="btn-secondary">Next</button>
        </div>
    </div>
</div>

<!-- Message Viewer Modal -->
<div id="messageModal" class="modal" style="display: none;">
    <div class="modal-content modal-large">
        <span class="close">&times;</span>
        <div id="messageViewer"></div>
    </div>
</div>

<!-- Compose Message Modal -->
<div id="composeModal" class="modal" style="display: none;">
    <div class="modal-content">
        <span class="close">&times;</span>
        <h3>Compose Message</h3>
        <form id="composeForm">
            <div class="form-group">
                <label for="recipientUsername">To:</label>
                <input type="text" id="recipientUsername" name="recipient" required placeholder="Commander name">
            </div>
            <div class="form-group">
                <label for="messageSubject">Subject:</label>
                <input type="text" id="messageSubject" name="subject" required placeholder="Message subject">
            </div>
            <div class="form-group">
                <label for="messageBody">Message:</label>
                <textarea id="messageBody" name="body" required rows="6" placeholder="Your message..."></textarea>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-primary">Send Message</button>
                <button type="button" class="btn-secondary" id="cancelCompose">Cancel</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block scripts %}
{{ super() }}
<script src="/js/messages.js"></script>
{% endblock %}
