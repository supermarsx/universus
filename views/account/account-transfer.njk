{% extends "base.njk" %}

{% block title %}Account Transfer - Universus{% endblock %}

{% block content %}
<div class="account-management-container">
    <div class="account-header">
        <h1>Account Transfer</h1>
        <p>Transfer account ownership to another email address</p>
    </div>

    <!-- Transfer Warning -->
    <div class="account-card warning-card">
        <div class="card-header">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                <line x1="12" y1="9" x2="12" y2="13"></line>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
            <h3>Important Information</h3>
        </div>
        <div class="card-body">
            <ul class="warning-list">
                <li><strong>Permanent Change:</strong> Account transfer is irreversible once completed</li>
                <li><strong>Email Verification Required:</strong> Both current and new email must be verified</li>
                <li><strong>Security Check:</strong> Your password is required to initiate transfer</li>
                <li><strong>24-Hour Window:</strong> Transfer must be accepted within 24 hours</li>
                <li><strong>Game Access:</strong> Your access will be maintained during the transfer</li>
            </ul>
        </div>
    </div>

    <!-- Initiate Transfer -->
    <div class="account-card" id="initiateTransferCard">
        <div class="card-header">
            <h3>Initiate Account Transfer</h3>
        </div>
        <div class="card-body">
            <form id="initiateTransferForm">
                <div class="form-group">
                    <label for="currentEmail">Current Email Address</label>
                    <input 
                        type="email" 
                        id="currentEmail" 
                        class="form-control" 
                        value="" 
                        disabled
                    >
                </div>

                <div class="form-group">
                    <label for="newOwnerEmail">New Owner's Email Address</label>
                    <input 
                        type="email" 
                        id="newOwnerEmail" 
                        class="form-control" 
                        placeholder="new.owner@example.com"
                        required
                    >
                    <small class="form-text">The new owner must have access to this email to complete the transfer</small>
                </div>

                <div class="form-group">
                    <label for="transferPassword">Your Password</label>
                    <input 
                        type="password" 
                        id="transferPassword" 
                        class="form-control" 
                        placeholder="Enter your password to confirm"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="transferReason">Reason for Transfer (Optional)</label>
                    <textarea 
                        id="transferReason" 
                        class="form-control" 
                        rows="3"
                        placeholder="Provide a brief reason for the transfer..."
                    ></textarea>
                </div>

                <div class="checkbox-group">
                    <label class="checkbox-label">
                        <input type="checkbox" id="confirmTransfer" required>
                        <span>I understand this action is irreversible and have verified the new owner's email address</span>
                    </label>
                </div>

                <button type="submit" class="btn btn-warning">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <polyline points="17 1 21 5 17 9"></polyline>
                        <path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
                        <polyline points="7 23 3 19 7 15"></polyline>
                        <path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
                    </svg>
                    Initiate Account Transfer
                </button>
            </form>
        </div>
    </div>

    <!-- Active Transfers -->
    <div class="account-card" id="activeTransfersCard" style="display: none;">
        <div class="card-header">
            <h3>Active Transfer Requests</h3>
        </div>
        <div class="card-body">
            <div id="transfersList" class="transfers-list"></div>
        </div>
    </div>

    <!-- Incoming Transfers -->
    <div class="account-card" id="incomingTransfersCard" style="display: none;">
        <div class="card-header">
            <h3>Incoming Transfer Requests</h3>
        </div>
        <div class="card-body">
            <p class="info-message">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
                You have pending account transfer requests sent to your email address
            </p>
            <div id="incomingTransfersList" class="transfers-list"></div>
        </div>
    </div>

    <!-- Transfer History -->
    <div class="account-card">
        <div class="card-header">
            <h3>Transfer History</h3>
        </div>
        <div class="card-body">
            <div id="transferHistory" class="history-list">
                <p class="empty-message">No transfer history available</p>
            </div>
        </div>
    </div>

    <!-- Accept Transfer (shown when URL has token) -->
    <div class="account-card success-card" id="acceptTransferCard" style="display: none;">
        <div class="card-header">
            <h3>Accept Account Transfer</h3>
        </div>
        <div class="card-body">
            <div id="transferDetails" class="transfer-details"></div>
            
            <form id="acceptTransferForm">
                <div class="form-group">
                    <label for="acceptPassword">Your Password</label>
                    <input 
                        type="password" 
                        id="acceptPassword" 
                        class="form-control" 
                        placeholder="Enter your password to accept transfer"
                        required
                    >
                    <small class="form-text">Password for the email address receiving the account</small>
                </div>

                <div class="checkbox-group">
                    <label class="checkbox-label">
                        <input type="checkbox" id="confirmAccept" required>
                        <span>I understand I will become the new owner of this account</span>
                    </label>
                </div>

                <div class="action-buttons">
                    <button type="submit" class="btn btn-success">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        Accept Transfer
                    </button>
                    <button type="button" id="rejectTransferBtn" class="btn btn-danger-outline">
                        Reject Transfer
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- FAQ Section -->
    <div class="account-card info-card">
        <div class="card-header">
            <h3>Frequently Asked Questions</h3>
        </div>
        <div class="card-body">
            <div class="faq-item">
                <h4>How long does an account transfer take?</h4>
                <p>The transfer is completed instantly once the new owner accepts it. However, the acceptance link expires after 24 hours.</p>
            </div>
            <div class="faq-item">
                <h4>What happens to my game progress?</h4>
                <p>All game progress, resources, buildings, and achievements remain intact. Only the account ownership changes.</p>
            </div>
            <div class="faq-item">
                <h4>Can I cancel a transfer request?</h4>
                <p>Yes, you can cancel a pending transfer request before it's accepted by the new owner.</p>
            </div>
            <div class="faq-item">
                <h4>What if I entered the wrong email address?</h4>
                <p>Cancel the current transfer request and create a new one with the correct email address.</p>
            </div>
            <div class="faq-item">
                <h4>Is there a limit to how many times I can transfer?</h4>
                <p>For security reasons, you can only transfer your account once every 30 days.</p>
            </div>
        </div>
    </div>
</div>

<!-- Success Modal -->
<div id="successModal" class="modal" style="display: none;">
    <div class="modal-content">
        <div class="modal-header success">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <h2 id="modalTitle">Success!</h2>
        </div>
        <div class="modal-body">
            <p id="modalMessage">Your action was completed successfully.</p>
        </div>
        <div class="modal-footer">
            <button id="closeModalBtn" class="btn btn-primary">Close</button>
        </div>
    </div>
</div>

<script src="/js/account/account-transfer.js"></script>
{% endblock %}
