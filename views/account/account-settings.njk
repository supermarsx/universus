{% extends "base.njk" %}

{% block title %}Account Settings - Universus{% endblock %}

{% block content %}
<div class="account-management-container">
    <div class="account-header">
        <h1>Account Settings</h1>
        <p>Manage your account preferences and security settings</p>
    </div>

    <!-- Quick Actions -->
    <div class="quick-actions-grid">
        <a href="/account/security" class="quick-action-card">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <h3>Security</h3>
            <p>Sessions & 2FA</p>
        </a>
        <a href="/account/email" class="quick-action-card">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <h3>Email</h3>
            <p>Verification & Change</p>
        </a>
        <a href="/account/password" class="quick-action-card">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M12 2 L2 7 L12 12 L22 7 Z"></path>
                <path d="M2 17 L12 22 L22 17"></path>
                <path d="M2 12 L12 17 L22 12"></path>
            </svg>
            <h3>Password</h3>
            <p>Change Password</p>
        </a>
        <a href="/account/privacy" class="quick-action-card">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            <h3>Privacy</h3>
            <p>GDPR & Data</p>
        </a>
    </div>

    <!-- Profile Settings -->
    <div class="account-card">
        <div class="card-header">
            <h3>Profile Information</h3>
        </div>
        <div class="card-body">
            <form id="profileForm">
                <div class="form-row">
                    <div class="form-group">
                        <label for="username">Username</label>
                        <input type="text" id="username" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label for="displayName">Display Name</label>
                        <input type="text" id="displayName" class="form-control">
                    </div>
                </div>

                <div class="form-group">
                    <label for="email">Email Address</label>
                    <div class="input-with-button">
                        <input type="email" id="email" class="form-control" disabled>
                        <a href="/account/email" class="btn btn-secondary">Change</a>
                    </div>
                </div>

                <div class="form-group">
                    <label for="timezone">Timezone</label>
                    <select id="timezone" class="form-control">
                        <option value="UTC">UTC</option>
                        <option value="America/New_York">Eastern Time (ET)</option>
                        <option value="America/Chicago">Central Time (CT)</option>
                        <option value="America/Denver">Mountain Time (MT)</option>
                        <option value="America/Los_Angeles">Pacific Time (PT)</option>
                        <option value="Europe/London">London (GMT)</option>
                        <option value="Europe/Paris">Paris (CET)</option>
                        <option value="Europe/Berlin">Berlin (CET)</option>
                        <option value="Asia/Tokyo">Tokyo (JST)</option>
                        <option value="Asia/Shanghai">Shanghai (CST)</option>
                        <option value="Australia/Sydney">Sydney (AEDT)</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="language">Language</label>
                    <select id="language" class="form-control">
                        <option value="en">English</option>
                        <option value="es">Español</option>
                        <option value="fr">Français</option>
                        <option value="de">Deutsch</option>
                        <option value="zh">中文</option>
                        <option value="ja">日本語</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                        <polyline points="17 21 17 13 7 13 7 21"></polyline>
                        <polyline points="7 3 7 8 15 8"></polyline>
                    </svg>
                    Save Profile
                </button>
            </form>
        </div>
    </div>

    <!-- Notification Preferences -->
    <div class="account-card">
        <div class="card-header">
            <h3>Notification Preferences</h3>
        </div>
        <div class="card-body">
            <form id="notificationsForm">
                <div class="notification-section">
                    <h4>Game Notifications</h4>
                    <div class="setting-item">
                        <div class="setting-info">
                            <strong>Building Completion</strong>
                            <p>Notify when building construction is complete</p>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" id="notifyBuildings" checked>
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                    <div class="setting-item">
                        <div class="setting-info">
                            <strong>Research Completion</strong>
                            <p>Notify when research is complete</p>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" id="notifyResearch" checked>
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                    <div class="setting-item">
                        <div class="setting-info">
                            <strong>Fleet Arrival</strong>
                            <p>Notify when your fleet arrives at destination</p>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" id="notifyFleet" checked>
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                    <div class="setting-item">
                        <div class="setting-info">
                            <strong>Under Attack</strong>
                            <p>Alert when your planets are under attack</p>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" id="notifyAttack" checked>
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                </div>

                <div class="notification-section">
                    <h4>Email Notifications</h4>
                    <div class="setting-item">
                        <div class="setting-info">
                            <strong>Security Alerts</strong>
                            <p>Send email for important security events</p>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" id="emailSecurity" checked>
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                    <div class="setting-item">
                        <div class="setting-info">
                            <strong>Game Updates</strong>
                            <p>Receive emails about game updates and news</p>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" id="emailUpdates" checked>
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                    <div class="setting-item">
                        <div class="setting-info">
                            <strong>Marketing</strong>
                            <p>Receive promotional emails and offers</p>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" id="emailMarketing">
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                    </svg>
                    Save Notification Settings
                </button>
            </form>
        </div>
    </div>

    <!-- Display Preferences -->
    <div class="account-card">
        <div class="card-header">
            <h3>Display Preferences</h3>
        </div>
        <div class="card-body">
            <form id="displayForm">
                <div class="setting-item">
                    <div class="setting-info">
                        <strong>Theme</strong>
                        <p>Choose your preferred color scheme</p>
                    </div>
                    <select id="theme" class="form-control">
                        <option value="dark">Dark (Default)</option>
                        <option value="light">Light</option>
                        <option value="auto">Auto (System)</option>
                    </select>
                </div>

                <div class="setting-item">
                    <div class="setting-info">
                        <strong>Number Format</strong>
                        <p>How to display large numbers</p>
                    </div>
                    <select id="numberFormat" class="form-control">
                        <option value="short">Short (1.5M)</option>
                        <option value="long">Long (1,500,000)</option>
                        <option value="scientific">Scientific (1.5e6)</option>
                    </select>
                </div>

                <div class="setting-item">
                    <div class="setting-info">
                        <strong>Date Format</strong>
                        <p>How to display dates and times</p>
                    </div>
                    <select id="dateFormat" class="form-control">
                        <option value="relative">Relative (2 hours ago)</option>
                        <option value="absolute">Absolute (Jan 15, 2025 14:30)</option>
                        <option value="iso">ISO 8601 (2025-01-15T14:30:00)</option>
                    </select>
                </div>

                <div class="setting-item">
                    <div class="setting-info">
                        <strong>Animations</strong>
                        <p>Enable interface animations and transitions</p>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" id="animations" checked>
                        <span class="toggle-slider"></span>
                    </label>
                </div>

                <div class="setting-item">
                    <div class="setting-info">
                        <strong>Sound Effects</strong>
                        <p>Play sound effects for game events</p>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" id="soundEffects" checked>
                        <span class="toggle-slider"></span>
                    </label>
                </div>

                <button type="submit" class="btn btn-primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                    </svg>
                    Save Display Settings
                </button>
            </form>
        </div>
    </div>

    <!-- Game Preferences -->
    <div class="account-card">
        <div class="card-header">
            <h3>Game Preferences</h3>
        </div>
        <div class="card-body">
            <form id="gamePrefsForm">
                <div class="setting-item">
                    <div class="setting-info">
                        <strong>Default Galaxy View</strong>
                        <p>Starting view when opening galaxy page</p>
                    </div>
                    <select id="defaultGalaxyView" class="form-control">
                        <option value="list">List View</option>
                        <option value="grid">Grid View</option>
                        <option value="map">Map View</option>
                    </select>
                </div>

                <div class="setting-item">
                    <div class="setting-info">
                        <strong>Auto-Refresh</strong>
                        <p>Automatically refresh game data</p>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" id="autoRefresh" checked>
                        <span class="toggle-slider"></span>
                    </label>
                </div>

                <div class="setting-item">
                    <div class="setting-info">
                        <strong>Confirm Actions</strong>
                        <p>Show confirmation for important actions</p>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" id="confirmActions" checked>
                        <span class="toggle-slider"></span>
                    </label>
                </div>

                <div class="setting-item">
                    <div class="setting-info">
                        <strong>Quick Build Mode</strong>
                        <p>Enable one-click building construction</p>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" id="quickBuild">
                        <span class="toggle-slider"></span>
                    </label>
                </div>

                <button type="submit" class="btn btn-primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                    </svg>
                    Save Game Preferences
                </button>
            </form>
        </div>
    </div>

    <!-- Account Status -->
    <div class="account-card info-card">
        <div class="card-header">
            <h3>Account Information</h3>
        </div>
        <div class="card-body">
            <div class="account-stats">
                <div class="stat-item">
                    <label>Account Created:</label>
                    <span id="accountCreated">Loading...</span>
                </div>
                <div class="stat-item">
                    <label>Last Login:</label>
                    <span id="lastLogin">Loading...</span>
                </div>
                <div class="stat-item">
                    <label>Total Playtime:</label>
                    <span id="totalPlaytime">Loading...</span>
                </div>
                <div class="stat-item">
                    <label>Account Status:</label>
                    <span id="accountStatus" class="badge badge-success">Active</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Danger Zone -->
    <div class="account-card danger-card">
        <div class="card-header">
            <h3>Danger Zone</h3>
        </div>
        <div class="card-body">
            <div class="danger-actions">
                <div class="danger-action">
                    <div class="danger-info">
                        <strong>Transfer Account</strong>
                        <p>Transfer account ownership to another email address</p>
                    </div>
                    <a href="/account/transfer" class="btn btn-warning">Transfer Account</a>
                </div>
                <div class="danger-action">
                    <div class="danger-info">
                        <strong>Export Data</strong>
                        <p>Download a copy of all your personal data</p>
                    </div>
                    <a href="/account/privacy" class="btn btn-secondary">Export Data</a>
                </div>
                <div class="danger-action">
                    <div class="danger-info">
                        <strong>Delete Account</strong>
                        <p>Permanently delete your account and all associated data</p>
                    </div>
                    <a href="/account/privacy" class="btn btn-danger">Delete Account</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/js/account/account-settings.js"></script>
{% endblock %}
