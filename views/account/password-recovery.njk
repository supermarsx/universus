{% extends "base.njk" %}

{% block title %}Password Recovery - Universus{% endblock %}

{% block content %}
<div class="account-management-container">
    <div class="account-header">
        <h1>Password Recovery</h1>
        <p>Reset your password securely</p>
    </div>

    <!-- Recovery Steps -->
    <div class="recovery-steps">
        <div class="step" id="step1" data-active="true">
            <div class="step-number">1</div>
            <div class="step-label">Request Reset</div>
        </div>
        <div class="step" id="step2">
            <div class="step-number">2</div>
            <div class="step-label">Verify Email</div>
        </div>
        <div class="step" id="step3">
            <div class="step-number">3</div>
            <div class="step-label">New Password</div>
        </div>
        <div class="step" id="step4">
            <div class="step-number">4</div>
            <div class="step-label">Complete</div>
        </div>
    </div>

    <!-- Step 1: Request Password Reset -->
    <div class="account-card" id="requestResetCard">
        <div class="card-header">
            <h3>Request Password Reset</h3>
        </div>
        <div class="card-body">
            <form id="requestResetForm">
                <div class="form-group">
                    <label for="resetEmail">Email Address</label>
                    <input 
                        type="email" 
                        id="resetEmail" 
                        class="form-control" 
                        placeholder="your.email@example.com"
                        required
                    >
                    <small class="form-text">Enter the email address associated with your account</small>
                </div>

                <button type="submit" class="btn btn-primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                        <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                    Send Reset Link
                </button>
            </form>
        </div>
    </div>

    <!-- Step 2: Email Sent Confirmation -->
    <div class="account-card" id="emailSentCard" style="display: none;">
        <div class="card-header success">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <h3>Reset Link Sent</h3>
        </div>
        <div class="card-body">
            <p class="success-message">
                We've sent a password reset link to <strong id="sentEmailDisplay"></strong>. 
                Please check your email and click the link to continue.
            </p>
            <p class="info-message">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
                The link will expire in <strong>1 hour</strong>. If you don't receive the email, check your spam folder.
            </p>

            <div class="action-buttons">
                <button id="resendResetBtn" class="btn btn-secondary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <polyline points="23 4 23 10 17 10"></polyline>
                        <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                    </svg>
                    Resend Link
                </button>
                <button id="backToRequestBtn" class="btn btn-text">Back to Request</button>
            </div>

            <div id="resendCooldown" class="cooldown-message" style="display: none;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span id="resendCooldownText">Please wait before resending...</span>
            </div>
        </div>
    </div>

    <!-- Step 3: Enter New Password -->
    <div class="account-card" id="newPasswordCard" style="display: none;">
        <div class="card-header">
            <h3>Set New Password</h3>
        </div>
        <div class="card-body">
            <form id="newPasswordForm">
                <input type="hidden" id="resetToken" value="">

                <div class="form-group">
                    <label for="newPassword">New Password</label>
                    <input 
                        type="password" 
                        id="newPassword" 
                        class="form-control" 
                        placeholder="Enter new password"
                        minlength="8"
                        required
                    >
                    <div class="password-strength" id="passwordStrength"></div>
                </div>

                <div class="form-group">
                    <label for="confirmNewPassword">Confirm New Password</label>
                    <input 
                        type="password" 
                        id="confirmNewPassword" 
                        class="form-control" 
                        placeholder="Confirm new password"
                        minlength="8"
                        required
                    >
                </div>

                <div class="password-requirements">
                    <p>Password must contain:</p>
                    <ul>
                        <li id="req-length">At least 8 characters</li>
                        <li id="req-uppercase">One uppercase letter</li>
                        <li id="req-lowercase">One lowercase letter</li>
                        <li id="req-number">One number</li>
                        <li id="req-special">One special character</li>
                    </ul>
                </div>

                <button type="submit" class="btn btn-primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    Reset Password
                </button>
            </form>
        </div>
    </div>

    <!-- Step 4: Success -->
    <div class="account-card" id="successCard" style="display: none;">
        <div class="card-header success">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <h3>Password Reset Complete</h3>
        </div>
        <div class="card-body">
            <p class="success-message">
                Your password has been successfully reset. You can now log in with your new password.
            </p>
            <div class="action-buttons">
                <a href="/login" class="btn btn-primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                        <polyline points="10 17 15 12 10 7"></polyline>
                        <line x1="15" y1="12" x2="3" y2="12"></line>
                    </svg>
                    Go to Login
                </a>
            </div>
        </div>
    </div>

    <!-- Active Reset Requests -->
    <div class="account-card" id="activeRequestsCard" style="display: none;">
        <div class="card-header">
            <h3>Active Reset Requests</h3>
        </div>
        <div class="card-body">
            <p class="info-message">You have pending password reset requests.</p>
            <div id="activeRequestsList" class="requests-list"></div>
            <button id="cancelAllRequestsBtn" class="btn btn-danger-outline">
                Cancel All Requests
            </button>
        </div>
    </div>

    <!-- Help Section -->
    <div class="account-card help-card">
        <div class="card-header">
            <h3>Need Help?</h3>
        </div>
        <div class="card-body">
            <ul class="help-list">
                <li>
                    <strong>Didn't receive the email?</strong> Check your spam folder or click "Resend Link"
                </li>
                <li>
                    <strong>Link expired?</strong> Reset links expire after 1 hour. Request a new one.
                </li>
                <li>
                    <strong>Wrong email address?</strong> Go back and enter the correct email.
                </li>
                <li>
                    <strong>Remember your password?</strong> <a href="/login">Return to login</a>
                </li>
                <li>
                    <strong>Still having issues?</strong> Contact support for assistance.
                </li>
            </ul>
        </div>
    </div>
</div>

<script src="/js/account/password-recovery.js"></script>
{% endblock %}
