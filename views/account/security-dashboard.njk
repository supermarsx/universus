{% extends "layout.njk" %}

{% block title %}Account Security - Universus{% endblock %}

{% block content %}
<div class="account-security-container">
    <!-- Header -->
    <div class="page-header">
        <h1>Account Security</h1>
        <div class="security-status">
            <span class="status-badge" id="security-status-badge">Loading...</span>
            <span class="risk-level" id="risk-level">Checking...</span>
        </div>
    </div>

    <!-- Security Summary Cards -->
    <div class="security-summary-grid">
        <div class="summary-card">
            <div class="card-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
            </div>
            <div class="card-content">
                <h3>Account Status</h3>
                <p class="card-value" id="account-status">Active</p>
                <p class="card-detail" id="account-detail">All systems operational</p>
            </div>
        </div>

        <div class="summary-card">
            <div class="card-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="8.5" cy="7" r="4"></circle>
                    <polyline points="17 11 19 13 23 9"></polyline>
                </svg>
            </div>
            <div class="card-content">
                <h3>Email Verification</h3>
                <p class="card-value" id="email-verified">Checking...</p>
                <a href="/account/email-verification" class="card-link">Manage</a>
            </div>
        </div>

        <div class="summary-card">
            <div class="card-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                    <path d="M2 17l10 5 10-5"></path>
                    <path d="M2 12l10 5 10-5"></path>
                </svg>
            </div>
            <div class="card-content">
                <h3>Two-Factor Auth</h3>
                <p class="card-value" id="2fa-status">Disabled</p>
                <a href="/account/2fa-setup" class="card-link">Setup 2FA</a>
            </div>
        </div>

        <div class="summary-card">
            <div class="card-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
            </div>
            <div class="card-content">
                <h3>Active Sessions</h3>
                <p class="card-value" id="active-sessions-count">0</p>
                <a href="/account/sessions" class="card-link">View All</a>
            </div>
        </div>
    </div>

    <!-- Active Sessions Section -->
    <div class="section-card">
        <div class="section-header">
            <h2>Active Sessions</h2>
            <button class="btn btn-secondary btn-sm" id="terminate-all-btn">Terminate All Other Sessions</button>
        </div>
        <div class="sessions-list" id="sessions-list">
            <div class="loading-spinner">Loading sessions...</div>
        </div>
    </div>

    <!-- Recent Security Events -->
    <div class="section-card">
        <div class="section-header">
            <h2>Recent Security Events</h2>
            <a href="/account/activity-log" class="btn btn-link">View All</a>
        </div>
        <div class="events-list" id="security-events-list">
            <div class="loading-spinner">Loading events...</div>
        </div>
    </div>

    <!-- Security Actions -->
    <div class="security-actions">
        <h2>Security Actions</h2>
        <div class="action-buttons-grid">
            <a href="/account/2fa-setup" class="action-button">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                    <path d="M2 17l10 5 10-5"></path>
                </svg>
                <span>Setup 2FA</span>
            </a>
            <a href="/account/change-password" class="action-button">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path>
                </svg>
                <span>Change Password</span>
            </a>
            <a href="/account/email-verification" class="action-button">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                    <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                <span>Verify Email</span>
            </a>
            <a href="/account/privacy-controls" class="action-button">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
                <span>Privacy Controls</span>
            </a>
            <a href="/account/sessions" class="action-button">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
                <span>Manage Sessions</span>
            </a>
            <a href="/account/activity-log" class="action-button">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
                <span>Activity Log</span>
            </a>
        </div>
    </div>

    <!-- Risk Assessment (if applicable) -->
    <div class="section-card" id="risk-assessment-section" style="display: none;">
        <div class="section-header">
            <h2>Security Recommendations</h2>
        </div>
        <div class="recommendations-list" id="recommendations-list">
            <!-- Populated by JS -->
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/js/account/account-security.js"></script>
{% endblock %}
