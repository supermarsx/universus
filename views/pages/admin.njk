{% extends "layouts/game.njk" %}

{% set title = "Universus - Admin Panel" %}
{% set currentPage = "admin" %}
{% set bodyClass = "game-body admin-body" %}

{% block content %}
<h2>Admin Control Panel</h2>

<div class="admin-nav">
    <button class="admin-tab active" data-tab="dashboard">Dashboard</button>
    <button class="admin-tab" data-tab="users">Users</button>
    <button class="admin-tab" data-tab="bots">Bots</button>
    <button class="admin-tab" data-tab="server">Server</button>
    <button class="admin-tab" data-tab="logs">Logs</button>
    <button class="admin-tab" data-tab="database">Database</button>
</div>

<!-- Dashboard Tab -->
<div id="dashboardTab" class="admin-tab-content active">
    <div class="admin-stats-grid">
        <div class="stat-card">
            <h4>Total Users</h4>
            <p id="totalUsers" class="stat-value">-</p>
        </div>
        <div class="stat-card">
            <h4>Active Today</h4>
            <p id="activeToday" class="stat-value">-</p>
        </div>
        <div class="stat-card">
            <h4>Total Planets</h4>
            <p id="totalPlanets" class="stat-value">-</p>
        </div>
        <div class="stat-card">
            <h4>Active Fleets</h4>
            <p id="activeFleets" class="stat-value">-</p>
        </div>
    </div>
</div>

<!-- Users Tab -->
<div id="usersTab" class="admin-tab-content">
    <div class="admin-toolbar">
        <input type="text" id="userSearchInput" placeholder="Search users...">
        <button id="searchUsersBtn" class="btn-primary">Search</button>
    </div>
    <div id="usersTable" class="admin-table-container">
        <p class="text-muted">Loading users...</p>
    </div>
</div>

<!-- Bots Tab -->
<div id="botsTab" class="admin-tab-content">
    <div class="admin-toolbar">
        <button id="createBotBtn" class="btn-primary">Create Bot</button>
        <button id="bulkCreateBotsBtn" class="btn-secondary">Bulk Create</button>
        <a href="/admin/bots.html" class="btn-secondary">Advanced Bot Manager</a>
    </div>
    <div id="botsTable" class="admin-table-container">
        <p class="text-muted">Loading bots...</p>
    </div>
</div>

<!-- Server Tab -->
<div id="serverTab" class="admin-tab-content">
    <div class="server-stats">
        <h4>Server Status</h4>
        <div id="serverStatus">
            <p class="text-muted">Loading server status...</p>
        </div>
    </div>
</div>

<!-- Logs Tab -->
<div id="logsTab" class="admin-tab-content">
    <div class="admin-toolbar">
        <button id="refreshLogsBtn" class="btn-primary">Refresh</button>
        <button id="clearLogsBtn" class="btn-danger">Clear Logs</button>
    </div>
    <div id="logsDisplay" class="logs-container">
        <p class="text-muted">Loading logs...</p>
    </div>
</div>

<!-- Database Tab -->
<div id="databaseTab" class="admin-tab-content">
    <div class="database-stats">
        <h4>Database Statistics</h4>
        <div id="databaseStats">
            <p class="text-muted">Loading database stats...</p>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
{{ super() }}
<script src="/js/admin.js"></script>
{% endblock %}
