{% extends "layouts/game.njk" %}

{% set title = "Universus - Empire Overview" %}
{% set currentPage = "overview" %}
{% set bodyClass = "game-body" %}

{% block content %}
<h2>Empire Overview</h2>

<div class="overview-grid">
    <!-- Planet Information -->
    <div class="overview-card card-enhanced">
        <h3>Planet Information</h3>
        <div id="planetInfo">
            <p><strong>Name:</strong> <span id="planetName">{{ planet.name if planet else '-' }}</span></p>
            <p><strong>Coordinates:</strong> <span id="planetCoords">{{ planet.coordinates if planet else '-' }}</span></p>
            <p><strong>Temperature:</strong> <span id="planetTemp">{{ planet.temperature if planet else '-' }}</span></p>
            <p><strong>Diameter:</strong> <span id="planetDiameter">{{ planet.diameter if planet else '-' }}</span></p>
        </div>
    </div>

    <!-- Resource Production -->
    <div class="overview-card card-enhanced">
        <h3>Resource Production</h3>
        <div id="productionInfo">
            <p><strong>Metal:</strong> <span id="metalProd">{{ production.metal if production else '0' }}</span> /hour</p>
            <p><strong>Crystal:</strong> <span id="crystalProd">{{ production.crystal if production else '0' }}</span> /hour</p>
            <p><strong>Deuterium:</strong> <span id="deuteriumProd">{{ production.deuterium if production else '0' }}</span> /hour</p>
            <p><strong>Energy:</strong> <span id="energyProd">{{ production.energy if production else '0' }}</span></p>
        </div>
    </div>

    <!-- Construction Queue -->
    <div class="overview-card card-enhanced">
        <h3>Construction Queue</h3>
        <div id="constructionQueue">
            {% if queue and queue.length > 0 %}
                {% for item in queue %}
                <div class="queue-item">
                    <strong>{{ item.name }}</strong> - Level {{ item.level }}
                    <div class="queue-timer">{{ item.timeRemaining }}</div>
                </div>
                {% endfor %}
            {% else %}
                <p class="text-muted">No construction in progress</p>
            {% endif %}
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="overview-card card-enhanced">
        <h3>Quick Stats</h3>
        <div id="quickStats">
            <p><strong>Total Planets:</strong> <span id="totalPlanets">{{ stats.totalPlanets if stats else '1' }}</span></p>
            <p><strong>Total Score:</strong> <span id="totalScore">{{ stats.totalScore if stats else '0' }}</span></p>
            <p><strong>Fleet Size:</strong> <span id="fleetSize">{{ stats.fleetSize if stats else '0' }}</span></p>
            <p><strong>Military Rank:</strong> <span id="militaryRank">{{ stats.militaryRank if stats else '-' }}</span></p>
        </div>
    </div>
</div>

<!-- Recent Events -->
<div class="overview-section">
    <h3>Recent Events</h3>
    <div id="recentEvents" class="events-list">
        {% if events and events.length > 0 %}
            {% for event in events %}
            <div class="event-item event-{{ event.type }}">
                <span class="event-time">{{ event.timestamp }}</span>
                <span class="event-message">{{ event.message }}</span>
            </div>
            {% endfor %}
        {% else %}
            <p class="text-muted">No recent events</p>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block scripts %}
{{ super() }}
<script src="/js/overview.js"></script>
{% endblock %}
