{% extends "layouts/game.njk" %}

{% set title = "Universus - Alliance Wars" %}
{% set currentPage = "alliance" %}
{% set bodyClass = "game-body" %}

{% block stylesheets %}
{{ super() }}
<link rel="stylesheet" href="/css/alliance-wars.css">
{% endblock %}

{% block content %}
<div class="alliance-wars-container">
    <!-- Page Header -->
    <div class="wars-header card-enhanced">
        <div class="wars-header-content">
            <h1 class="wars-title">
                <span class="css-icon icon-combat"></span>
                Alliance Wars
            </h1>
            <p class="wars-subtitle">Engage in large-scale conflicts with rival alliances</p>
        </div>
        {% if canDeclareWar %}
        <button class="btn btn-danger btn-lg" onclick="showDeclareWarModal()">
            <span class="css-icon icon-attack"></span> Declare War
        </button>
        {% endif %}
    </div>

    <!-- War Statistics Overview -->
    <div class="war-stats-grid">
        <div class="war-stat-card card-enhanced">
            <div class="stat-icon stat-icon-active">
                <span class="css-icon icon-combat"></span>
            </div>
            <div class="stat-content">
                <div class="stat-label">Active Wars</div>
                <div class="stat-value" id="statActiveWars">{{ warStats.activeWars or 0 }}</div>
            </div>
        </div>

        <div class="war-stat-card card-enhanced">
            <div class="stat-icon stat-icon-victories">
                <span class="css-icon icon-trophy"></span>
            </div>
            <div class="stat-content">
                <div class="stat-label">Total Victories</div>
                <div class="stat-value" id="statVictories">{{ warStats.victories or 0 }}</div>
            </div>
        </div>

        <div class="war-stat-card card-enhanced">
            <div class="stat-icon stat-icon-defeats">
                <span class="css-icon icon-offline"></span>
            </div>
            <div class="stat-content">
                <div class="stat-label">Total Defeats</div>
                <div class="stat-value" id="statDefeats">{{ warStats.defeats or 0 }}</div>
            </div>
        </div>

        <div class="war-stat-card card-enhanced">
            <div class="stat-icon stat-icon-points">
                <span class="css-icon icon-power"></span>
            </div>
            <div class="stat-content">
                <div class="stat-label">War Points</div>
                <div class="stat-value" id="statWarPoints">{{ warStats.warPoints or 0 }}</div>
            </div>
        </div>
    </div>

    <!-- War Tabs -->
    <div class="war-tabs card-enhanced">
        <button class="war-tab active" data-tab="active" onclick="switchWarTab('active')">
            Active Wars ({{ activeWars.length if activeWars else 0 }})
        </button>
        <button class="war-tab" data-tab="pending" onclick="switchWarTab('pending')">
            Pending ({{ pendingWars.length if pendingWars else 0 }})
        </button>
        <button class="war-tab" data-tab="history" onclick="switchWarTab('history')">
            War History
        </button>
    </div>

    <!-- Active Wars Section -->
    <div class="war-tab-content active" id="tabActive">
        <div class="wars-grid">
            {% if activeWars and activeWars.length > 0 %}
                {% for war in activeWars %}
                <div class="war-card card-enhanced" data-war-id="{{ war.war_id }}">
                    <div class="war-card-header">
                        <div class="war-participants">
                            <div class="war-alliance {{ 'war-us' if war.is_attacker else 'war-them' }}">
                                <span class="alliance-tag">{{ war.our_tag }}</span>
                                <span class="alliance-name">{{ war.our_name }}</span>
                            </div>
                            <div class="war-vs">
                                <span class="css-icon icon-combat"></span>
                                <span>VS</span>
                            </div>
                            <div class="war-alliance {{ 'war-them' if war.is_attacker else 'war-us' }}">
                                <span class="alliance-tag">{{ war.enemy_tag }}</span>
                                <span class="alliance-name">{{ war.enemy_name }}</span>
                            </div>
                        </div>
                        <div class="war-meta">
                            <span class="war-type">{{ war.war_type }}</span>
                            <span class="war-duration">{{ war.duration }}</span>
                        </div>
                    </div>

                    <div class="war-card-body">
                        <div class="war-score-section">
                            <div class="score-display">
                                <div class="our-score">
                                    <span class="score-label">Our Score</span>
                                    <span class="score-value">{{ war.our_score }}</span>
                                </div>
                                <div class="score-separator">-</div>
                                <div class="enemy-score">
                                    <span class="score-label">Enemy Score</span>
                                    <span class="score-value">{{ war.enemy_score }}</span>
                                </div>
                            </div>
                            <div class="score-bar-container">
                                <div class="score-bar">
                                    <div class="score-progress our-progress" style="width: {{ war.our_percentage }}%"></div>
                                    <div class="score-progress enemy-progress" style="width: {{ war.enemy_percentage }}%"></div>
                                </div>
                            </div>
                        </div>

                        <div class="war-stats-row">
                            <div class="war-stat-item">
                                <span class="stat-icon"><span class="css-icon icon-attack"></span></span>
                                <span class="stat-text">{{ war.battles_count }} Battles</span>
                            </div>
                            <div class="war-stat-item">
                                <span class="stat-icon"><span class="css-icon icon-users"></span></span>
                                <span class="stat-text">{{ war.participants_count }} Participants</span>
                            </div>
                            {% if war.objective %}
                            <div class="war-stat-item">
                                <span class="stat-icon"><span class="css-icon icon-trophy"></span></span>
                                <span class="stat-text">{{ war.objective }}</span>
                            </div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="war-card-footer">
                        <button class="btn btn-primary btn-sm" onclick="viewWarDetails({{ war.war_id }})">
                            <span class="css-icon icon-view"></span> View Details
                        </button>
                        {% if canRecordBattle %}
                        <button class="btn btn-accent btn-sm" onclick="showRecordBattleModal({{ war.war_id }})">
                            <span class="css-icon icon-add"></span> Record Battle
                        </button>
                        {% endif %}
                        {% if canEndWar %}
                        <button class="btn btn-secondary btn-sm" onclick="showPeaceTermsModal({{ war.war_id }})">
                            <span class="css-icon icon-handshake"></span> Peace Terms
                        </button>
                        {% endif %}
                    </div>
                </div>
                {% endfor %}
            {% else %}
                <div class="empty-state">
                    <span class="css-icon icon-combat"></span>
                    <h3>No Active Wars</h3>
                    <p>Your alliance is currently at peace</p>
                </div>
            {% endif %}
        </div>
    </div>

    <!-- Pending Wars Section -->
    <div class="war-tab-content" id="tabPending">
        <div class="pending-wars-list">
            {% if pendingWars and pendingWars.length > 0 %}
                {% for war in pendingWars %}
                <div class="pending-war-card card-enhanced">
                    <div class="pending-war-header">
                        <div class="war-direction-badge {{ 'badge-outgoing' if war.is_attacker else 'badge-incoming' }}">
                            {{ 'Outgoing' if war.is_attacker else 'Incoming' }}
                        </div>
                        <div class="pending-war-info">
                            <h3>{{ war.enemy_tag }} - {{ war.enemy_name }}</h3>
                            <p class="pending-war-meta">
                                <span>{{ war.war_type }}</span>
                                <span class="separator">•</span>
                                <span>Declared {{ war.declared_at|timeago }}</span>
                            </p>
                        </div>
                    </div>

                    <div class="pending-war-body">
                        {% if war.objective %}
                        <div class="war-objective">
                            <strong>Objective:</strong> {{ war.objective }}
                        </div>
                        {% endif %}
                        {% if war.terms %}
                        <div class="war-terms">
                            <strong>Terms:</strong>
                            <p>{{ war.terms }}</p>
                        </div>
                        {% endif %}
                    </div>

                    <div class="pending-war-actions">
                        {% if not war.is_attacker and canRespondToWar %}
                            <button class="btn btn-success btn-sm" onclick="acceptWarDeclaration({{ war.war_id }})">
                                <span class="css-icon icon-online"></span> Accept
                            </button>
                            <button class="btn btn-danger btn-sm" onclick="rejectWarDeclaration({{ war.war_id }})">
                                <span class="css-icon icon-offline"></span> Reject
                            </button>
                        {% elif war.is_attacker %}
                            <button class="btn btn-secondary btn-sm" onclick="cancelWarDeclaration({{ war.war_id }})">
                                Cancel Declaration
                            </button>
                        {% endif %}
                        <button class="btn btn-sm" onclick="viewAllianceProfile({{ war.enemy_alliance_id }})">
                            View Alliance
                        </button>
                    </div>
                </div>
                {% endfor %}
            {% else %}
                <div class="empty-state">
                    <span class="css-icon icon-calendar"></span>
                    <h3>No Pending Wars</h3>
                    <p>No war declarations waiting for response</p>
                </div>
            {% endif %}
        </div>
    </div>

    <!-- War History Section -->
    <div class="war-tab-content" id="tabHistory">
        <div class="war-history-filters">
            <select id="historyFilter" class="filter-select" onchange="filterWarHistory()">
                <option value="all">All Wars</option>
                <option value="victories">Victories Only</option>
                <option value="defeats">Defeats Only</option>
                <option value="draws">Draws Only</option>
            </select>
            <input type="text" id="historySearch" class="search-input" placeholder="Search by alliance..." oninput="searchWarHistory()">
        </div>

        <div class="war-history-list" id="warHistoryList">
            {% if warHistory and warHistory.length > 0 %}
                {% for war in warHistory %}
                <div class="history-war-card card-enhanced">
                    <div class="history-war-header">
                        <div class="war-outcome {{ war.outcome|lower }}">
                            <span class="outcome-icon">
                                {% if war.outcome == 'VICTORY' %}
                                <span class="css-icon icon-trophy"></span>
                                {% elif war.outcome == 'DEFEAT' %}
                                <span class="css-icon icon-offline"></span>
                                {% else %}
                                <span class="css-icon icon-handshake"></span>
                                {% endif %}
                            </span>
                            <span class="outcome-text">{{ war.outcome }}</span>
                        </div>
                        <div class="war-participants-compact">
                            <span>{{ war.our_tag }} vs {{ war.enemy_tag }}</span>
                        </div>
                        <div class="war-date">{{ war.ended_at|date }}</div>
                    </div>

                    <div class="history-war-stats">
                        <div class="stat-item">
                            <span class="stat-label">Final Score</span>
                            <span class="stat-value">{{ war.final_our_score }} - {{ war.final_enemy_score }}</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">Duration</span>
                            <span class="stat-value">{{ war.total_duration }}</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">Battles</span>
                            <span class="stat-value">{{ war.total_battles }}</span>
                        </div>
                    </div>

                    <div class="history-war-actions">
                        <button class="btn btn-sm" onclick="viewWarReport({{ war.war_id }})">
                            <span class="css-icon icon-view"></span> View Full Report
                        </button>
                    </div>
                </div>
                {% endfor %}
            {% else %}
                <div class="empty-state">
                    <span class="css-icon icon-activity"></span>
                    <h3>No War History</h3>
                    <p>Your alliance has no completed wars yet</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<!-- Modals -->
<!-- Declare War Modal -->
<div id="declareWarModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Declare War</h2>
            <button class="modal-close" onclick="closeModal('declareWarModal')">&times;</button>
        </div>
        <form id="declareWarForm" onsubmit="handleDeclareWar(event)">
            <div class="form-group">
                <label for="targetAllianceInput">Target Alliance *</label>
                <input type="text" id="targetAllianceInput" name="targetAlliance" required
                       placeholder="Enter alliance tag or name">
                <small>Search for the alliance you want to declare war on</small>
            </div>
            <div class="form-group">
                <label for="warTypeSelect">War Type *</label>
                <select id="warTypeSelect" name="warType" required>
                    <option value="TOTAL_WAR">Total War</option>
                    <option value="LIMITED_WAR">Limited War</option>
                    <option value="TERRITORY_WAR">Territory War</option>
                    <option value="RESOURCE_WAR">Resource War</option>
                </select>
            </div>
            <div class="form-group">
                <label for="warObjectiveSelect">Objective (optional)</label>
                <select id="warObjectiveSelect" name="objective">
                    <option value="">None</option>
                    <option value="TERRITORY_CONQUEST">Territory Conquest</option>
                    <option value="RESOURCE_EXTRACTION">Resource Extraction</option>
                    <option value="ALLIANCE_DOMINANCE">Alliance Dominance</option>
                    <option value="REVENGE">Revenge</option>
                </select>
            </div>
            <div class="form-group">
                <label for="warDeclarationInput">Declaration Message</label>
                <textarea id="warDeclarationInput" name="declaration" rows="4" maxlength="500"
                          placeholder="Optional message to the enemy alliance..."></textarea>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" onclick="closeModal('declareWarModal')">Cancel</button>
                <button type="submit" class="btn btn-danger">Declare War</button>
            </div>
        </form>
    </div>
</div>

<!-- Record Battle Modal -->
<div id="recordBattleModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Record Battle</h2>
            <button class="modal-close" onclick="closeModal('recordBattleModal')">&times;</button>
        </div>
        <form id="recordBattleForm" onsubmit="handleRecordBattle(event)">
            <input type="hidden" id="battleWarId" name="warId">
            <div class="form-group">
                <label for="battleTypeSelect">Battle Type *</label>
                <select id="battleTypeSelect" name="battleType" required>
                    <option value="FLEET_BATTLE">Fleet Battle</option>
                    <option value="PLANETARY_ASSAULT">Planetary Assault</option>
                    <option value="TERRITORY_SKIRMISH">Territory Skirmish</option>
                    <option value="RESOURCE_RAID">Resource Raid</option>
                </select>
            </div>
            <div class="form-group">
                <label for="battleOutcomeSelect">Outcome *</label>
                <select id="battleOutcomeSelect" name="outcome" required>
                    <option value="VICTORY">Victory</option>
                    <option value="DEFEAT">Defeat</option>
                    <option value="DRAW">Draw</option>
                </select>
            </div>
            <div class="form-group">
                <label for="battlePointsInput">Points Earned *</label>
                <input type="number" id="battlePointsInput" name="points" required min="0" max="10000"
                       placeholder="Battle points">
            </div>
            <div class="form-group">
                <label for="battleParticipantsInput">Participants (comma-separated usernames)</label>
                <input type="text" id="battleParticipantsInput" name="participants"
                       placeholder="e.g., Player1, Player2, Player3">
            </div>
            <div class="form-group">
                <label for="battleNotesInput">Battle Notes</label>
                <textarea id="battleNotesInput" name="notes" rows="3" maxlength="500"
                          placeholder="Optional notes about the battle..."></textarea>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" onclick="closeModal('recordBattleModal')">Cancel</button>
                <button type="submit" class="btn btn-accent">Record Battle</button>
            </div>
        </form>
    </div>
</div>

<!-- Peace Terms Modal -->
<div id="peaceTermsModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Propose Peace Terms</h2>
            <button class="modal-close" onclick="closeModal('peaceTermsModal')">&times;</button>
        </div>
        <form id="peaceTermsForm" onsubmit="handleProposePeace(event)">
            <input type="hidden" id="peaceWarId" name="warId">
            <div class="form-group">
                <label for="peaceTermsInput">Peace Terms *</label>
                <textarea id="peaceTermsInput" name="terms" required rows="6" maxlength="1000"
                          placeholder="Describe your proposed peace terms..."></textarea>
            </div>
            <div class="form-group">
                <label class="checkbox-label">
                    <input type="checkbox" id="unconditionalInput" name="unconditional">
                    Unconditional Surrender (we surrender)
                </label>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" onclick="closeModal('peaceTermsModal')">Cancel</button>
                <button type="submit" class="btn btn-success">Propose Peace</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block scripts %}
{{ super() }}
<script src="/js/alliance-wars.js"></script>
{% endblock %}
