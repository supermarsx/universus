{% extends "layouts/game.njk" %}

{% set title = "Universus - Alliance Dashboard" %}
{% set currentPage = "alliance" %}
{% set bodyClass = "game-body" %}

{% block stylesheets %}
{{ super() }}
<link rel="stylesheet" href="/css/alliance-dashboard.css">
{% endblock %}

{% block content %}
<div class="alliance-dashboard-container">
    <!-- Alliance Header Section -->
    <div class="alliance-header card-enhanced">
        <div class="alliance-header-left">
            <div class="alliance-tag-badge">
                <span id="allianceTag">{{ alliance.tag if alliance else 'N/A' }}</span>
            </div>
            <div class="alliance-header-info">
                <h1 class="alliance-name" id="allianceName">{{ alliance.name if alliance else 'No Alliance' }}</h1>
                <p class="alliance-description" id="allianceDescription">
                    {{ alliance.description if alliance else 'You are not currently a member of an alliance.' }}
                </p>
                <div class="alliance-meta">
                    <span class="meta-item">
                        <span class="css-icon icon-user"></span>
                        Founded by <strong id="founderName">{{ alliance.founder_name if alliance else '-' }}</strong>
                    </span>
                    <span class="meta-item">
                        <span class="css-icon icon-calendar"></span>
                        <span id="foundedDate">{{ alliance.founded_at|date if alliance else '-' }}</span>
                    </span>
                </div>
            </div>
        </div>
        <div class="alliance-header-right">
            <div class="alliance-quick-actions">
                {% if not alliance %}
                <button class="btn btn-primary" onclick="window.location.href='/alliance/search'">
                    <span class="css-icon icon-search"></span> Find Alliance
                </button>
                <button class="btn btn-success" onclick="showCreateAllianceModal()">
                    <span class="css-icon icon-add"></span> Create Alliance
                </button>
                {% else %}
                <button class="btn btn-accent" onclick="showInviteModal()" id="btnInvite">
                    <span class="css-icon icon-user-add"></span> Invite Member
                </button>
                <button class="btn btn-primary" onclick="showAnnouncementModal()" id="btnAnnounce">
                    <span class="css-icon icon-broadcast"></span> Make Announcement
                </button>
                <button class="btn btn-secondary" onclick="window.location.href='/alliance/manage'" id="btnManage">
                    <span class="css-icon icon-settings"></span> Manage
                </button>
                {% endif %}
            </div>
        </div>
    </div>

    {% if alliance %}
    <!-- Alliance Statistics Dashboard -->
    <div class="alliance-stats-grid">
        <div class="stat-card card-enhanced">
            <div class="stat-icon stat-icon-members">
                <span class="css-icon icon-users"></span>
            </div>
            <div class="stat-content">
                <div class="stat-label">Total Members</div>
                <div class="stat-value" id="statTotalMembers">{{ alliance.total_members or 0 }}</div>
            </div>
        </div>

        <div class="stat-card card-enhanced">
            <div class="stat-icon stat-icon-power">
                <span class="css-icon icon-power"></span>
            </div>
            <div class="stat-content">
                <div class="stat-label">Alliance Power</div>
                <div class="stat-value" id="statAlliancePower">{{ alliance.total_power|number or 0 }}</div>
            </div>
        </div>

        <div class="stat-card card-enhanced">
            <div class="stat-icon stat-icon-rank">
                <span class="css-icon icon-trophy"></span>
            </div>
            <div class="stat-content">
                <div class="stat-label">Alliance Rank</div>
                <div class="stat-value" id="statAllianceRank">{{ alliance.rank or '-' }}</div>
            </div>
        </div>

        <div class="stat-card card-enhanced">
            <div class="stat-icon stat-icon-wars">
                <span class="css-icon icon-combat"></span>
            </div>
            <div class="stat-content">
                <div class="stat-label">War Points</div>
                <div class="stat-value" id="statWarPoints">{{ alliance.war_points or 0 }}</div>
            </div>
        </div>

        <div class="stat-card card-enhanced">
            <div class="stat-icon stat-icon-territory">
                <span class="css-icon icon-map"></span>
            </div>
            <div class="stat-content">
                <div class="stat-label">Territories</div>
                <div class="stat-value" id="statTerritories">{{ alliance.territories_count or 0 }}</div>
            </div>
        </div>

        <div class="stat-card card-enhanced">
            <div class="stat-icon stat-icon-diplomacy">
                <span class="css-icon icon-handshake"></span>
            </div>
            <div class="stat-content">
                <div class="stat-label">Diplomatic Relations</div>
                <div class="stat-value" id="statDiplomacy">{{ alliance.diplomatic_relations_count or 0 }}</div>
            </div>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="alliance-content-grid">
        <!-- Member List Section -->
        <div class="alliance-section card-enhanced members-section">
            <div class="section-header">
                <h2 class="section-title">
                    <span class="css-icon icon-users"></span>
                    Alliance Members
                </h2>
                <div class="section-actions">
                    <input type="text" id="memberSearch" placeholder="Search members..." class="search-input">
                    <select id="memberRoleFilter" class="filter-select">
                        <option value="">All Ranks</option>
                        <option value="FOUNDER">Founder</option>
                        <option value="LEADER">Leader</option>
                        <option value="OFFICER">Officer</option>
                        <option value="MEMBER">Member</option>
                        <option value="RECRUIT">Recruit</option>
                    </select>
                </div>
            </div>

            <div class="members-list" id="membersList">
                {% if alliance and alliance.members and alliance.members.length > 0 %}
                    {% for member in alliance.members %}
                    <div class="member-card" data-member-id="{{ member.user_id }}">
                        <div class="member-avatar">
                            <img src="{{ member.avatar_url or '/assets/ui/default-avatar.png' }}" alt="{{ member.username }}">
                            <span class="member-status-indicator {{ 'status-online' if member.is_online else 'status-offline' }}"></span>
                        </div>
                        <div class="member-info">
                            <div class="member-name">{{ member.username }}</div>
                            <div class="member-meta">
                                <span class="member-rank rank-{{ member.alliance_role|lower }}">{{ member.alliance_role }}</span>
                                <span class="member-joined">Joined {{ member.joined_at|timeago }}</span>
                            </div>
                        </div>
                        <div class="member-stats">
                            <div class="member-stat">
                                <span class="stat-label">Power</span>
                                <span class="stat-value">{{ member.power|number }}</span>
                            </div>
                            <div class="member-stat">
                                <span class="stat-label">Contribution</span>
                                <span class="stat-value">{{ member.contribution_points|number }}</span>
                            </div>
                        </div>
                        <div class="member-actions">
                            <button class="btn-icon" onclick="viewMemberProfile({{ member.user_id }})" title="View Profile">
                                <span class="css-icon icon-view"></span>
                            </button>
                            {% if canManageMembers %}
                            <button class="btn-icon" onclick="showMemberManageMenu({{ member.user_id }})" title="Manage">
                                <span class="css-icon icon-settings"></span>
                            </button>
                            {% endif %}
                        </div>
                    </div>
                    {% endfor %}
                {% else %}
                    <div class="empty-state">
                        <span class="css-icon icon-users"></span>
                        <p>No members to display</p>
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Activity Feed Section -->
        <div class="alliance-section card-enhanced activity-section">
            <div class="section-header">
                <h2 class="section-title">
                    <span class="css-icon icon-activity"></span>
                    Recent Activity
                </h2>
                <button class="btn-refresh" onclick="refreshActivity()" title="Refresh">
                    <span class="css-icon icon-refresh"></span>
                </button>
            </div>

            <div class="activity-feed" id="activityFeed">
                {% if alliance and alliance.recent_activity and alliance.recent_activity.length > 0 %}
                    {% for activity in alliance.recent_activity %}
                    <div class="activity-item activity-type-{{ activity.type }}">
                        <div class="activity-icon">
                            <span class="css-icon icon-{{ activity.icon }}"></span>
                        </div>
                        <div class="activity-content">
                            <div class="activity-message">{{ activity.message | safe }}</div>
                            <div class="activity-time">{{ activity.timestamp|timeago }}</div>
                        </div>
                    </div>
                    {% endfor %}
                {% else %}
                    <div class="empty-state">
                        <span class="css-icon icon-activity"></span>
                        <p>No recent activity</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Announcements Section -->
    <div class="alliance-section card-enhanced announcements-section">
        <div class="section-header">
            <h2 class="section-title">
                <span class="css-icon icon-broadcast"></span>
                Alliance Announcements
            </h2>
            {% if canMakeAnnouncements %}
            <button class="btn btn-accent btn-sm" onclick="showAnnouncementModal()">
                <span class="css-icon icon-add"></span> New Announcement
            </button>
            {% endif %}
        </div>

        <div class="announcements-list" id="announcementsList">
            {% if alliance and alliance.announcements and alliance.announcements.length > 0 %}
                {% for announcement in alliance.announcements %}
                <div class="announcement-card">
                    <div class="announcement-header">
                        <div class="announcement-author">
                            <strong>{{ announcement.author_name }}</strong>
                            <span class="announcement-role">{{ announcement.author_role }}</span>
                        </div>
                        <div class="announcement-time">{{ announcement.created_at|timeago }}</div>
                    </div>
                    <div class="announcement-content">
                        <h3 class="announcement-title">{{ announcement.title }}</h3>
                        <div class="announcement-message">{{ announcement.message | safe }}</div>
                    </div>
                    {% if announcement.is_pinned %}
                    <div class="announcement-pinned-badge">
                        <span class="css-icon icon-pin"></span> Pinned
                    </div>
                    {% endif %}
                </div>
                {% endfor %}
            {% else %}
                <div class="empty-state">
                    <span class="css-icon icon-broadcast"></span>
                    <p>No announcements yet</p>
                </div>
            {% endif %}
        </div>
    </div>

    <!-- Alliance Wars Quick Status (if any active) -->
    {% if alliance and alliance.active_wars and alliance.active_wars.length > 0 %}
    <div class="alliance-section card-enhanced wars-section">
        <div class="section-header">
            <h2 class="section-title">
                <span class="css-icon icon-combat"></span>
                Active Wars
            </h2>
            <a href="/alliance/wars" class="btn btn-secondary btn-sm">View All Wars</a>
        </div>

        <div class="wars-grid">
            {% for war in alliance.active_wars %}
            <div class="war-card">
                <div class="war-header">
                    <div class="war-sides">
                        <span class="war-side {{ 'war-side-attacker' if war.is_attacker else 'war-side-defender' }}">
                            {{ war.our_alliance_tag }}
                        </span>
                        <span class="war-vs">VS</span>
                        <span class="war-side">{{ war.enemy_alliance_tag }}</span>
                    </div>
                    <span class="war-status status-{{ war.status|lower }}">{{ war.status }}</span>
                </div>
                <div class="war-score">
                    <div class="score-bar">
                        <div class="score-progress" style="width: {{ war.our_score_percentage }}%"></div>
                    </div>
                    <div class="score-numbers">
                        <span class="our-score">{{ war.our_score }}</span>
                        <span class="score-separator">-</span>
                        <span class="enemy-score">{{ war.enemy_score }}</span>
                    </div>
                </div>
                <div class="war-actions">
                    <a href="/alliance/wars/{{ war.war_id }}" class="btn btn-sm btn-primary">View Details</a>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {% else %}
    <!-- No Alliance State -->
    <div class="no-alliance-state card-enhanced">
        <div class="no-alliance-content">
            <div class="no-alliance-icon">
                <span class="css-icon icon-users"></span>
            </div>
            <h2>You're Not Part of an Alliance</h2>
            <p>Join forces with other players to dominate the universe. Alliances provide benefits like shared defense, resource trading, and coordinated attacks.</p>
            <div class="no-alliance-actions">
                <button class="btn btn-primary btn-lg" onclick="window.location.href='/alliance/search'">
                    <span class="css-icon icon-search"></span> Search Alliances
                </button>
                <button class="btn btn-success btn-lg" onclick="showCreateAllianceModal()">
                    <span class="css-icon icon-add"></span> Create Your Own Alliance
                </button>
            </div>
        </div>
    </div>
    {% endif %}
</div>

<!-- Modals -->
<!-- Create Alliance Modal -->
<div id="createAllianceModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Create New Alliance</h2>
            <button class="modal-close" onclick="closeModal('createAllianceModal')">&times;</button>
        </div>
        <form id="createAllianceForm" onsubmit="handleCreateAlliance(event)">
            <div class="form-group">
                <label for="allianceTagInput">Alliance Tag (3-6 characters) *</label>
                <input type="text" id="allianceTagInput" name="tag" required minlength="3" maxlength="6" 
                       pattern="[A-Z0-9]+" placeholder="e.g., UNVRS">
                <small>Uppercase letters and numbers only</small>
            </div>
            <div class="form-group">
                <label for="allianceNameInput">Alliance Name (4-50 characters) *</label>
                <input type="text" id="allianceNameInput" name="name" required minlength="4" maxlength="50"
                       placeholder="e.g., Universal Empire">
            </div>
            <div class="form-group">
                <label for="allianceDescInput">Description</label>
                <textarea id="allianceDescInput" name="description" rows="4" maxlength="500"
                          placeholder="Describe your alliance's goals and values..."></textarea>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" onclick="closeModal('createAllianceModal')">Cancel</button>
                <button type="submit" class="btn btn-success">Create Alliance</button>
            </div>
        </form>
    </div>
</div>

<!-- Invite Member Modal -->
<div id="inviteMemberModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Invite Member</h2>
            <button class="modal-close" onclick="closeModal('inviteMemberModal')">&times;</button>
        </div>
        <form id="inviteMemberForm" onsubmit="handleInviteMember(event)">
            <div class="form-group">
                <label for="inviteUsernameInput">Player Username *</label>
                <input type="text" id="inviteUsernameInput" name="username" required
                       placeholder="Enter player username">
            </div>
            <div class="form-group">
                <label for="inviteMessageInput">Invitation Message (optional)</label>
                <textarea id="inviteMessageInput" name="message" rows="3" maxlength="500"
                          placeholder="Add a personal message to your invitation..."></textarea>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" onclick="closeModal('inviteMemberModal')">Cancel</button>
                <button type="submit" class="btn btn-accent">Send Invitation</button>
            </div>
        </form>
    </div>
</div>

<!-- Announcement Modal -->
<div id="announcementModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>New Announcement</h2>
            <button class="modal-close" onclick="closeModal('announcementModal')">&times;</button>
        </div>
        <form id="announcementForm" onsubmit="handleCreateAnnouncement(event)">
            <div class="form-group">
                <label for="announcementTitleInput">Title *</label>
                <input type="text" id="announcementTitleInput" name="title" required maxlength="100"
                       placeholder="Announcement title">
            </div>
            <div class="form-group">
                <label for="announcementMessageInput">Message *</label>
                <textarea id="announcementMessageInput" name="message" required rows="6" maxlength="2000"
                          placeholder="Write your announcement..."></textarea>
            </div>
            <div class="form-group">
                <label class="checkbox-label">
                    <input type="checkbox" id="announcementPinInput" name="is_pinned">
                    Pin this announcement
                </label>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" onclick="closeModal('announcementModal')">Cancel</button>
                <button type="submit" class="btn btn-accent">Post Announcement</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block scripts %}
{{ super() }}
<script src="/js/alliance-dashboard.js"></script>
{% endblock %}
